      "duration_seconds": 300,
      "difficulty": "beginner",
      "xp_reward": 20,
      "instructions": [
        "Asseyez-vous confortablement, dos droit",
        "Inspirez par le nez pendant 5 secondes",
        "Expirez par le nez ou la bouche pendant 5 secondes",
        "Continuez pendant 5 minutes (30 cycles)"
      ],
      "parameters": {
        "inhale_duration": 5,
        "exhale_duration": 5,
        "cycles": 30
      },
      "tags": ["coherence", "stress", "beginner"],
