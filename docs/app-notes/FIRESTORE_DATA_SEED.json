      "id": "breathing_4_7_8",
      "title": "Respiration 4-7-8",
      "type": "breathing",
      "description": "Technique de respiration pour calmer rapidement l'anxiété",
      "duration_seconds": 180,
      "difficulty": "beginner",
      "xp_reward": 15,
      "instructions": [
        "Installez-vous confortablement",
        "Inspirez par le nez pendant 4 secondes",
        "Retenez votre respiration pendant 7 secondes",
        "Expirez par la bouche pendant 8 secondes",
        "Répétez pendant 3 minutes"
      ],
      "parameters": {
        "inhale_duration": 4,
        "hold_duration": 7,
        "exhale_duration": 8,
        "cycles": 8
      },
      "tags": ["anxiety", "stress", "beginner"],
      "created_at": "2025-11-09T00:00:00Z"
    },
    {
      "id": "breathing_coherence",
