"exercise.meditation_2min.step_6.title" = "Last deep breath";
"exercise.meditation_2min.step_6.subtitle" = "Stretch, yawn, open your eyes - you meditated!";
"exercise.meditation_2min.step_6.duration" = "15 sec";

// MARK: - Exercise Instructions - 5 Senses Grounding
"exercise.grounding.step_1.title" = "Deep breath to start";
"exercise.grounding.step_1.subtitle" = "Ground yourself in the here and now";
"exercise.grounding.step_1.duration" = "20 sec";

"exercise.grounding.step_2.title" = "Sight: 5 details to spot";
"exercise.grounding.step_2.subtitle" = "Colors, shapes, lights - become a detective of the moment";
"exercise.grounding.step_2.duration" = "50 sec";

"exercise.grounding.step_3.title" = "Touch: 4 tactile sensations";
"exercise.grounding.step_3.subtitle" = "Temperature, texture, weight... What does your skin feel?";
"exercise.grounding.step_3.duration" = "40 sec";

"exercise.grounding.step_4.title" = "Hearing: 3 sounds to catch";
"exercise.grounding.step_4.subtitle" = "The loudest, the softest, the most surprising";
"exercise.grounding.step_4.duration" = "30 sec";

"exercise.grounding.step_5.title" = "Smell: 2 scents in the air";
"exercise.grounding.step_5.subtitle" = "Breathe deeply - no scent is also a scent!";
"exercise.grounding.step_5.duration" = "20 sec";

"exercise.grounding.step_6.title" = "Taste: what's lingering in your mouth?";
"exercise.grounding.step_6.subtitle" = "Even subtle, there's always something";
"exercise.grounding.step_6.duration" = "20 sec";

// MARK: - Exercise Instructions - Conscious Stretching
"exercise.stretching.step_1.title" = "Stand up, feet shoulder-width apart";
"exercise.stretching.step_1.subtitle" = "Stable, like you're rooting yourself";
"exercise.stretching.step_1.duration" = "20 sec";

"exercise.stretching.step_2.title" = "Arms to the sky, touch the clouds";
"exercise.stretching.step_2.subtitle" = "Rise while breathing in, lower while breathing out - 3 times";
"exercise.stretching.step_2.duration" = "30 sec";

"exercise.stretching.step_3.title" = "Roll your shoulders (you've been carrying them too long)";
"exercise.stretching.step_3.subtitle" = "5 circles backward, 5 forward - untie it all";
"exercise.stretching.step_3.duration" = "30 sec";

"exercise.stretching.step_4.title" = "Lean to the sides";
"exercise.stretching.step_4.subtitle" = "Arms to the sky, stretch one side then the other - hold for 3 breaths";
"exercise.stretching.step_4.duration" = "40 sec";

"exercise.stretching.step_5.title" = "Turn like a weathervane";
"exercise.stretching.step_5.subtitle" = "Gently twist your torso, look behind you - does it crack? That's a good sign!";
"exercise.stretching.step_5.duration" = "30 sec";

"exercise.stretching.step_6.title" = "3 final deep breaths";
"exercise.stretching.step_6.subtitle" = "Feel how much better your body breathes now";
"exercise.stretching.step_6.duration" = "30 sec";

// MARK: - Exercise Instructions - Audio Relaxation
"exercise.audio.step_1.title" = "Put on your headphones (max comfort!)";
"exercise.audio.step_1.subtitle" = "Find a quiet spot where no one will disturb you";
"exercise.audio.step_1.duration" = "30 sec";

"exercise.audio.step_2.title" = "Lie down like a starfish";
"exercise.audio.step_2.subtitle" = "Or sit in cocoon mode - the important thing is to be relaxed";
"exercise.audio.step_2.duration" = "30 sec";

"exercise.audio.step_3.title" = "Start the audio and close your eyes";
"exercise.audio.step_3.subtitle" = "Let the voice become your GPS to relaxation";
"exercise.audio.step_3.duration" = "1 min";

"exercise.audio.step_4.title" = "Don't force anything, just follow the voice";
"exercise.audio.step_4.subtitle" = "It knows where it's going (promise)";
"exercise.audio.step_4.duration" = "2 min";

"exercise.audio.step_5.title" = "Your body becomes heavier and heavier";
"exercise.audio.step_5.subtitle" = "Like you're slowly sinking into your mattress/chair";
"exercise.audio.step_5.duration" = "2 min";

"exercise.audio.step_6.title" = "Stretch like when you wake up";
"exercise.audio.step_6.subtitle" = "Take your time, open your eyes - how do you feel?";
"exercise.audio.step_6.duration" = "30 sec";

// MARK: - Exercise Instructions - Positive Mantra
"exercise.mantra.step_1.title" = "Choose YOUR magic phrase";
"exercise.mantra.step_1.subtitle" = "\"I am calm\", \"All is well\", \"I've got this\" - one that really speaks to you";
"exercise.mantra.step_1.duration" = "20 sec";

"exercise.mantra.step_2.title" = "Sit comfortably";
"exercise.mantra.step_2.subtitle" = "Hand on your heart if you want (it amplifies the effect)";
"exercise.mantra.step_2.duration" = "15 sec";

"exercise.mantra.step_3.title" = "Close your eyes and smile slightly";
"exercise.mantra.step_3.subtitle" = "Yes, smiling already activates positive mode in your brain";
"exercise.mantra.step_3.duration" = "15 sec";

"exercise.mantra.step_4.title" = "Repeat your mantra with each breath out";
"exercise.mantra.step_4.subtitle" = "In your head or quietly - do it at least 10 times";
"exercise.mantra.step_4.duration" = "1 min";

"exercise.mantra.step_5.title" = "Really feel the words";
"exercise.mantra.step_5.subtitle" = "Not just saying them, believing them - even a little";
"exercise.mantra.step_5.duration" = "30 sec";

"exercise.mantra.step_6.title" = "Breathe deeply 3 times";
"exercise.mantra.step_6.subtitle" = "Open your eyes - your phrase stays with you all day";
"exercise.mantra.step_6.duration" = "20 sec";

// MARK: - Exercise Instructions - Visual Micro-Break
"exercise.visual_break.step_1.title" = "Look away from your screen!";
"exercise.visual_break.step_1.subtitle" = "Find the farthest thing you can see (window ideal)";
"exercise.visual_break.step_1.duration" = "15 sec";

"exercise.visual_break.step_2.title" = "20-20-20 rule: stare at a distant point for 20 seconds";
"exercise.visual_break.step_2.subtitle" = "At least 20 feet away - a tree, a building, the end of the street";
"exercise.visual_break.step_2.duration" = "20 sec";

"exercise.visual_break.step_3.title" = "Blink 10 times (for real)";
"exercise.visual_break.step_3.subtitle" = "Your eyes are dry from staring - rehydrate them";
"exercise.visual_break.step_3.duration" = "15 sec";

"exercise.visual_break.step_4.title" = "Express massage: circles on temples";
"exercise.visual_break.step_4.subtitle" = "3 gentle circles on each side - yes, it really relaxes";
"exercise.visual_break.step_4.duration" = "20 sec";

"exercise.visual_break.step_5.title" = "Close your eyes for 10 seconds (mini spa)";
"exercise.visual_break.step_5.subtitle" = "Complete darkness, exactly what your eyes were craving";
"exercise.visual_break.step_5.duration" = "15 sec";

"exercise.visual_break.step_6.title" = "Open again - better already, right?";
"exercise.visual_break.step_6.subtitle" = "Repeat every hour of screen time (challenge accepted?)";
"exercise.visual_break.step_6.duration" = "15 sec";

// MARK: - Exercise Instructions - Slow Walk
"exercise.slow_walk.step_1.title" = "Find 15-30 feet of free space";
"exercise.slow_walk.step_1.subtitle" = "Indoor, outdoor, hallway - doesn't matter, just a mini path";
"exercise.slow_walk.step_1.duration" = "30 sec";

"exercise.slow_walk.step_2.title" = "Stand up, feet grounded";
"exercise.slow_walk.step_2.subtitle" = "Feel all your weight - you're connected to the earth like a tree";
"exercise.slow_walk.step_2.duration" = "20 sec";

"exercise.slow_walk.step_3.title" = "Walk SUPER SLOWLY (like turtle mode)";
"exercise.slow_walk.step_3.subtitle" = "Break it down: heel lifting, foot rolling, toe pushing off... fascinating, right?";
"exercise.slow_walk.step_3.duration" = "1 min";

"exercise.slow_walk.step_4.title" = "Sync each step with your breath";
"exercise.slow_walk.step_4.subtitle" = "1 step = 1 breath in, 1 step = 1 breath out (find your rhythm)";
"exercise.slow_walk.step_4.duration" = "1 min";

"exercise.slow_walk.step_5.title" = "Continue for 5 minutes - it's meditative";
"exercise.slow_walk.step_5.subtitle" = "Your mind will complain \"too slow\" - that's exactly the point";
"exercise.slow_walk.step_5.duration" = "5 min";

"exercise.slow_walk.step_6.title" = "Stop, breathe 3 times";
"exercise.slow_walk.step_6.subtitle" = "Feel that strange calm that settled in? Keep it.";
"exercise.slow_walk.step_6.duration" = "30 sec";

// MARK: - Exercise Instructions - White Noise
"exercise.white_noise.step_1.title" = "Choose your sound ambiance";
"exercise.white_noise.step_1.subtitle" = "Falling rain, ocean waves, or pure white noise - test and find your favorite";
"exercise.white_noise.step_1.duration" = "30 sec";

"exercise.white_noise.step_2.title" = "Headphones or speakers + soft volume";
"exercise.white_noise.step_2.subtitle" = "Low enough to envelop without invading (like background whisper)";
"exercise.white_noise.step_2.duration" = "20 sec";

"exercise.white_noise.step_3.title" = "Get in cocooning mode";
"exercise.white_noise.step_3.subtitle" = "Lying down or sitting - maximum relaxation position activated";
"exercise.white_noise.step_3.duration" = "30 sec";

"exercise.white_noise.step_4.title" = "Close your eyes, melt into the sound";
"exercise.white_noise.step_4.subtitle" = "Let each wave/drop/vibration rock your brain";
"exercise.white_noise.step_4.duration" = "1 min";

"exercise.white_noise.step_5.title" = "10 minutes minimum (or more, you're in control)";
"exercise.white_noise.step_5.subtitle" = "Some fall asleep, others meditate - everything's perfect";
"exercise.white_noise.step_5.duration" = "10 min";

"exercise.white_noise.step_6.title" = "Come back gently, stretch";
"exercise.white_noise.step_6.subtitle" = "Feel that relaxation? You can keep the sound in the background if you want";
