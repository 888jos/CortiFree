"learning.card.breathing.section1.content" = "Conscious breathing is one of the most powerful tools to regulate your stress:\n\n• Activates the parasympathetic nervous system (relaxation)\n• Reduces heart rate\n• Lowers blood pressure";
"learning.card.breathing.section2.title" = "Long-term benefits";
"learning.card.breathing.section2.content" = "• Improves stress management\n• Increases lung capacity\n• Promotes mental clarity";
