"learning.card.exercise.section1.title" = "Effects on cortisol";
"learning.card.exercise.section1.content" = "Physical activity is a natural stress regulator:\n\n• Short term: slight increase (normal)\n• Long term: significant decrease in baseline cortisol";
"learning.card.exercise.section2.title" = "Additional benefits";
"learning.card.exercise.section2.content" = "• Release of endorphins (happiness hormones)\n• Improved sleep\n• Better self-esteem";
"learning.card.exercise.section3.title" = "Ideal duration";
"learning.card.exercise.section3.content" = "• 20-30 min per session\n• 3-5 times per week\n• Moderate intensity";
"learning.card.exercise.section4.title" = "Caution";
"learning.card.exercise.section4.content" = "Too much intense exercise can increase cortisol. Balance is key!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "Positive social relationships";
"learning.card.social.description" = "The importance of social support";
"learning.card.social.section1.title" = "Impact on cortisol";
"learning.card.social.section1.content" = "Quality social connections are essential for managing stress:\n\n• Positive interactions help you feel calmer\n• Release of oxytocin (\"love hormone\")\n• Feeling of security and belonging";
"learning.card.social.section2.title" = "Types of beneficial connections";
"learning.card.social.section2.content" = "• Deep conversations with friends\n• Quality moments with family\n• Group activities (sports, hobbies)";
"learning.card.social.section3.title" = "To avoid";
"learning.card.social.section3.content" = "• Prolonged isolation\n• Toxic or conflictual relationships";
"learning.card.social.section4.title" = "Did you know?";
"learning.card.social.section4.content" = "A simple 20-second hug can significantly reduce your stress level!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "Exposure to natural light";
"learning.card.light.description" = "Regulates your biological clock";
"learning.card.light.section1.title" = "The importance of morning";
"learning.card.light.section1.content" = "Natural light plays a crucial role in regulating your cortisol and circadian rhythm:\n\n• Get light exposure within 30-60 min after waking\n• 10-30 minutes minimum outdoors (even on cloudy days)\n• Activates morning cortisol production (normal and beneficial)\n• Stops melatonin production (sleep hormone)";
"learning.card.light.section2.title" = "Impact on your biological clock";
"learning.card.light.section2.content" = "• Regulates the cortisol/melatonin cycle\n• Improves nighttime sleep quality\n• Increases daytime energy and alertness\n• Synchronizes all your biological rhythms";
"learning.card.light.section3.title" = "Scientific studies";
"learning.card.light.section3.content" = "• More daytime energy with morning light\n• Falling asleep more easily in the evening\n• May help lift your mood\n• Better appetite regulation";
"learning.card.light.section4.title" = "In the evening, avoid";
"learning.card.light.section4.content" = "• Screens 1-2 hours before bedtime\n• Bright lights (prefer warm/dimmed lights)\n• Blue light that blocks melatonin";
"learning.card.light.section5.title" = "CortiFree tip";
"learning.card.light.section5.content" = "Combine your morning walk with natural light exposure for a multiplied effect on your energy and stress!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "Automatic negative thoughts";
"learning.card.negative_thoughts.description" = "Identifying and replacing toxic patterns";
"learning.card.negative_thoughts.section1.title" = "The 7 types of toxic thoughts";
"learning.card.negative_thoughts.section1.content" = "Your thoughts directly influence your stress and cortisol level. Learning to identify and modify automatic negative thoughts is crucial.\n\n1️⃣ Catastrophizing: \"If I fail this exam, my life is over\"\n→ Reality: A failure isn't the end\n\n2️⃣ All-or-nothing thinking: \"If it's not perfect, it's a failure\"\n→ Reality: Life is made of nuances\n\n3️⃣ Overgeneralization: \"I failed once, I always fail\"\n→ Reality: One situation ≠ all situations\n\n4️⃣ Mental filter: Ignoring the positive, focusing on the negative\n→ Reality: Also look for what's going well\n\n5️⃣ Mind reading: \"They think I'm incompetent\"\n→ Reality: You can't read minds\n\n6️⃣ Personalization: \"It's definitely my fault\"\n→ Reality: Not everything depends on you\n\n7️⃣ Tyrannical obligations: \"I MUST be perfect\"\n→ Reality: Nobody is perfect";
"learning.card.negative_thoughts.section2.title" = "The 3-column technique";
"learning.card.negative_thoughts.section2.content" = "Column 1: Situation\nColumn 2: Automatic thought\nColumn 3: Realistic alternative thought";
"learning.card.negative_thoughts.section3.title" = "Measurable impact";
"learning.card.negative_thoughts.section3.content" = "• Cognitive techniques are well studied for reducing anxiety\n• Identifying and reframing these thoughts can lower stress\n• Lasting improvement often comes after 8-12 weeks of practice";
"learning.card.negative_thoughts.section4.title" = "Journaling tip";
"learning.card.negative_thoughts.section4.content" = "Writing your thoughts in the CortiFree journal helps you identify, question, and transform them!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "Gratitude and the brain";
"learning.card.gratitude.description" = "The scientific effect of recognition";
"learning.card.gratitude.section1.title" = "What happens in your brain";
"learning.card.gratitude.section1.content" = "Practicing gratitude isn't just \"positive thinking\": it is a well-studied practice that can shift your focus and stress level.\n\n• Linked to activity in brain areas involved in well-being\n• May boost positive emotions\n• May help you feel less stressed";
"learning.card.gratitude.section2.title" = "Major scientific studies";
"learning.card.gratitude.section2.content" = "What studies suggest:\n• Writing a gratitude journal a few times a week\n• Associated with better mood over time\n• Improved sleep and social relationships\n\nIn daily life:\n• 5 minutes of gratitude per day\n• Many people report feeling happier\n• And less anxious";
"learning.card.gratitude.section3.title" = "How to practice effectively";
"learning.card.gratitude.section3.content" = "3 gratitudes method (5 min/day):\n1. Write 3 things you're grateful for\n2. Be specific (not just \"my family\")\n3. Feel the emotion while writing\n4. Vary your gratitudes each day\n\nExamples:\nToo vague: \"I'm grateful for my health\"\nSpecific: \"I'm grateful I could do my morning walk without pain and feel the fresh air on my face\"";
"learning.card.gratitude.section4.title" = "Long-term effects";
"learning.card.gratitude.section4.content" = "After 4 weeks:\n• Measurable changes in the brain\n• Better sleep quality\n• More positive emotions\n\nAfter 12 weeks:\n• New higher happiness baseline\n• Increased resilience to stress\n• Better interpersonal relationships";
"learning.card.gratitude.section5.title" = "Integrated in CortiFree";
"learning.card.gratitude.section5.content" = "The journal allows you to note your daily gratitudes. This simple 2-3 minute practice can transform your relationship with stress!";
"learning.card.gratitude.section6.title" = "Important";
"learning.card.gratitude.section6.content" = "Gratitude doesn't deny problems, it trains your brain to also see the positive instead of focusing only on the negative.";

