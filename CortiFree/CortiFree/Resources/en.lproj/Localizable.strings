"learning.card.food.title" = "Anti-stress nutrition";
"learning.card.food.description" = "Foods that regulate cortisol";
"learning.card.food.section1.title" = "Foods that REDUCE cortisol";
"learning.card.food.section1.content" = "Healthy fats:\n• Avocados, nuts, almonds\n• Olive oil, fatty fish (salmon, mackerel)\n• Rich in anti-inflammatory omega-3s\n\nMagnesium-rich foods:\n• Dark chocolate (>70% cocoa)\n• Spinach, bananas\n• Pumpkin seeds, almonds\n• Magnesium reduces anxiety and cortisol\n\nVitamin C:\n• Citrus fruits, kiwis, peppers\n• Reduces cortisol by 15-20%\n• Strengthens the immune system\n\nGreen and black tea:\n• L-theanine that calms the mind\n• 20% reduction in cortisol after 6 weeks";
"learning.card.food.section2.title" = "Foods that INCREASE cortisol";
"learning.card.food.section2.content" = "Excess caffeine:\n• More than 400mg/day (4 coffees)\n• Increases cortisol by 30%\n• Disrupts sleep\n\nRefined sugars:\n• Blood sugar spikes = cortisol spikes\n• Systemic inflammation\n• Addiction and cravings\n\nAlcohol:\n• Disrupts deep sleep\n• Increases nighttime cortisol\n• Dehydration";
"learning.card.food.section3.title" = "Timing matters";
"learning.card.food.section3.content" = "• Protein-rich breakfast (stabilizes cortisol)\n• Avoid sugars and caffeine in the evening\n• Light dinner 2-3 hours before bed";

// MARK: - Learning Card 8: Conscious breathing
"learning.card.breathing.title" = "The benefits of conscious breathing";
"learning.card.breathing.description" = "Why breathing consciously works";
"learning.card.breathing.section1.title" = "Immediate effects";
"learning.card.breathing.section1.content" = "Conscious breathing is one of the most powerful tools to regulate your stress:\n\n• Activates the parasympathetic nervous system (relaxation)\n• Reduces heart rate\n• Lowers blood pressure";
"learning.card.breathing.section2.title" = "Long-term benefits";
"learning.card.breathing.section2.content" = "• Improves stress management\n• Increases lung capacity\n• Promotes mental clarity";
"learning.card.breathing.section3.title" = "Did you know?";
"learning.card.breathing.section3.content" = "A deep breath can reduce your cortisol level in just 2-3 minutes!\n\nThat's why breathing exercises are at the heart of the CortiFree program.";

// MARK: - Learning Card 9: Power of nature
"learning.card.nature.title" = "The power of nature";
"learning.card.nature.description" = "Why nature soothes";
"learning.card.nature.section1.title" = "Scientific studies";
"learning.card.nature.section1.content" = "Contact with nature has a proven effect on stress:\n\n• -15% cortisol after 20 min in nature\n• Decreased blood pressure\n• Improved mood";
"learning.card.nature.section2.title" = "Forest bathing (Shinrin-yoku)";
"learning.card.nature.section2.content" = "• Ancient Japanese practice\n• Slow walk in the forest\n• Connection with the 5 senses";
"learning.card.nature.section3.title" = "Benefits";
"learning.card.nature.section3.content" = "• Strengthened immune system\n• Reduced anxiety\n• Better creativity";
"learning.card.nature.section4.title" = "Even in the city";
"learning.card.nature.section4.content" = "A park, garden, or indoor plants already have positive effects!";

// MARK: - Learning Card 10: Cardiac coherence
"learning.card.cardiac_coherence.title" = "Cardiac coherence";
"learning.card.cardiac_coherence.description" = "Synchronizing heart and brain";
"learning.card.cardiac_coherence.section1.title" = "How it works";
"learning.card.cardiac_coherence.section1.content" = "Cardiac coherence is a breathing technique that synchronizes your heart rate with your brain for a powerful anti-stress effect.\n\n• Breathing: 6 cycles per minute (5 sec inhale, 5 sec exhale)\n• Duration: 5 minutes\n• Frequency: 3 times a day (morning, noon, evening)\n• It's the 365 method: 3 times/day, 6 breaths/min, 5 minutes";
"learning.card.cardiac_coherence.section2.title" = "Immediate benefits";
"learning.card.cardiac_coherence.section2.content" = "• Cortisol reduction in 3-5 minutes\n• Decreased heart rate\n• Lower blood pressure\n• Feeling of calm and mental clarity";
"learning.card.cardiac_coherence.section3.title" = "Long-term effects (after 2 weeks)";
"learning.card.cardiac_coherence.section3.content" = "• -24% cortisol on average\n• Better emotional regulation\n• Improved sleep quality\n• Strengthened immune system\n• +17% DHEA (anti-aging hormone)";
"learning.card.cardiac_coherence.section4.title" = "Used by";
"learning.card.cardiac_coherence.section4.content" = "• Fighter pilots\n• Elite athletes\n• Doctors and healthcare workers\n• Business executives";
"learning.card.cardiac_coherence.section5.title" = "In CortiFree";
"learning.card.cardiac_coherence.section5.content" = "The \"5-5 Cardiac Coherence\" exercise in the Breathing section follows exactly this scientific method.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "Yoga and mental flexibility";
"learning.card.yoga.description" = "Beyond simple flexibility";
"learning.card.yoga.section1.title" = "Types of anti-stress yoga";
"learning.card.yoga.section1.content" = "Yoga is much more than a physical practice. It's a powerful stress regulation tool that acts on your body AND your mind.\n\n• Hatha Yoga: gentle, perfect for beginners\n• Yin Yoga: long postures, very relaxing\n• Yoga Nidra: guided lying meditation\n• Vinyasa: dynamic but meditative";
"learning.card.yoga.section2.title" = "Effects on cortisol";
"learning.card.yoga.section2.content" = "• -27% after a 60-min session\n• Cumulative effects with regular practice\n• -41% cortisol after 12 weeks (3x/week)";
"learning.card.yoga.section3.title" = "Scientifically proven benefits";
"learning.card.yoga.section3.content" = "Physical:\n• Flexibility and muscle strength\n• Better posture\n• Reduced chronic pain\n• Improved balance\n\nMental:\n• -65% anxiety symptoms\n• Better emotional regulation\n• Increased gray matter\n• Improved concentration\n\nPhysiological:\n• Activation of the parasympathetic system (relaxation)\n• Better heart rate variability\n• Reduced inflammation\n• Improved digestion";
"learning.card.yoga.section4.title" = "What happens in your brain";
"learning.card.yoga.section4.content" = "• Increased GABA (calming neurotransmitter)\n• Reduced amygdala activity (fear/stress)\n• Activated prefrontal cortex (emotional control)";
"learning.card.yoga.section5.title" = "No need to be flexible";
"learning.card.yoga.section5.content" = "Yoga isn't a competition. Every body is different, and the anti-stress benefits come from the very first sessions, even with adaptations!";

// MARK: - Learning Card 12: Sleep and cortisol
"learning.card.sleep_cortisol.title" = "Sleep and cortisol";
"learning.card.sleep_cortisol.description" = "The importance of a good circadian rhythm";
"learning.card.sleep_cortisol.section1.title" = "The natural rhythm";
"learning.card.sleep_cortisol.section1.content" = "Your sleep and cortisol level are intimately linked:\n\n• High cortisol in the morning (to wake you up)\n• Low cortisol in the evening (to sleep)";
"learning.card.sleep_cortisol.section2.title" = "When it goes wrong";
"learning.card.sleep_cortisol.section2.content" = "• Disrupted sleep → High cortisol 24/7\n• Vicious cycle: stress → poor sleep → more stress";
"learning.card.sleep_cortisol.section3.title" = "CortiFree solutions";
"learning.card.sleep_cortisol.section3.content" = "• Wake up before 7am (morning routine)\n• Go to bed before 11pm (recovery)\n• Evening meditation (sleep preparation)";
"learning.card.sleep_cortisol.section4.title" = "Did you know?";
"learning.card.sleep_cortisol.section4.content" = "A single night of poor sleep can increase your cortisol by 37% the next day!";

// MARK: - Learning Card 13: Hydration
"learning.card.hydration.title" = "Hydration and stress";
"learning.card.hydration.description" = "Why drinking water reduces stress";
"learning.card.hydration.section1.title" = "Effects of dehydration";
"learning.card.hydration.section1.content" = "Water plays a crucial role in stress regulation:\n\n• Increased cortisol (+25%)\n• Fatigue and irritability\n• Difficulty concentrating";
"learning.card.hydration.section2.title" = "Benefits of good hydration";
"learning.card.hydration.section2.content" = "• Body temperature regulation\n• Toxin elimination\n• Better brain function";
"learning.card.hydration.section3.title" = "Recommendation";
"learning.card.hydration.section3.content" = "• Minimum 2L of water per day\n• More if physically active\n• Spread throughout the day";
"learning.card.hydration.section4.title" = "Tip";
"learning.card.hydration.section4.content" = "Start your day with a large glass of water to wake up your metabolism!";

// MARK: - Learning Card 14: Physical exercise
"learning.card.exercise.title" = "Anti-stress physical exercise";
"learning.card.exercise.description" = "How sport regulates cortisol";
"learning.card.exercise.section1.title" = "Effects on cortisol";
"learning.card.exercise.section1.content" = "Physical activity is a natural stress regulator:\n\n• Short term: slight increase (normal)\n• Long term: significant decrease in baseline cortisol";
"learning.card.exercise.section2.title" = "Additional benefits";
"learning.card.exercise.section2.content" = "• Release of endorphins (happiness hormones)\n• Improved sleep\n• Better self-esteem";
"learning.card.exercise.section3.title" = "Ideal duration";
"learning.card.exercise.section3.content" = "• 20-30 min per session\n• 3-5 times per week\n• Moderate intensity";
"learning.card.exercise.section4.title" = "Caution";
"learning.card.exercise.section4.content" = "Too much intense exercise can increase cortisol. Balance is key!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "Positive social relationships";
"learning.card.social.description" = "The importance of social support";
"learning.card.social.section1.title" = "Impact on cortisol";
"learning.card.social.section1.content" = "Quality social connections are essential for managing stress:\n\n• Positive interactions → -20% cortisol\n• Release of oxytocin (\"love hormone\")\n• Feeling of security and belonging";
"learning.card.social.section2.title" = "Types of beneficial connections";
"learning.card.social.section2.content" = "• Deep conversations with friends\n• Quality moments with family\n• Group activities (sports, hobbies)";
"learning.card.social.section3.title" = "To avoid";
"learning.card.social.section3.content" = "• Prolonged isolation\n• Toxic or conflictual relationships";
"learning.card.social.section4.title" = "Did you know?";
"learning.card.social.section4.content" = "A simple 20-second hug can significantly reduce your stress level!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "Exposure to natural light";
"learning.card.light.description" = "Regulates your biological clock";
"learning.card.light.section1.title" = "The importance of morning";
"learning.card.light.section1.content" = "Natural light plays a crucial role in regulating your cortisol and circadian rhythm:\n\n• Get light exposure within 30-60 min after waking\n• 10-30 minutes minimum outdoors (even on cloudy days)\n• Activates morning cortisol production (normal and beneficial)\n• Stops melatonin production (sleep hormone)";
"learning.card.light.section2.title" = "Impact on your biological clock";
"learning.card.light.section2.content" = "• Regulates the cortisol/melatonin cycle\n• Improves nighttime sleep quality\n• Increases daytime energy and alertness\n• Synchronizes all your biological rhythms";
"learning.card.light.section3.title" = "Scientific studies";
"learning.card.light.section3.content" = "• +25% daytime energy with morning exposure\n• Fall asleep 1 hour faster in the evening\n• -35% depressive symptoms\n• Better appetite regulation";
"learning.card.light.section4.title" = "In the evening, avoid";
"learning.card.light.section4.content" = "• Screens 1-2 hours before bedtime\n• Bright lights (prefer warm/dimmed lights)\n• Blue light that blocks melatonin";
"learning.card.light.section5.title" = "CortiFree tip";
"learning.card.light.section5.content" = "Combine your morning walk with natural light exposure for a multiplied effect on your energy and stress!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "Automatic negative thoughts";
"learning.card.negative_thoughts.description" = "Identifying and replacing toxic patterns";
"learning.card.negative_thoughts.section1.title" = "The 7 types of toxic thoughts";
"learning.card.negative_thoughts.section1.content" = "Your thoughts directly influence your stress and cortisol level. Learning to identify and modify automatic negative thoughts is crucial.\n\n1️⃣ Catastrophizing: \"If I fail this exam, my life is over\"\n→ Reality: A failure isn't the end\n\n2️⃣ All-or-nothing thinking: \"If it's not perfect, it's a failure\"\n→ Reality: Life is made of nuances\n\n3️⃣ Overgeneralization: \"I failed once, I always fail\"\n→ Reality: One situation ≠ all situations\n\n4️⃣ Mental filter: Ignoring the positive, focusing on the negative\n→ Reality: Also look for what's going well\n\n5️⃣ Mind reading: \"They think I'm incompetent\"\n→ Reality: You can't read minds\n\n6️⃣ Personalization: \"It's definitely my fault\"\n→ Reality: Not everything depends on you\n\n7️⃣ Tyrannical obligations: \"I MUST be perfect\"\n→ Reality: Nobody is perfect";
"learning.card.negative_thoughts.section2.title" = "The 3-column technique";
"learning.card.negative_thoughts.section2.content" = "Column 1: Situation\nColumn 2: Automatic thought\nColumn 3: Realistic alternative thought";
"learning.card.negative_thoughts.section3.title" = "Measurable impact";
"learning.card.negative_thoughts.section3.content" = "• -40% anxiety with cognitive therapy\n• -28% cortisol by identifying and modifying these thoughts\n• Lasting improvement after 8-12 weeks";
"learning.card.negative_thoughts.section4.title" = "Journaling tip";
"learning.card.negative_thoughts.section4.content" = "Writing your thoughts in the CortiFree journal helps you identify, question, and transform them!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "Gratitude and the brain";
"learning.card.gratitude.description" = "The scientific effect of recognition";
"learning.card.gratitude.section1.title" = "What happens in your brain";
"learning.card.gratitude.section1.content" = "Practicing gratitude isn't just \"positive thinking\": it's a scientifically validated technique that modifies your brain and stress level.\n\n• Activation of the medial prefrontal cortex (well-being)\n• Release of dopamine and serotonin (happiness)\n• Reduced amygdala activity (stress/fear)\n• -23% cortisol on average";
"learning.card.gratitude.section2.title" = "Major scientific studies";
"learning.card.gratitude.section2.content" = "UC Berkeley (2015):\n• Gratitude journaling 3x/week\n• -27% depression after 12 weeks\n• Improved sleep and social relationships\n\nHarvard Medical School (2021):\n• 5 minutes of gratitude per day\n• +25% happiness felt\n• -18% anxiety";
"learning.card.gratitude.section3.title" = "How to practice effectively";
"learning.card.gratitude.section3.content" = "3 gratitudes method (5 min/day):\n1. Write 3 things you're grateful for\n2. Be specific (not just \"my family\")\n3. Feel the emotion while writing\n4. Vary your gratitudes each day\n\nExamples:\nToo vague: \"I'm grateful for my health\"\nSpecific: \"I'm grateful I could do my morning walk without pain and feel the fresh air on my face\"";
"learning.card.gratitude.section4.title" = "Long-term effects";
"learning.card.gratitude.section4.content" = "After 4 weeks:\n• Measurable changes in the brain\n• Better sleep quality\n• More positive emotions\n\nAfter 12 weeks:\n• New higher happiness baseline\n• Increased resilience to stress\n• Better interpersonal relationships";
"learning.card.gratitude.section5.title" = "Integrated in CortiFree";
"learning.card.gratitude.section5.content" = "The journal allows you to note your daily gratitudes. This simple 2-3 minute practice can transform your relationship with stress!";
"learning.card.gratitude.section6.title" = "Important";
"learning.card.gratitude.section6.content" = "Gratitude doesn't deny problems, it trains your brain to also see the positive instead of focusing only on the negative.";

