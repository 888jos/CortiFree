// MARK: - Learning Card 1: Cortisol
"learning.card.cortisol.title" = "What is cortisol?";
"learning.card.cortisol.description" = "Understanding the stress hormone";
"learning.card.cortisol.section1.title" = "Introduction";
"learning.card.cortisol.section1.content" = "Cortisol is often called \"the stress hormone.\" It's produced by the adrenal glands and plays an essential role in your body's response to stress.";
"learning.card.cortisol.section2.title" = "Positive roles of cortisol";
"learning.card.cortisol.section2.content" = "• Regulates your energy levels throughout the day\n• Helps manage difficult and stressful situations\n• Controls blood pressure and blood sugar\n• Reduces inflammation in the body\n• Participates in the metabolism of fats, proteins, and carbohydrates\n• Regulates the sleep-wake cycle (circadian rhythm)";
"learning.card.cortisol.section3.title" = "Problems of chronic excess";
"learning.card.cortisol.section3.content" = "• Chronic anxiety and sleep disorders\n• Weight gain (especially around the abdomen)\n• Weakened immune system\n• High blood pressure\n• Difficulty concentrating and memory problems\n• Premature skin aging\n• Persistent fatigue despite rest\n• Digestive issues";
"learning.card.cortisol.section4.title" = "Normal levels";
"learning.card.cortisol.section4.content" = "Cortisol follows a natural rhythm: high in the morning (peak around 8am) to wake you up, then gradually decreases throughout the day to be at its lowest in the evening (around 11pm) allowing you to sleep.";
"learning.card.cortisol.section5.title" = "CortiFree's goal";
"learning.card.cortisol.section5.content" = "To help you maintain a healthy and balanced cortisol level through scientifically proven habits that naturally regulate this hormone.";

// MARK: - Learning Card 2: Meditation
"learning.card.meditation_science.title" = "The science of meditation";
"learning.card.meditation_science.description" = "What neuroscience says";
"learning.card.meditation_science.section1.title" = "Scientific evidence";
"learning.card.meditation_science.section1.content" = "Thousands of scientific studies have demonstrated the benefits of meditation:\n\n• Thickening of the prefrontal cortex\n• Reduction of the amygdala (fear center)\n• Increase in gray matter";
"learning.card.meditation_science.section2.title" = "Measurable results";
"learning.card.meditation_science.section2.content" = "• Research associates regular meditation with lower stress levels\n• It may improve concentration over time\n• Many people report fewer anxiety symptoms";
"learning.card.meditation_science.section3.title" = "Time needed";
"learning.card.meditation_science.section3.content" = "Visible brain changes appear after just 8 weeks of daily practice for 10-15 minutes.\n\nYou're already on the right track with CortiFree!";

// MARK: - Learning Card 3: 66 days
"learning.card.66days.title" = "How long does a habit take?";
"learning.card.66days.description" = "What science says, and why your plan moves in 28-day cycles";
"learning.card.66days.section1.title" = "The reference study";
"learning.card.66days.section1.content" = "• University College London (2009)\n• A daily behaviour took from 18 to 254 days to become automatic\n• It depends on the person and on how complex the habit is";
"learning.card.66days.section2.title" = "The 3 phases";
"learning.card.66days.section2.content" = "1. Weeks 1-3: Period of conscious effort\n2. Weeks 4-7: Beginning of automation\n3. Weeks 8-10: Habit anchored";
"learning.card.66days.section3.title" = "Why it works";
"learning.card.66days.section3.content" = "• Creation of new neural connections\n• Progressive reinforcement\n• Transformation into automatic reflex";
"learning.card.66days.section4.title" = "Your goal";
"learning.card.66days.section4.content" = "Cycle after cycle, your new anti-stress habits become part of your life!";

// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplasticity: your brain can change";
"learning.card.neuroplasticity.description" = "How your brain adapts and evolves";
"learning.card.neuroplasticity.section1.title" = "What it means";
"learning.card.neuroplasticity.section1.content" = "Neuroplasticity is your brain's ability to rewire itself and create new neural connections throughout your life.\n\n• Your brain isn't fixed, it constantly evolves\n• Each new habit creates new neural circuits\n• Old habits can be \"unlearned\"\n• The more you practice, the stronger the connections become";
"learning.card.neuroplasticity.section2.title" = "Scientific evidence";
"learning.card.neuroplasticity.section2.content" = "• MRI scans show structural changes after 8 weeks of meditation\n• Brain areas linked to stress (amygdala) can decrease in volume\n• Areas linked to concentration (prefrontal cortex) can thicken\n• Gray matter increases in regularly used areas";
"learning.card.neuroplasticity.section3.title" = "How long it takes";
"learning.card.neuroplasticity.section3.content" = "• First changes: 2-4 weeks\n• Measurable changes: 6-8 weeks\n• Lasting changes: 2-3 months";
"learning.card.neuroplasticity.section4.title" = "The important message";
"learning.card.neuroplasticity.section4.content" = "You're not doomed to stay stressed. With CortiFree, you're literally reprogramming your brain to better manage stress!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "Sleep cycles";
"learning.card.sleep_cycles.description" = "Understanding and optimizing your rest";
"learning.card.sleep_cycles.section1.title" = "The 4 phases of sleep";
"learning.card.sleep_cycles.section1.content" = "Sleep consists of 90-minute cycles repeated 4-6 times per night:\n\n1️⃣ Light sleep (5-10 min): Wake-sleep transition, muscles relax, easy to wake up\n\n2️⃣ Deep light sleep (20 min): Heart rate slows, body temperature drops, 50% of total time\n\n3️⃣ Deep sleep (20-40 min): Most restorative phase, physical regeneration, MAXIMUM CORTISOL REDUCTION\n\n4️⃣ REM / Paradoxical sleep (10-60 min): Intense dreams, emotional consolidation, stress processing";
"learning.card.sleep_cycles.section2.title" = "Optimizing your cycles";
"learning.card.sleep_cycles.section2.content" = "• Aim for 7.5 or 9 hours of sleep (5 or 6 complete cycles)\n• Avoid 6 or 8 hours (waking mid-cycle = fatigue)\n• Go to bed and wake up at fixed times (even on weekends)";
"learning.card.sleep_cycles.section3.title" = "Impact on cortisol";
"learning.card.sleep_cycles.section3.content" = "• Deep sleep helps your body recover from stress\n• Lack of sleep can leave you more stressed the next day\n• Repeated short nights affect your overall health: talk to a doctor if poor sleep persists";
"learning.card.sleep_cycles.section4.title" = "Quality > Quantity";
"learning.card.sleep_cycles.section4.content" = "Better to have 6 hours with lots of deep sleep than 8 hours of light and fragmented sleep!";

// MARK: - Learning Card 6: Stress and body
"learning.card.stress_body.title" = "How stress affects your body";
"learning.card.stress_body.description" = "The physical impacts of chronic stress";
"learning.card.stress_body.section1.title" = "Brain";
"learning.card.stress_body.section1.content" = "• Difficulty concentrating\n• Memory problems\n• Anxiety and depression";
"learning.card.stress_body.section2.title" = "Heart";
"learning.card.stress_body.section2.content" = "• Increased blood pressure\n• Elevated cardiovascular risk\n• Palpitations";
"learning.card.stress_body.section3.title" = "Muscles";
"learning.card.stress_body.section3.content" = "• Tension and pain\n• Headaches\n• Chronic fatigue";
"learning.card.stress_body.section4.title" = "Energy";
"learning.card.stress_body.section4.content" = "• Exhaustion\n• Sleep disorders\n• Decreased motivation\n\nThat's why it's crucial to manage stress daily.";

// MARK: - Learning Card 7: Anti-stress food
"learning.card.food.title" = "Anti-stress nutrition";
"learning.card.food.description" = "Foods that regulate cortisol";
"learning.card.food.section1.title" = "Foods that REDUCE cortisol";
"learning.card.food.section1.content" = "Healthy fats:\n• Avocados, nuts, almonds\n• Olive oil, fatty fish (salmon, mackerel)\n• Rich in anti-inflammatory omega-3s\n\nMagnesium-rich foods:\n• Dark chocolate (>70% cocoa)\n• Spinach, bananas\n• Pumpkin seeds, almonds\n• Magnesium plays a role in nervous system balance\n\nVitamin C:\n• Citrus fruits, kiwis, peppers\n• May help the body cope with stress\n• Strengthens the immune system\n\nGreen and black tea:\n• L-theanine that calms the mind\n• A gentler alternative to coffee";
"learning.card.food.section2.title" = "Foods that INCREASE cortisol";
"learning.card.food.section2.content" = "Excess caffeine:\n• More than 400mg/day (4 coffees)\n• Can amplify the stress response\n• Disrupts sleep\n\nRefined sugars:\n• Blood sugar spikes and crashes\n• Can affect mood and energy\n• Cravings\n\nAlcohol:\n• Disrupts deep sleep\n• Can leave you more tense the next day\n• Dehydration";
"learning.card.food.section3.title" = "Timing matters";
"learning.card.food.section3.content" = "• Protein-rich breakfast (stabilizes cortisol)\n• Avoid sugars and caffeine in the evening\n• Light dinner 2-3 hours before bed";

