"learning.card.cardiac_coherence.section5.content" = "The \"5-5 Cardiac Coherence\" exercise in the Breathing section follows exactly this scientific method.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "Yoga and mental flexibility";
