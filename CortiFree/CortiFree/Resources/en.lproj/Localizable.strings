"breathing.ex.coherence.title" = "Cardiac Coherence 5-5";
"breathing.ex.coherence.benefit" = "6 breaths a minute to balance your nervous system and lower cortisol.";
"breathing.ex.coherence.when" = "Three times a day (morning, before lunch, late afternoon) or whenever stress builds up. The classic 3-6-5 routine: 3 times a day, 6 breaths per minute, 5 minutes.";
"breathing.ex.coherence.science" = "Breathing at about 6 breaths per minute synchronises heart rate and breath (resonance), raising heart-rate variability and vagal tone. Regular practice is associated with lower evening cortisol.";
"breathing.ex.extended_exhale.title" = "Long Exhale 4-8";
"breathing.ex.extended_exhale.benefit" = "Exhale twice as long as you inhale to switch on your body's calming brake.";
"breathing.ex.extended_exhale.when" = "When you feel tense or irritated, or your thoughts are racing. Works anywhere, even with your eyes open.";
"breathing.ex.extended_exhale.science" = "The exhale slows the heart through the vagus nerve. Making it longer than the inhale shifts the balance toward the parasympathetic system within a few minutes.";
"breathing.ex.deep_abdominal.title" = "Belly Breathing 4-2-6";
"breathing.ex.deep_abdominal.benefit" = "The foundation: breathe low into your belly to release tension.";
"breathing.ex.deep_abdominal.when" = "The ideal place to start, or as a reset between two tasks. Place a hand on your belly and feel it rise and fall.";
"breathing.ex.deep_abdominal.science" = "Diaphragmatic breathing lowers breathing rate and muscle tension. Trials report reduced cortisol and better sustained attention after a few weeks of practice.";
"breathing.ex.humming.title" = "Humming Bee 4-7";
"breathing.ex.humming.benefit" = "Hum softly as you exhale: the vibration soothes and naturally lengthens your breath.";
"breathing.ex.humming.when" = "When your mind feels noisy, or before a difficult conversation. Keep your mouth closed and make a soft ‘mmm’ throughout the exhale.";
"breathing.ex.humming.science" = "Humming (Bhramari) extends the exhale and stimulates the vagus nerve through throat vibration. It also increases nasal nitric oxide, which supports relaxed breathing.";
"breathing.ex.physiological_sigh.title" = "Physiological Sigh";
"breathing.ex.physiological_sigh.benefit" = "Two inhales through the nose, one long exhale: the fastest way to calm down.";
"breathing.ex.physiological_sigh.when" = "During a stress spike, before a meeting, after bad news. Even 1 to 3 sighs help; practise 1 to 5 minutes for a lasting effect.";
"breathing.ex.physiological_sigh.science" = "The short second inhale reopens collapsed air sacs and the long exhale offloads CO2. A 2023 Stanford study found 5 minutes a day improved mood and lowered breathing rate more than mindfulness meditation.";
"breathing.ex.sos_214.title" = "Panic SOS 2-1-4";
"breathing.ex.sos_214.benefit" = "A short, easy rhythm to regain control during anxiety or panic.";
"breathing.ex.sos_214.when" = "When your breath feels short or a wave of panic rises. Short cycles stay easy to follow when you feel overwhelmed; then move on to Long Exhale.";
"breathing.ex.sos_214.science" = "During panic, long slow cycles can feel impossible. A short inhale with an exhale twice as long limits hyperventilation and steadies CO2, easing dizziness and tingling.";
"breathing.ex.four_seven_eight.title" = "4-7-8 for Sleep";
"breathing.ex.four_seven_eight.benefit" = "The relaxing breath to fall asleep faster.";
"breathing.ex.four_seven_eight.when" = "In bed with the lights off, or when you wake up at night. Start with a few cycles and increase gradually.";
"breathing.ex.four_seven_eight.science" = "The long hold and very long exhale slow the heart rate and quiet mental chatter. Studies report lower heart rate and anxiety and easier sleep onset.";
"breathing.ex.sleep_wave.title" = "Sleep Wave 4-6-2";
"breathing.ex.sleep_wave.benefit" = "A gentle wave that slows you down until sleep comes.";
"breathing.ex.sleep_wave.when" = "In bed, for 5 to 15 minutes. Let the pause after each exhale feel heavy and soft.";
"breathing.ex.sleep_wave.science" = "Slowing down to about 5 breaths per minute with a pause at the bottom of the breath reduces arousal and eases the transition into sleep.";
"breathing.ex.slow66.title" = "Slow Breathing 6-6";
"breathing.ex.slow66.benefit" = "5 breaths a minute for deep, lasting calm.";
"breathing.ex.slow66.when" = "To unwind in the evening, after a busy day, or before meditating.";
"breathing.ex.slow66.science" = "Slow breathing at 5 to 6 breaths per minute maximises heart-rate variability and baroreflex sensitivity, two markers of stress resilience.";
"breathing.ex.box.title" = "Box Breathing 4-4-4-4";
"breathing.ex.box.benefit" = "The four-square rhythm used by elite teams to stay calm under pressure.";
"breathing.ex.box.when" = "Before an exam, a presentation, a competition or any high-pressure moment.";
"breathing.ex.box.science" = "Equal phases with short holds regulate CO2 and anchor attention on counting, lowering physiological arousal while keeping you alert.";
"breathing.ex.triangle.title" = "Triangle 4-4-4";
"breathing.ex.triangle.benefit" = "Three equal phases to clear your mind and refocus.";
"breathing.ex.triangle.when" = "When you lose focus, or before a deep-work session.";
"breathing.ex.triangle.science" = "A steady, balanced rhythm anchors attention on the breath and gently slows breathing without making you drowsy.";
"breathing.ex.alternate_nostril.title" = "Alternate Nostril";
"breathing.ex.alternate_nostril.benefit" = "Breathe through one nostril at a time to rebalance and refocus.";
"breathing.ex.alternate_nostril.when" = "Before work that needs concentration, or to settle agitation. Close one nostril with your thumb, the other with your ring finger, and follow the guide.";
"breathing.ex.alternate_nostril.science" = "Alternate nostril breathing (Nadi Shodhana) has been linked to lower heart rate and blood pressure and better attention in several controlled studies.";
"breathing.ex.energize.title" = "Energizing 4-2";
"breathing.ex.energize.benefit" = "Long inhale, quick exhale: a natural boost without coffee.";
"breathing.ex.energize.when" = "In the morning, after lunch or when your energy dips. 1 to 3 minutes is enough.";
"breathing.ex.energize.science" = "Emphasising the inhale gently activates the sympathetic system and increases alertness. Stop if you feel light-headed.";
"breathing.ex.kapalabhati.title" = "Kapalabhati";
"breathing.ex.kapalabhati.benefit" = "Short, active exhales from the belly to wake up body and mind.";
"breathing.ex.kapalabhati.when" = "In the morning on an empty stomach, sitting upright. Avoid during pregnancy or with high blood pressure or heart conditions.";
"breathing.ex.kapalabhati.science" = "Rapid abdominal breathing briefly raises alertness and energy. Keep sessions short and return to calm breathing afterwards.";

