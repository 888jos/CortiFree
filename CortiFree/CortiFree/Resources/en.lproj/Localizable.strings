"exercise.anchoring.step_2.duration" = "1 min";

"exercise.anchoring.step_3.title" = "Catch 3 sounds";
"exercise.anchoring.step_3.subtitle" = "The most distant, the closest, the most discreet...";
"exercise.anchoring.step_3.duration" = "50 sec";

"exercise.anchoring.step_4.title" = "Capture 2 smells";
"exercise.anchoring.step_4.subtitle" = "Breathe deeply - neutral counts too!";
"exercise.anchoring.step_4.duration" = "40 sec";

"exercise.anchoring.step_5.title" = "Find 1 taste";
"exercise.anchoring.step_5.subtitle" = "In your mouth or on your lips - there's always something";
"exercise.anchoring.step_5.duration" = "30 sec";

"exercise.anchoring.step_6.title" = "Mission accomplished ✓";
"exercise.anchoring.step_6.subtitle" = "You're right here, right now, well grounded";
"exercise.anchoring.step_6.duration" = "20 sec";

// MARK: - Exercise Instructions - 2-Minute Meditation
"exercise.meditation_2min.step_1.title" = "Sit (really) comfortably";
"exercise.meditation_2min.step_1.subtitle" = "No need for lotus position, just be comfortable";
"exercise.meditation_2min.step_1.duration" = "20 sec";

"exercise.meditation_2min.step_2.title" = "Close your eyes or lower your gaze";
"exercise.meditation_2min.step_2.subtitle" = "Choose what makes you most comfortable";
"exercise.meditation_2min.step_2.duration" = "15 sec";

"exercise.meditation_2min.step_3.title" = "3 deep breaths to start";
