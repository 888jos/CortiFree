// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "Anti-stress morning routine";
"tips.card.morning_routine.short_description" = "Start your day on the right foot";
"tips.card.morning_routine.section1.title" = "Why it's important";
"tips.card.morning_routine.section1.content" = "The first 60 minutes of your day determine your cortisol level for the entire day.";
"tips.card.morning_routine.section2.title" = "The ideal routine (60 min)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: Wake up and hydration\n• Drink 500ml of water upon waking\n• Rehydrate your body after 8h of sleep\n• Activate your metabolism\n\n6:15-6:30: Light exposure\n• Go outside or near a window\n• 15-30 min of natural light\n• Stops melatonin, activates healthy morning cortisol\n\n6:30-6:45: Gentle movement\n• Stretching, gentle yoga, or walking\n• Gently wake up the body\n• Release endorphins\n\n6:45-7:00: Mindfulness practice\n• 5-10 min of meditation or breathing\n• Heart coherence\n• Set your intention for the day";
"tips.card.morning_routine.section3.title" = "TO AVOID the first 60 minutes";
"tips.card.morning_routine.section3.content" = "• Phone/emails/social media\n• News (often negative)\n• Stressful situations\n• Caffeine before hydration";
"tips.card.morning_routine.section4.title" = "Why it works";
"tips.card.morning_routine.section4.content" = "This routine synchronizes your circadian rhythm, optimizes your morning cortisol peak (beneficial) and puts you in a positive mental state for the day.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "Optimal bedtime ritual";
"tips.card.sleep_ritual.short_description" = "Prepare your body and mind for rest";
"tips.card.sleep_ritual.section1.title" = "The perfect ritual";
"tips.card.sleep_ritual.section1.content" = "Good sleep starts 90 minutes before going to bed.\n\n9:30 PM: Light dimming\n• Dim the lights in the house\n• Activate night mode on phone/computer\n• Warm lights only\n\n9:45 PM: Screen shutdown\n• No more phone, TV, computer\n• Read a paper book instead\n• Blue light blocks melatonin\n\n10:00 PM: Hygiene and routine\n• Warm shower (not hot)\n• Face/teeth care routine\n• Prepare tomorrow's clothes\n\n10:15 PM: Relaxing activity\n• Light reading (no thrillers!)\n• Journaling/gratitudes\n• Meditation or gentle breathing\n• Light stretching\n\n10:30 PM: Room preparation\n• Cool temperature (64-66°F / 18-19°C)\n• Total darkness (blackout curtains)\n• Silence (earplugs if needed)\n\n10:45-11:00 PM: Bedtime\n• Always at the same time\n• Even on weekends\n• Consistency = better sleep";
"tips.card.sleep_ritual.section2.title" = "Additional tips";
"tips.card.sleep_ritual.section2.content" = "• No intense exercise after 8 PM\n• Last meal 2-3h before bedtime\n• Avoid alcohol and caffeine after 4 PM\n• Bedroom reserved for sleep (no work)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "Managing stress at work";
"tips.card.work_stress.short_description" = "Strategies to stay zen at the office";
"tips.card.work_stress.section1.title" = "Micro-breaks every hour";
"tips.card.work_stress.section1.content" = "• 2 min of deep breathing\n• Office stretches\n• Look far away (relaxes eyes)\n• Walk a few steps";
"tips.card.work_stress.section2.title" = "Smart prioritization";
"tips.card.work_stress.section2.content" = "Eisenhower Matrix:\n• Urgent + Important = Do now\n• Important + Not urgent = Schedule\n• Urgent + Not important = Delegate\n• Not urgent + Not important = Eliminate\n\n1-3-5 Method:\n• 1 main task per day\n• 3 medium tasks\n• 5 small tasks";
"tips.card.work_stress.section3.title" = "Managing interruptions";
"tips.card.work_stress.section3.content" = "• Focus mode: 90 min without interruption\n• Disable non-urgent notifications\n• \"Open door\" slots for colleagues\n• Email: check 3 times/day maximum";
"tips.card.work_stress.section4.title" = "Saying no diplomatically";
"tips.card.work_stress.section4.content" = "\"I'd like to help, but I've already committed to [X]. I can suggest [alternative] or be available from [date].\"\n\nYour time is precious. Protect it.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "Daily anti-stress nutrition";
"tips.card.nutrition.short_description" = "Meals and snacks that calm";
"tips.card.nutrition.section1.title" = "Ideal breakfast";
"tips.card.nutrition.section1.content" = "Protein + Healthy fats + Fiber:\n\nOption 1: Eggs + Avocado + Whole grain bread\nOption 2: Greek yogurt + Nuts + Berries\nOption 3: Smoothie (banana, spinach, almond butter, plant milk)\n\nWhy: Stabilizes blood sugar and cortisol all morning.";
"tips.card.nutrition.section2.title" = "Anti-stress snacks";
"tips.card.nutrition.section2.content" = "When hunger strikes (10 AM or 4 PM):\n\n• Almonds (15-20) + 1 square dark chocolate\n• Apple + Almond butter\n• Plain yogurt + Blueberries\n• Hummus + Veggie sticks\n• Banana + A few nuts\n\nAvoid: Processed bars, pastries, sodas";
"tips.card.nutrition.section3.title" = "Smart hydration";
"tips.card.nutrition.section3.content" = "• 2L of water/day minimum\n• Calming infusions (chamomile, verbena, linden)\n• Green tea (L-theanine anti-stress)\n• Lemon water in the morning\n\nLimit:\n• Coffee: max 2-3 per day, not after 2 PM\n• Alcohol: max 1 drink/day\n• Sodas: occasionally only";
"tips.card.nutrition.section4.title" = "Light dinner";
"tips.card.nutrition.section4.content" = "2-3h before bedtime:\n\n• Vegetables + Lean proteins (fish, chicken, tofu)\n• Complex carbs in small quantities (rice, quinoa)\n• Avoid fried foods, heavy dishes, strong spices\n• Digestive tea after meal";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "Managing difficult emotions";
"tips.card.emotions.short_description" = "Emergency emotional techniques";
"tips.card.emotions.section1.title" = "4-7-8 technique (anxiety emergency)";
"tips.card.emotions.section1.content" = "1. Exhale completely through mouth (whoosh)\n2. Inhale through nose counting to 4\n3. Hold your breath counting to 7\n4. Exhale through mouth counting to 8\n\nRepeat 4 cycles.\nEffect: Activates parasympathetic system, calms in 90 seconds.";
"tips.card.emotions.section2.title" = "5-4-3-2-1 technique (present anchoring)";
"tips.card.emotions.section2.content" = "When feeling overwhelmed, name out loud:\n\n• 5 things you SEE around you\n• 4 things you TOUCH\n• 3 things you HEAR\n• 2 things you SMELL\n• 1 thing you TASTE\n\nBrings your mind to the present moment and stops the anxious spiral.";
"tips.card.emotions.section3.title" = "Emotional journaling";
"tips.card.emotions.section3.content" = "When a strong emotion arrives, write:\n\n1. What is this emotion? (exact name)\n2. Where do you feel it in your body?\n3. What thought triggered it?\n4. Is this thought a fact or an interpretation?\n5. What would be a more realistic alternative thought?\n\nWriting = Processing the emotion instead of ruminating.";
"tips.card.emotions.section4.title" = "Liberating movement";
"tips.card.emotions.section4.content" = "Emotion = energy stuck in the body.\n\n• Brisk walk 10-15 min\n• Shake your arms/legs vigorously\n• Dance to energetic music\n• Deep stretching\n• Scream into a pillow (if needed)\n\nThe body MUST release stress physically.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "Daily mindfulness";
"tips.card.mindfulness.short_description" = "Integrate mindfulness everywhere";
"tips.card.mindfulness.section1.title" = "Coffee/tea mindfulness";
"tips.card.mindfulness.section1.content" = "Instead of drinking mindlessly:\n\n1. Observe the liquid's color\n2. Deeply smell the aroma\n3. Feel the warmth of the cup in your hands\n4. Take a small sip, let it sit in your mouth\n5. Notice the taste, texture, temperature\n6. Feel the warmth going down\n\n5 minutes of pure presence.";
"tips.card.mindfulness.section2.title" = "Mindful walking";
"tips.card.mindfulness.section2.content" = "Transform any walk into meditation:\n\n• Feel the contact of your foot with the ground at each step\n• Notice the movement of your arms\n• Observe what you see without judgment\n• Listen to the sounds around you\n• Feel the air on your skin, the wind in your hair\n\n5-10 min is enough to reset your mind.";
"tips.card.mindfulness.section3.title" = "Mindful shower";
"tips.card.mindfulness.section3.content" = "• Feel the water temperature\n• Notice the drops flowing on your skin\n• Focus on body sensations\n• Observe the water sound\n• Smell the soap/shampoo\n\nEvery daily activity = meditation opportunity.";
"tips.card.mindfulness.section4.title" = "Mindful eating";
"tips.card.mindfulness.section4.content" = "1 meal/day minimum without distraction:\n\n• No phone, TV, computer\n• Observe your plate (colors, textures)\n• Smell the aromas\n• Chew slowly (20-30 times per bite)\n• Notice flavors, textures\n• Put down your fork between bites\n\nBetter digestion + Natural satiety + Moment of calm";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "Nonviolent communication";
"tips.card.nvc.short_description" = "Express your needs without conflict";
"tips.card.nvc.section1.title" = "The 4 steps of NVC";
"tips.card.nvc.section1.content" = "1. OBSERVATION (objective fact)\n\"When you arrive late to appointments...\"\n(NOT \"You're always late\" = judgment)\n\n2. FEELING (your emotion)\n\"...I feel stressed and frustrated...\"\n(NOT \"You stress me out\" = accusation)\n\n3. NEED (what you need)\n\"...because I need to be able to count on our commitments...\"\n\n4. REQUEST (concrete action)\n\"...could you send me a message if you're running late?\"\n(NOT \"You need to be on time\" = order)";
"tips.card.nvc.section2.title" = "Active listening";
"tips.card.nvc.section2.content" = "When someone talks to you:\n\n• Stop what you're doing\n• Look the person in the eyes\n• Don't prepare your response while they speak\n• Rephrase to verify your understanding\n• Validate the emotion before giving advice\n\n\"If I understand correctly, you feel [emotion] because [situation]?\"";
"tips.card.nvc.section3.title" = "Handling criticism";
"tips.card.nvc.section3.content" = "• Breathe deeply before responding\n• Look for the truth in it (even small)\n• Thank them for the feedback\n• Ask for clarification if needed\n• Take a step back before deciding on action\n\n\"Thank you for telling me. Can you give me a concrete example?\"\n\nNot taking personally ≠ Allowing mistreatment";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "Cultivating positive relationships";
"tips.card.positive_relations.short_description" = "Strengthen your social bonds";
"tips.card.positive_relations.section1.title" = "Connection rituals";
"tips.card.positive_relations.section1.content" = "• 1 video call/week with a loved one\n• 1 coffee/meal face-to-face per week\n• Check-in message to 2-3 friends/week\n• Monthly group activity (sport, hobby)\n\nQuality > quantity, but consistency matters.";
"tips.card.positive_relations.section2.title" = "Expressing gratitude";
"tips.card.positive_relations.section2.content" = "At least once/day, tell someone:\n\n\"I really appreciate that you [concrete action]. It made me feel [positive emotion].\"\n\nExamples:\n• \"Thank you for listening to my concerns yesterday. I felt understood.\"\n• \"I appreciate that you thought of me. It made me smile.\"\n\nStrengthens bonds + Releases oxytocin (happiness hormone)";
"tips.card.positive_relations.section3.title" = "Identifying toxic relationships";
"tips.card.positive_relations.section3.content" = "Warning signs:\n\n• You feel drained after interactions\n• Constant criticism, never support\n• Emotional vampirism (always them, never you)\n• Manipulation or guilt-tripping\n• No respect for your boundaries\n\nAction: Progressive distancing or frank conversation.\nYou have the right to protect your energy.";
"tips.card.positive_relations.section4.title" = "Asking for support";
"tips.card.positive_relations.section4.content" = "Asking for help ≠ weakness:\n\n\"I need help with [situation]. Would you have [time/skill] to help me?\"\n\nOr simply:\n\"I'm going through a difficult time. Can we get coffee to talk about it?\"\n\nPeople want to help, but don't always know how. Be specific.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "Stress-free productivity";
"tips.card.productivity.short_description" = "Efficient AND zen";
"tips.card.productivity.section1.title" = "Adapted Pomodoro technique";
"tips.card.productivity.section1.content" = "Work in sessions:\n\n• 25 min total focus on ONE task\n• 5 min break (walk, stretch, breathe)\n• Repeat 4 times\n• Long break of 20-30 min\n\nRules:\n• Visible timer\n• Phone in airplane mode\n• Notifications disabled\n• If interrupted = reset the Pomodoro\n\nResult: 4h of real work is better than 8h of distraction.";
"tips.card.productivity.section2.title" = "Working with your brain";
"tips.card.productivity.section2.content" = "Each brain has its energy peaks:\n\nMorning people (early risers):\n• 8 AM-12 PM: Complex/creative tasks\n• 2-4 PM: Routine tasks\n• After 4 PM: Organization/emails\n\nEvening people (late sleepers):\n• Morning: Routine/emails\n• 2-6 PM: Complex tasks\n• Evening: Creativity/projects\n\nIdentify YOUR rhythm and adapt your schedule.";
"tips.card.productivity.section3.title" = "'Done' list in addition to 'To-Do'";
"tips.card.productivity.section3.content" = "At end of day, write what you DID:\n\n• Validates your accomplishments\n• Fights impostor syndrome\n• Shows progress made\n• Boosts self-confidence\n\nYour brain remembers the negative (negativity bias).\nForce it to see the positive.";
"tips.card.productivity.section4.title" = "The art of 'almost perfect'";
"tips.card.productivity.section4.content" = "Perfectionism = Major source of stress.\n\n80/20 Rule (Pareto):\n• 80% of result comes from 20% of effort\n• The remaining 20% of result requires 80% additional effort\n\nQuestion: \"Is this last 20% really worth my time and stress?\"\n\nOften, \"good enough\" IS perfect.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "Optimize your environment";
"tips.card.environment.short_description" = "Anti-stress living space";
"tips.card.environment.section1.title" = "Decluttering (adapted KonMari rule)";
"tips.card.environment.section1.content" = "1 zone/week:\n\nTake each object and ask yourself:\n• Have I used it in the last 6 months?\n• Does it bring me joy?\n• Is it really useful?\n\nIf 3x no → Donate, recycle, or trash.\n\nVisual clutter = Mental overload.\nClear space = Clear mind.";
"tips.card.environment.section2.title" = "Indoor plants";
"tips.card.environment.section2.content" = "Top 5 easy-care anti-stress:\n\n1. Pothos (air + stress)\n2. Snake plant (oxygenates at night)\n3. Aloe Vera (purifies air)\n4. Spider plant (easy, effective)\n5. Lavender (calming scent)\n\nProven benefits:\n• -15% cortisol\n• Better air quality\n• Soothing visual effect";
"tips.card.environment.section3.title" = "Maximum natural light";
"tips.card.environment.section3.content" = "• Open curtains upon waking\n• Desk near window if possible\n• Daylight bulbs (5000-6500K) in morning\n• Warm bulbs (2700-3000K) in evening\n• Light dimmers in bedrooms\n\nLight = #1 regulator of circadian rhythm.";
"tips.card.environment.section4.title" = "Sounds and music";
"tips.card.environment.section4.content" = "Work/Concentration:\n• White/brown noise\n• Baroque classical music (60 bpm)\n• Nature sounds (rain, forest)\n• No lyrics\n\nRelaxation:\n• 432Hz frequencies\n• Tibetan bowls\n• Meditative music\n• Binaural sounds (theta/delta)\n\nCreate a playlist per activity.";
"tips.card.environment.section5.title" = "Temperature and air";
"tips.card.environment.section5.content" = "Optimal temperature:\n• Active day: 68-72°F (20-22°C)\n• Sleep: 64-66°F (18-19°C)\n• Too hot = fatigue, irritability\n\nAir:\n• Ventilate 10-15 min morning and evening\n• Humidifier in winter (40-60% humidity)\n• Avoid toxic incense/scented candles\n\nYour body regulates stress better in an optimal environment.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "Anti-stress emergency kit";
"tips.card.emergency_kit.short_description" = "When you feel like breaking down";
"tips.card.emergency_kit.section1.title" = "Imminent panic attack";
"tips.card.emergency_kit.section1.content" = "NOW (in order):\n\n1. 4-7-8 breathing (described above)\n2. Ice water on face or cold shower\n3. 5-4-3-2-1 technique (sensory anchoring)\n4. Go outside if possible\n5. Call someone you trust\n\nReminder: Panic attack = unpleasant but NOT dangerous.\nIt passes in 10-20 min maximum.";
"tips.card.emergency_kit.section2.title" = "Urgent physical release";
"tips.card.emergency_kit.section2.content" = "When stress is IN your body:\n\n• Sprint 30 seconds at full speed (if safe place)\n• 20 jumping jacks\n• Squeeze a pillow/cushion hard then release (5x)\n• Push against a wall with all your strength (10 sec)\n\nStress energy MUST leave the body.";
"tips.card.emergency_kit.section3.title" = "Who to call";
"tips.card.emergency_kit.section3.content" = "Prepare this list NOW (in your phone):\n\n• 3 trusted friends/family\n• Listening line (Crisis Text Line: text HOME to 741741)\n• Your therapist if you have one\n• Emergency if immediate danger: 911\n\nIn crisis, you don't think clearly.\nPrepared list = lifeline.";
"tips.card.emergency_kit.section4.title" = "Permission to take a break";
"tips.card.emergency_kit.section4.content" = "You have the RIGHT to:\n\n• Cancel plans\n• Say \"I can't today\"\n• Take a mental rest day\n• Delegate what can be delegated\n• Put your phone in airplane mode\n\nTaking care of yourself ≠ Selfishness.\nIt's SURVIVAL.\n\nIf you're not well, you can't help anyone.";
"tips.card.emergency_kit.section5.title" = "After the crisis";
"tips.card.emergency_kit.section5.content" = "Once calm:\n\n1. Drink water\n2. Eat something light\n3. Note what triggered it (to identify patterns)\n4. Practice self-compassion (no judgment)\n5. Plan professional help if recurring\n\nNeeding help ≠ Weakness.\nIt's courage.";


