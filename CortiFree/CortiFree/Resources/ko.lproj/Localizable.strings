"learning.card.neuroplasticity.section1.content" = "신경가소성은 평생에 걸쳐 뇌가 스스로 회로를 바꾸고 새로운 신경 연결을 만드는 능력이에요.\n\n• 뇌는 고정되어 있지 않고 끊임없이 변해요\n• 새로운 습관마다 새로운 신경 회로가 생겨요\n• 오래된 습관은 ‘잊어버릴’ 수 있어요\n• 연습할수록 연결이 더 강해져요";
"learning.card.neuroplasticity.section2.title" = "과학적 증거";
"learning.card.neuroplasticity.section2.content" = "• MRI 검사에서 명상 8주 후 구조적 변화가 확인됐어요\n• 스트레스와 관련된 뇌 영역(편도체)의 부피가 줄어들 수 있어요\n• 집중력과 관련된 영역(전전두엽 피질)이 두꺼워질 수 있어요\n• 자주 쓰는 영역의 회백질이 늘어나요";
"learning.card.neuroplasticity.section3.title" = "걸리는 시간";
"learning.card.neuroplasticity.section3.content" = "• 첫 변화: 2~4주\n• 측정 가능한 변화: 6~8주\n• 지속적인 변화: 2~3개월";
"learning.card.neuroplasticity.section4.title" = "중요한 메시지";
"learning.card.neuroplasticity.section4.content" = "스트레스 속에 계속 머물러야 하는 건 아니에요. CortiFree와 함께 스트레스를 더 잘 다루도록 말 그대로 뇌를 다시 프로그래밍하고 있어요!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "수면 주기";
"learning.card.sleep_cycles.description" = "휴식을 이해하고 최적화하기";
"learning.card.sleep_cycles.section1.title" = "수면의 4단계";
"learning.card.sleep_cycles.section1.content" = "수면은 90분 주기가 하룻밤에 4~6번 반복돼요.\n\n1️⃣ 얕은 수면(5~10분): 깨어 있음과 잠 사이의 전환, 근육이 이완되고 쉽게 깨요\n\n2️⃣ 가벼운 깊은 수면(20분): 심박수가 느려지고 체온이 내려가며, 전체 수면 시간의 50%를 차지해요\n\n3️⃣ 깊은 수면(20~40분): 회복력이 가장 큰 단계, 신체 재생, 코르티솔이 가장 많이 줄어들어요\n\n4️⃣ 렘수면/역설수면(10~60분): 생생한 꿈, 감정 정리, 스트레스 처리";
"learning.card.sleep_cycles.section2.title" = "수면 주기 최적화하기";
"learning.card.sleep_cycles.section2.content" = "• 7.5시간 또는 9시간을 목표로 하세요(5~6번의 완전한 주기)\n• 6시간이나 8시간은 피하세요(주기 중간에 깨면 피곤해요)\n• 매일 같은 시간에 자고 일어나세요(주말에도)";
"learning.card.sleep_cycles.section3.title" = "코르티솔에 미치는 영향";
"learning.card.sleep_cycles.section3.content" = "• 깊은 잠은 몸이 스트레스에서 회복하도록 도와줘요\n• 잠이 부족하면 다음 날 더 스트레스를 받을 수 있어요\n• 짧은 밤이 반복되면 전반적인 건강에 영향을 줘요: 수면 문제가 계속되면 의사와 상담하세요";
"learning.card.sleep_cycles.section4.title" = "질 > 양";
"learning.card.sleep_cycles.section4.content" = "얕고 자주 깨는 8시간보다 깊은 수면이 충분한 6시간이 더 나아요!";

// MARK: - Learning Card 6: Stress and body
"learning.card.stress_body.title" = "스트레스가 몸에 미치는 영향";
"learning.card.stress_body.description" = "만성 스트레스의 신체적 영향";
"learning.card.stress_body.section1.title" = "뇌";
"learning.card.stress_body.section1.content" = "• 집중력 저하\n• 기억력 문제\n• 불안과 우울";
"learning.card.stress_body.section2.title" = "심장";
"learning.card.stress_body.section2.content" = "• 혈압 상승\n• 심혈관 질환 위험 증가\n• 두근거림";
"learning.card.stress_body.section3.title" = "근육";
"learning.card.stress_body.section3.content" = "• 긴장과 통증\n• 두통\n• 만성 피로";
"learning.card.stress_body.section4.title" = "에너지";
"learning.card.stress_body.section4.content" = "• 탈진\n• 수면 장애\n• 의욕 저하\n\n그래서 매일 스트레스를 관리하는 것이 중요해요.";

// MARK: - Learning Card 7: Anti-stress food
"learning.card.food.title" = "스트레스를 줄이는 식단";
"learning.card.food.description" = "코르티솔을 조절하는 음식";
"learning.card.food.section1.title" = "코르티솔을 낮추는 음식";
"learning.card.food.section1.content" = "건강한 지방:\n• 아보카도, 견과류, 아몬드\n• 올리브유, 등푸른 생선(연어, 고등어)\n• 항염 작용을 하는 오메가-3가 풍부해요\n\n마그네슘이 풍부한 음식:\n• 다크 초콜릿(카카오 70% 이상)\n• 시금치, 바나나\n• 호박씨, 아몬드\n• 마그네슘은 신경계의 균형에 관여해요\n\n비타민 C:\n• 감귤류, 키위, 파프리카\n• 몸이 스트레스에 대처하는 데 도움이 될 수 있어요\n• 면역력을 강화해요\n\n녹차와 홍차:\n• 마음을 진정시키는 L-테아닌\n• 커피보다 부드러운 대안이에요";
"learning.card.food.section2.title" = "코르티솔을 높이는 음식";
"learning.card.food.section2.content" = "과도한 카페인:\n• 하루 400mg 이상(커피 4잔)\n• 스트레스 반응을 키울 수 있어요\n• 수면을 방해해요\n\n정제 설탕:\n• 혈당이 급등했다가 급락해요\n• 기분과 에너지에 영향을 줄 수 있어요\n• 당 충동이 생겨요\n\n알코올:\n• 깊은 잠을 방해해요\n• 다음 날 더 긴장될 수 있어요\n• 탈수가 와요";
"learning.card.food.section3.title" = "타이밍이 중요해요";
"learning.card.food.section3.content" = "• 단백질이 풍부한 아침 식사(코르티솔 안정화)\n• 저녁에는 당과 카페인을 피하세요\n• 잠들기 2~3시간 전에 가볍게 저녁 식사하기";

// MARK: - Learning Card 8: Conscious breathing
"learning.card.breathing.title" = "의식적인 호흡의 효과";
"learning.card.breathing.description" = "의식적인 호흡이 효과적인 이유";
"learning.card.breathing.section1.title" = "즉각적인 효과";
"learning.card.breathing.section1.content" = "의식적인 호흡은 스트레스를 조절하는 가장 강력한 도구 중 하나예요.\n\n• 부교감 신경계를 활성화해요(이완)\n• 심박수를 낮춰요\n• 혈압을 낮춰요";
"learning.card.breathing.section2.title" = "장기적인 효과";
"learning.card.breathing.section2.content" = "• 스트레스 관리 능력 향상\n• 폐활량 증가\n• 정신이 맑아져요";
"learning.card.breathing.section3.title" = "알고 계셨나요?";
"learning.card.breathing.section3.content" = "깊은 호흡만으로도 단 2~3분 만에 코르티솔 수치를 낮출 수 있어요!\n\n그래서 호흡 운동이 CortiFree 프로그램의 핵심이에요.";

// MARK: - Learning Card 9: Power of nature
"learning.card.nature.title" = "자연의 힘";
"learning.card.nature.description" = "자연이 마음을 진정시키는 이유";
"learning.card.nature.section1.title" = "과학 연구";
"learning.card.nature.section1.content" = "자연과의 접촉은 더 낮은 스트레스와 연관돼요:\n\n• 자연 속에서 20분을 보내면 더 차분해진다고 느끼는 분이 많아요\n• 혈압을 낮추는 데 도움이 될 수 있어요\n• 기분이 좋아져요";
"learning.card.nature.section2.title" = "산림욕(신린요쿠)";
"learning.card.nature.section2.content" = "• 일본의 오래된 전통\n• 숲속을 천천히 걷기\n• 오감으로 교감하기";
"learning.card.nature.section3.title" = "효과";
"learning.card.nature.section3.content" = "• 면역력 강화\n• 불안 감소\n• 창의력 향상";
"learning.card.nature.section4.title" = "도시에서도";
"learning.card.nature.section4.content" = "공원, 정원, 실내 식물만으로도 긍정적인 효과가 있어요!";

// MARK: - Learning Card 10: Cardiac coherence
"learning.card.cardiac_coherence.title" = "심장 일관성 호흡";
"learning.card.cardiac_coherence.description" = "심장과 뇌를 동기화하기";
"learning.card.cardiac_coherence.section1.title" = "작동 원리";
"learning.card.cardiac_coherence.section1.content" = "심장 일관성은 심박수를 뇌와 동기화해 강력한 스트레스 완화 효과를 내는 호흡 기법이에요.\n\n• 호흡: 1분에 6회(5초 들이쉬고, 5초 내쉬기)\n• 시간: 5분\n• 빈도: 하루 3번(아침, 점심, 저녁)\n• 이것이 365 방법이에요: 하루 3번, 1분에 6회 호흡, 5분";
"learning.card.cardiac_coherence.section2.title" = "즉각적인 효과";
"learning.card.cardiac_coherence.section2.content" = "• 3~5분 만에 코르티솔 감소\n• 심박수 감소\n• 혈압 저하\n• 차분함과 맑은 정신";
"learning.card.cardiac_coherence.section3.title" = "장기적인 효과(2주 후)";
"learning.card.cardiac_coherence.section3.content" = "• 스트레스 수준을 낮추는 데 도움이 될 수 있어요\n• 감정 조절이 더 좋아져요\n• 수면의 질을 높일 수 있어요\n• 연구에서 더 건강한 심박 변이도가 나타났어요";
"learning.card.cardiac_coherence.section4.title" = "이런 사람들이 활용해요";
"learning.card.cardiac_coherence.section4.content" = "• 전투기 조종사\n• 엘리트 운동선수\n• 의사와 의료진\n• 기업 임원";
"learning.card.cardiac_coherence.section5.title" = "CortiFree에서";
"learning.card.cardiac_coherence.section5.content" = "호흡 섹션의 ‘5-5 심장 일관성 호흡’ 운동은 바로 이 과학적 방법을 따르고 있어요.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "요가와 마음의 유연성";
"learning.card.yoga.description" = "단순한 유연성 그 이상";
"learning.card.yoga.section1.title" = "스트레스 완화 요가의 종류";
"learning.card.yoga.section1.content" = "요가는 단순한 신체 운동 그 이상이에요. 몸과 마음 모두에 작용하는 강력한 스트레스 조절 도구예요.\n\n• 하타 요가: 부드러워서 초보자에게 딱 좋아요\n• 인 요가: 자세를 오래 유지하며 매우 편안해요\n• 요가 니드라: 누워서 하는 가이드 명상\n• 빈야사: 역동적이지만 명상적이에요";
"learning.card.yoga.section2.title" = "코르티솔에 미치는 영향";
"learning.card.yoga.section2.content" = "• 한 번만 해도 더 차분해진다고 느끼는 분이 많아요\n• 꾸준히 수련할수록 효과가 쌓여요\n• 연구에서 꾸준한 요가는 더 낮은 스트레스와 연관되었어요";
"learning.card.yoga.section3.title" = "과학적으로 입증된 효과";
"learning.card.yoga.section3.content" = "신체적:\n• 유연성과 근력\n• 더 나은 자세\n• 만성 통증을 덜어줄 수 있어요\n• 균형 감각 향상\n\n정신적:\n• 불안 증상을 줄일 수 있어요\n• 감정 조절 향상\n• 집중력 향상\n\n생리적:\n• 부교감신경계 활성화(이완)\n• 더 나은 심박 변이도\n• 소화를 도울 수 있어요";
"learning.card.yoga.section4.title" = "뇌에서 일어나는 일";
"learning.card.yoga.section4.content" = "• GABA(진정 작용 신경전달물질) 증가\n• 편도체 활동 감소(두려움/스트레스)\n• 전전두엽 피질 활성화(감정 조절)";
"learning.card.yoga.section5.title" = "유연하지 않아도 괜찮아요";
"learning.card.yoga.section5.content" = "요가는 경쟁이 아니에요. 몸은 모두 다르고, 동작을 조절하더라도 첫 세션부터 스트레스 완화 효과를 느낄 수 있어요!";

// MARK: - Learning Card 12: Sleep and cortisol
"learning.card.sleep_cortisol.title" = "수면과 코르티솔";
"learning.card.sleep_cortisol.description" = "건강한 일주기 리듬의 중요성";
"learning.card.sleep_cortisol.section1.title" = "자연스러운 리듬";
"learning.card.sleep_cortisol.section1.content" = "수면과 코르티솔 수치는 밀접하게 연결되어 있어요.\n\n• 아침에는 코르티솔이 높아요(잠을 깨우기 위해)\n• 저녁에는 코르티솔이 낮아요(잠들기 위해)";
"learning.card.sleep_cortisol.section2.title" = "리듬이 깨지면";
"learning.card.sleep_cortisol.section2.content" = "• 수면 방해 → 24시간 내내 높은 코르티솔\n• 악순환: 스트레스 → 수면 부족 → 더 많은 스트레스";
"learning.card.sleep_cortisol.section3.title" = "CortiFree의 해결책";
"learning.card.sleep_cortisol.section3.content" = "• 오전 7시 전에 일어나기(아침 루틴)\n• 밤 11시 전에 잠자리에 들기(회복)\n• 저녁 명상(수면 준비)";
"learning.card.sleep_cortisol.section4.title" = "알고 계셨나요?";
"learning.card.sleep_cortisol.section4.content" = "하룻밤만 잠을 설쳐도 다음 날 더 예민하고 스트레스를 받을 수 있어요!";

// MARK: - Learning Card 13: Hydration
"learning.card.hydration.title" = "수분 섭취와 스트레스";
"learning.card.hydration.description" = "물을 마시면 스트레스가 줄어드는 이유";
"learning.card.hydration.section1.title" = "탈수의 영향";
"learning.card.hydration.section1.content" = "수분은 스트레스를 다루는 데 영향을 줘요. 가벼운 탈수만으로도 다음과 같은 일이 생길 수 있어요:\n\n• 더 긴장된 느낌\n• 피로와 짜증\n• 집중하기 어려움";
"learning.card.hydration.section2.title" = "충분한 수분 섭취의 효과";
"learning.card.hydration.section2.content" = "• 체온 조절\n• 노폐물 배출\n• 뇌 기능 향상";
"learning.card.hydration.section3.title" = "권장 사항";
"learning.card.hydration.section3.content" = "• 하루 최소 2L의 물\n• 활동량이 많다면 더 많이\n• 하루 동안 나눠서 마시기";
"learning.card.hydration.section4.title" = "팁";
"learning.card.hydration.section4.content" = "큰 컵 한 잔의 물로 하루를 시작해 신진대사를 깨워 보세요!";

// MARK: - Learning Card 14: Physical exercise
"learning.card.exercise.title" = "스트레스를 줄이는 운동";
"learning.card.exercise.description" = "운동이 코르티솔을 조절하는 방식";
"learning.card.exercise.section1.title" = "코르티솔에 미치는 영향";
"learning.card.exercise.section1.content" = "신체 활동은 자연스러운 스트레스 조절제예요.\n\n• 단기적으로: 약간 증가해요(정상)\n• 장기적으로: 기본 코르티솔 수치가 크게 줄어요";
"learning.card.exercise.section2.title" = "추가 혜택";
"learning.card.exercise.section2.content" = "• 엔도르핀(행복 호르몬) 분비\n• 수면 개선\n• 자존감 향상";
"learning.card.exercise.section3.title" = "이상적인 운동 시간";
"learning.card.exercise.section3.content" = "• 한 번에 20~30분\n• 주 3~5회\n• 중간 강도";
"learning.card.exercise.section4.title" = "주의";
"learning.card.exercise.section4.content" = "너무 강도 높은 운동은 코르티솔을 높일 수 있어요. 균형이 핵심이에요!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "긍정적인 인간관계";
"learning.card.social.description" = "사회적 지지의 중요성";
"learning.card.social.section1.title" = "코르티솔에 미치는 영향";
"learning.card.social.section1.content" = "양질의 사회적 관계는 스트레스 관리에 꼭 필요해요:\n\n• 긍정적인 교류는 더 차분해지도록 도와줘요\n• 옥시토신(\"사랑 호르몬\") 분비\n• 안정감과 소속감";
"learning.card.social.section2.title" = "도움이 되는 관계의 유형";
"learning.card.social.section2.content" = "• 친구와의 깊은 대화\n• 가족과 보내는 소중한 시간\n• 그룹 활동(운동, 취미)";
"learning.card.social.section3.title" = "피해야 할 것";
"learning.card.social.section3.content" = "• 오랜 고립\n• 해롭거나 갈등이 많은 관계";
"learning.card.social.section4.title" = "알고 계셨나요?";
"learning.card.social.section4.content" = "20초간의 간단한 포옹만으로도 스트레스 수준을 크게 낮출 수 있어요!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "자연광 쬐기";
"learning.card.light.description" = "생체 시계를 조절해요";
"learning.card.light.section1.title" = "아침의 중요성";
"learning.card.light.section1.content" = "자연광은 코르티솔과 일주기 리듬을 조절하는 데 중요한 역할을 해요.\n\n• 일어난 후 30~60분 안에 햇빛을 쬐세요\n• 야외에서 최소 10~30분(흐린 날에도)\n• 아침 코르티솔 분비를 활성화해요(정상적이고 이로워요)\n• 멜라토닌(수면 호르몬) 분비를 멈춰요";
"learning.card.light.section2.title" = "생체 시계에 미치는 영향";
"learning.card.light.section2.content" = "• 코르티솔/멜라토닌 주기를 조절해요\n• 밤 수면의 질을 높여요\n• 낮 동안의 에너지와 각성도를 높여요\n• 모든 생체 리듬을 동기화해요";
"learning.card.light.section3.title" = "과학 연구";
"learning.card.light.section3.content" = "• 아침 햇빛으로 낮 동안 더 많은 에너지\n• 저녁에 더 쉽게 잠들기\n• 기분을 끌어올리는 데 도움이 될 수 있어요\n• 식욕 조절 향상";
"learning.card.light.section4.title" = "저녁에는 피하세요";
"learning.card.light.section4.content" = "• 잠들기 1~2시간 전 화면\n• 밝은 조명(따뜻하거나 은은한 조명이 좋아요)\n• 멜라토닌을 차단하는 블루라이트";
"learning.card.light.section5.title" = "CortiFree 팁";
"learning.card.light.section5.content" = "아침 산책과 자연광 쬐기를 함께 하면 에너지와 스트레스에 효과가 배가돼요!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "자동적 부정 사고";
"learning.card.negative_thoughts.description" = "해로운 사고 패턴을 알아차리고 바꾸기";
"learning.card.negative_thoughts.section1.title" = "해로운 생각의 7가지 유형";
"learning.card.negative_thoughts.section1.content" = "생각은 스트레스와 코르티솔 수치에 직접 영향을 미쳐요. 자동적인 부정적 생각을 알아차리고 바꾸는 법을 배우는 것이 중요해요.\n\n1️⃣ 파국화: “이 시험에 떨어지면 내 인생은 끝이야”\n→ 현실: 실패는 끝이 아니에요\n\n2️⃣ 흑백 논리: “완벽하지 않으면 실패야”\n→ 현실: 삶에는 다양한 색이 있어요\n\n3️⃣ 과잉 일반화: “한 번 실패했으니 난 항상 실패해”\n→ 현실: 하나의 상황 ≠ 모든 상황\n\n4️⃣ 정신적 여과: 긍정적인 것은 무시하고 부정적인 것에만 집중하기\n→ 현실: 잘되고 있는 것도 찾아보세요\n\n5️⃣ 독심술: “다들 내가 무능하다고 생각해”\n→ 현실: 남의 마음은 읽을 수 없어요\n\n6️⃣ 개인화: “분명히 내 잘못이야”\n→ 현실: 모든 일이 나에게 달린 건 아니에요\n\n7️⃣ 당위적 사고: “나는 완벽해야만 해”\n→ 현실: 완벽한 사람은 없어요";
"learning.card.negative_thoughts.section2.title" = "3칸 기법";
"learning.card.negative_thoughts.section2.content" = "1칸: 상황\n2칸: 자동적 생각\n3칸: 현실적인 대안 생각";
"learning.card.negative_thoughts.section3.title" = "측정 가능한 효과";
"learning.card.negative_thoughts.section3.content" = "• 인지 기법은 불안을 줄이는 효과가 잘 연구되어 있어요\n• 이런 생각을 알아차리고 다시 바라보면 스트레스가 줄어들 수 있어요\n• 지속적인 개선은 보통 8~12주 수련 후에 나타나요";
"learning.card.negative_thoughts.section4.title" = "일기 쓰기 팁";
"learning.card.negative_thoughts.section4.content" = "CortiFree 일기에 생각을 적으면 그 생각을 알아차리고, 의문을 품고, 바꿔 나갈 수 있어요!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "감사와 뇌";
"learning.card.gratitude.description" = "감사가 주는 과학적 효과";
"learning.card.gratitude.section1.title" = "뇌에서 일어나는 일";
"learning.card.gratitude.section1.content" = "감사 연습은 단순한 \"긍정적 사고\"가 아니에요. 관심과 스트레스 수준을 바꿀 수 있는, 잘 연구된 습관이에요.\n\n• 웰빙과 관련된 뇌 영역의 활동과 연관돼요\n• 긍정적인 감정을 키울 수 있어요\n• 스트레스를 덜 느끼는 데 도움이 될 수 있어요";
"learning.card.gratitude.section2.title" = "주요 과학 연구";
"learning.card.gratitude.section2.content" = "연구에서 시사하는 점:\n• 주 몇 회 감사 일기 쓰기\n• 시간이 지나면서 기분 개선과 연관돼요\n• 수면과 인간관계 개선\n\n일상에서는:\n• 하루 5분 감사하기\n• 더 행복해졌다고 말하는 분이 많아요\n• 그리고 불안도 덜해요";
"learning.card.gratitude.section3.title" = "효과적으로 연습하는 방법";
"learning.card.gratitude.section3.content" = "감사 3가지 방법(하루 5분):\n1. 감사한 일 3가지를 적어요\n2. 구체적으로 적어요(그냥 ‘가족’이 아니라)\n3. 적으면서 그 감정을 느껴 보세요\n4. 매일 다른 감사거리를 찾아요\n\n예시:\n너무 막연함: “건강해서 감사해요”\n구체적임: “통증 없이 아침 산책을 하며 얼굴에 닿는 상쾌한 공기를 느낄 수 있어서 감사해요”";
"learning.card.gratitude.section4.title" = "장기 효과";
"learning.card.gratitude.section4.content" = "4주 후:\n• 뇌에서 측정 가능한 변화\n• 수면의 질 향상\n• 더 많은 긍정적 감정\n\n12주 후:\n• 더 높아진 기본 행복 수준\n• 스트레스 회복력 향상\n• 더 좋아진 인간관계";
"learning.card.gratitude.section5.title" = "CortiFree에 담긴 기능";
"learning.card.gratitude.section5.content" = "일기에 매일 감사한 일을 적을 수 있어요. 2~3분의 간단한 연습이 스트레스와의 관계를 바꿀 수 있어요!";
"learning.card.gratitude.section6.title" = "중요";
"learning.card.gratitude.section6.content" = "감사는 문제를 부정하는 것이 아니에요. 부정적인 것에만 집중하지 않고 긍정적인 것도 볼 수 있도록 뇌를 훈련하는 거예요.";

