// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "스트레스를 줄이는 아침 루틴";
"tips.card.morning_routine.short_description" = "기분 좋게 하루를 시작하세요";
"tips.card.morning_routine.section1.title" = "왜 중요할까요";
"tips.card.morning_routine.section1.content" = "하루의 첫 60분이 그날 하루 종일의 코르티솔 수치를 결정해요.";
"tips.card.morning_routine.section2.title" = "이상적인 루틴(60분)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: 기상과 수분 보충\n• 일어나자마자 물 500ml 마시기\n• 8시간 수면 후 몸에 수분 채우기\n• 신진대사 깨우기\n\n6:15-6:30: 햇빛 쬐기\n• 밖으로 나가거나 창가로 가기\n• 15~30분간 자연광 쬐기\n• 멜라토닌을 멈추고 건강한 아침 코르티솔을 활성화해요\n\n6:30-6:45: 가벼운 움직임\n• 스트레칭, 부드러운 요가, 산책\n• 몸을 부드럽게 깨우기\n• 엔도르핀 분비\n\n6:45-7:00: 마음챙김 연습\n• 5~10분 명상이나 호흡\n• 심장 일관성 호흡\n• 오늘의 다짐 정하기";
"tips.card.morning_routine.section3.title" = "처음 60분 동안 피할 것";
"tips.card.morning_routine.section3.content" = "• 휴대폰/이메일/SNS\n• 뉴스(대체로 부정적이에요)\n• 스트레스를 주는 상황\n• 물보다 먼저 마시는 카페인";
"tips.card.morning_routine.section4.title" = "효과가 있는 이유";
"tips.card.morning_routine.section4.content" = "이 루틴은 일주기 리듬을 맞추고, 아침 코르티솔 최고치(이로운 것)를 최적화하며, 하루를 긍정적인 마음 상태로 시작하게 해 줘요.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "최적의 잠자리 의식";
"tips.card.sleep_ritual.short_description" = "몸과 마음을 휴식에 대비시키세요";
"tips.card.sleep_ritual.section1.title" = "완벽한 의식";
"tips.card.sleep_ritual.section1.content" = "좋은 잠은 잠자리에 들기 90분 전부터 시작돼요.\n\n오후 9:30: 조명 낮추기\n• 집 안 조명을 어둡게 하기\n• 휴대폰/컴퓨터 야간 모드 켜기\n• 따뜻한 조명만 사용하기\n\n오후 9:45: 화면 끄기\n• 휴대폰, TV, 컴퓨터 그만\n• 대신 종이책 읽기\n• 블루라이트는 멜라토닌을 막아요\n\n오후 10:00: 위생과 루틴\n• 따뜻한 샤워(뜨겁지 않게)\n• 세안/양치 루틴\n• 내일 입을 옷 준비하기\n\n오후 10:15: 편안한 활동\n• 가벼운 독서(스릴러는 금지!)\n• 일기 쓰기/감사 노트\n• 명상이나 부드러운 호흡\n• 가벼운 스트레칭\n\n오후 10:30: 침실 준비\n• 서늘한 온도(18~19°C / 64~66°F)\n• 완전한 어둠(암막 커튼)\n• 조용함(필요하면 귀마개)\n\n오후 10:45-11:00: 취침\n• 항상 같은 시간에\n• 주말에도\n• 규칙성 = 더 좋은 잠";
"tips.card.sleep_ritual.section2.title" = "추가 팁";
"tips.card.sleep_ritual.section2.content" = "• 오후 8시 이후 격한 운동 금지\n• 마지막 식사는 잠들기 2~3시간 전\n• 오후 4시 이후 알코올과 카페인 피하기\n• 침실은 잠만 자는 공간으로(일 금지)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "직장에서 스트레스 관리하기";
"tips.card.work_stress.short_description" = "사무실에서도 평온함을 지키는 전략";
"tips.card.work_stress.section1.title" = "매시간 짧은 휴식";
"tips.card.work_stress.section1.content" = "• 2분간 깊은 호흡\n• 사무실 스트레칭\n• 먼 곳 바라보기(눈의 긴장 완화)\n• 몇 걸음 걷기";
"tips.card.work_stress.section2.title" = "똑똑한 우선순위 정하기";
"tips.card.work_stress.section2.content" = "아이젠하워 매트릭스:\n• 긴급 + 중요 = 지금 하기\n• 중요 + 긴급하지 않음 = 일정 잡기\n• 긴급 + 중요하지 않음 = 위임하기\n• 긴급하지 않음 + 중요하지 않음 = 없애기\n\n1-3-5 방법:\n• 하루에 큰 일 1개\n• 중간 일 3개\n• 작은 일 5개";
"tips.card.work_stress.section3.title" = "방해 요소 관리하기";
"tips.card.work_stress.section3.content" = "• 집중 모드: 방해 없이 90분\n• 급하지 않은 알림 끄기\n• 동료를 위한 ‘열린 시간’ 정해 두기\n• 이메일: 하루 최대 3번 확인";
"tips.card.work_stress.section4.title" = "부드럽게 거절하기";
"tips.card.work_stress.section4.content" = "“돕고 싶지만 이미 [X]를 맡기로 했어요. [대안]을 제안하거나 [날짜]부터는 가능해요.”\n\n내 시간은 소중해요. 지켜 주세요.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "매일의 스트레스 완화 식단";
"tips.card.nutrition.short_description" = "마음을 진정시키는 식사와 간식";
"tips.card.nutrition.section1.title" = "이상적인 아침 식사";
"tips.card.nutrition.section1.content" = "단백질 + 건강한 지방 + 식이섬유:\n\n옵션 1: 달걀 + 아보카도 + 통곡물빵\n옵션 2: 그릭 요거트 + 견과류 + 베리류\n옵션 3: 스무디(바나나, 시금치, 아몬드 버터, 식물성 우유)\n\n이유: 오전 내내 혈당과 코르티솔을 안정시켜요.";
"tips.card.nutrition.section2.title" = "스트레스 완화 간식";
"tips.card.nutrition.section2.content" = "배고플 때(오전 10시나 오후 4시):\n\n• 아몬드(15~20알) + 다크 초콜릿 1조각\n• 사과 + 아몬드 버터\n• 플레인 요거트 + 블루베리\n• 후무스 + 채소 스틱\n• 바나나 + 견과류 약간\n\n피할 것: 가공 바, 페이스트리, 탄산음료";
"tips.card.nutrition.section3.title" = "똑똑한 수분 섭취";
"tips.card.nutrition.section3.content" = "• 하루 최소 2L의 물\n• 진정 효과가 있는 허브차(캐모마일, 버베나, 린덴)\n• 녹차(스트레스를 줄이는 L-테아닌)\n• 아침에 레몬물\n\n줄일 것:\n• 커피: 하루 최대 2~3잔, 오후 2시 이후 금지\n• 알코올: 하루 최대 1잔\n• 탄산음료: 가끔만";
"tips.card.nutrition.section4.title" = "가벼운 저녁 식사";
"tips.card.nutrition.section4.content" = "잠들기 2~3시간 전:\n\n• 채소 + 저지방 단백질(생선, 닭고기, 두부)\n• 복합 탄수화물은 조금만(쌀, 퀴노아)\n• 튀김, 무거운 요리, 자극적인 향신료 피하기\n• 식후 소화를 돕는 차";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "힘든 감정 다루기";
"tips.card.emotions.short_description" = "감정 응급 기법";
"tips.card.emotions.section1.title" = "4-7-8 호흡법(불안할 때 응급)";
"tips.card.emotions.section1.content" = "1. 입으로 숨을 완전히 내쉬어요(후~)\n2. 넷을 세며 코로 들이마셔요\n3. 일곱을 세며 숨을 참아요\n4. 여덟을 세며 입으로 내쉬어요\n\n4회 반복하세요.\n효과: 부교감 신경계를 활성화해 90초 만에 진정돼요.";
"tips.card.emotions.section2.title" = "5-4-3-2-1 기법(지금 이 순간에 머물기)";
"tips.card.emotions.section2.content" = "압도될 때 소리 내어 말해 보세요.\n\n• 주변에서 보이는 것 5가지\n• 만질 수 있는 것 4가지\n• 들리는 것 3가지\n• 냄새 맡을 수 있는 것 2가지\n• 맛볼 수 있는 것 1가지\n\n마음을 현재로 데려와 불안의 소용돌이를 멈춰 줘요.";
"tips.card.emotions.section3.title" = "감정 일기";
"tips.card.emotions.section3.content" = "강한 감정이 찾아오면 적어 보세요.\n\n1. 이 감정은 무엇인가요? (정확한 이름)\n2. 몸의 어디에서 느껴지나요?\n3. 어떤 생각이 이 감정을 일으켰나요?\n4. 그 생각은 사실인가요, 해석인가요?\n5. 더 현실적인 대안 생각은 무엇일까요?\n\n쓰기 = 곱씹는 대신 감정을 처리하는 것.";
"tips.card.emotions.section4.title" = "해방하는 움직임";
"tips.card.emotions.section4.content" = "감정 = 몸에 갇힌 에너지.\n\n• 10~15분 빠르게 걷기\n• 팔다리를 힘차게 털기\n• 신나는 음악에 맞춰 춤추기\n• 깊은 스트레칭\n• 베개에 대고 소리 지르기(필요하면)\n\n몸은 스트레스를 반드시 신체적으로 풀어내야 해요.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "일상 속 마음챙김";
"tips.card.mindfulness.short_description" = "어디서나 마음챙김 실천하기";
"tips.card.mindfulness.section1.title" = "커피/차 마음챙김";
"tips.card.mindfulness.section1.content" = "무심코 마시는 대신:\n\n1. 음료의 색을 관찰해요\n2. 향을 깊이 맡아요\n3. 손에 닿는 컵의 온기를 느껴요\n4. 한 모금 마시고 입안에 잠시 머금어요\n5. 맛, 질감, 온도를 느껴요\n6. 따뜻함이 내려가는 것을 느껴요\n\n온전히 머무는 5분.";
"tips.card.mindfulness.section2.title" = "마음챙김 걷기";
"tips.card.mindfulness.section2.content" = "어떤 산책이든 명상으로 바꿔 보세요.\n\n• 한 걸음마다 발이 땅에 닿는 느낌을 느껴요\n• 팔의 움직임을 알아차려요\n• 보이는 것을 판단 없이 관찰해요\n• 주변의 소리에 귀 기울여요\n• 피부에 닿는 공기, 머리카락을 스치는 바람을 느껴요\n\n5~10분이면 마음을 재정비하기에 충분해요.";
"tips.card.mindfulness.section3.title" = "마음챙김 샤워";
"tips.card.mindfulness.section3.content" = "• 물의 온도를 느껴요\n• 피부를 타고 흐르는 물방울을 알아차려요\n• 몸의 감각에 집중해요\n• 물소리를 관찰해요\n• 비누/샴푸 향을 맡아요\n\n모든 일상 활동 = 명상의 기회.";
"tips.card.mindfulness.section4.title" = "마음챙김 식사";
"tips.card.mindfulness.section4.content" = "하루 최소 한 끼는 방해 없이:\n\n• 휴대폰, TV, 컴퓨터 없이\n• 접시를 관찰해요(색, 질감)\n• 향을 맡아요\n• 천천히 씹어요(한 입에 20~30번)\n• 맛과 질감을 느껴요\n• 한 입 먹을 때마다 포크를 내려놓아요\n\n더 나은 소화 + 자연스러운 포만감 + 평온한 순간";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "비폭력 대화";
"tips.card.nvc.short_description" = "갈등 없이 필요를 표현하기";
"tips.card.nvc.section1.title" = "비폭력 대화의 4단계";
"tips.card.nvc.section1.content" = "1. 관찰(객관적인 사실)\n“약속에 늦게 오면...”\n(“넌 항상 늦어” = 판단)\n\n2. 느낌(나의 감정)\n“...스트레스받고 속상해...”\n(“너 때문에 스트레스받아” = 비난)\n\n3. 욕구(내게 필요한 것)\n“...우리 약속을 믿을 수 있어야 하거든...”\n\n4. 부탁(구체적인 행동)\n“...늦을 것 같으면 메시지 보내 줄 수 있어?”\n(“시간 좀 지켜” = 명령)";
"tips.card.nvc.section2.title" = "적극적 경청";
"tips.card.nvc.section2.content" = "누군가 이야기할 때:\n\n• 하던 일을 멈춰요\n• 상대의 눈을 바라봐요\n• 상대가 말하는 동안 대답을 준비하지 않아요\n• 이해한 내용을 다시 말해 확인해요\n• 조언하기 전에 감정을 인정해 줘요\n\n“내가 제대로 이해했다면, [상황] 때문에 [감정]을 느끼는 거지?”";
"tips.card.nvc.section3.title" = "비판 대처하기";
"tips.card.nvc.section3.content" = "• 대답하기 전에 깊게 숨 쉬어요\n• 그 안에 담긴 진실을 찾아봐요(작더라도)\n• 피드백에 감사를 표해요\n• 필요하면 설명을 요청해요\n• 행동을 정하기 전에 한 걸음 물러서요\n\n“말해 줘서 고마워요. 구체적인 예를 들어 줄 수 있을까요?”\n\n개인적으로 받아들이지 않기 ≠ 부당한 대우를 허용하기";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "긍정적인 관계 가꾸기";
"tips.card.positive_relations.short_description" = "사회적 유대를 강화하세요";
"tips.card.positive_relations.section1.title" = "연결을 위한 의식";
"tips.card.positive_relations.section1.content" = "• 주 1회 소중한 사람과 영상 통화\n• 주 1회 직접 만나 커피/식사\n• 주 2~3명의 친구에게 안부 메시지\n• 월 1회 그룹 활동(운동, 취미)\n\n질 > 양, 하지만 꾸준함도 중요해요.";
"tips.card.positive_relations.section2.title" = "감사 표현하기";
"tips.card.positive_relations.section2.content" = "하루에 한 번 이상 누군가에게 말해 보세요.\n\n“[구체적인 행동]해 줘서 정말 고마워. 덕분에 [긍정적인 감정]을 느꼈어.”\n\n예시:\n• “어제 내 고민을 들어 줘서 고마워. 이해받는 느낌이었어.”\n• “나를 생각해 줘서 고마워. 덕분에 웃었어.”\n\n유대 강화 + 옥시토신(행복 호르몬) 분비";
"tips.card.positive_relations.section3.title" = "해로운 관계 알아차리기";
"tips.card.positive_relations.section3.content" = "경고 신호:\n\n• 만나고 나면 기운이 빠져요\n• 늘 비판만 하고 지지는 없어요\n• 감정적 착취(항상 그 사람 얘기만, 내 얘기는 없음)\n• 조종하거나 죄책감을 줘요\n• 내 경계를 존중하지 않아요\n\n행동: 서서히 거리 두기 또는 솔직한 대화.\n내 에너지를 지킬 권리가 있어요.";
"tips.card.positive_relations.section4.title" = "도움 요청하기";
"tips.card.positive_relations.section4.content" = "도움 요청 ≠ 약함:\n\n“[상황] 때문에 도움이 필요해. [시간/능력]을 좀 빌려줄 수 있을까?”\n\n또는 간단하게:\n“요즘 좀 힘들어. 커피 한잔하면서 얘기할 수 있을까?”\n\n사람들은 돕고 싶어 하지만 방법을 모를 때가 많아요. 구체적으로 말해 보세요.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "스트레스 없는 생산성";
"tips.card.productivity.short_description" = "효율적이면서도 평온하게";
"tips.card.productivity.section1.title" = "변형 뽀모도로 기법";
"tips.card.productivity.section1.content" = "세션 단위로 일하기:\n\n• 25분간 한 가지 일에만 완전히 집중\n• 5분 휴식(걷기, 스트레칭, 호흡)\n• 4번 반복\n• 20~30분 긴 휴식\n\n규칙:\n• 타이머가 보이게 두기\n• 휴대폰은 비행기 모드\n• 알림 끄기\n• 방해받으면 = 뽀모도로 다시 시작\n\n결과: 산만한 8시간보다 진짜로 일한 4시간이 더 나아요.";
"tips.card.productivity.section2.title" = "뇌의 리듬에 맞춰 일하기";
"tips.card.productivity.section2.content" = "뇌마다 에너지가 가장 높은 시간이 있어요.\n\n아침형(일찍 일어나는 사람):\n• 오전 8시~낮 12시: 복잡하거나 창의적인 일\n• 오후 2~4시: 일상 업무\n• 오후 4시 이후: 정리/이메일\n\n저녁형(늦게 자는 사람):\n• 아침: 일상 업무/이메일\n• 오후 2~6시: 복잡한 일\n• 저녁: 창의적인 일/프로젝트\n\n나만의 리듬을 찾아 일정을 맞춰 보세요.";
"tips.card.productivity.section3.title" = "‘할 일’ 목록과 함께 ‘한 일’ 목록도";
"tips.card.productivity.section3.content" = "하루를 마칠 때 한 일을 적어 보세요.\n\n• 성취를 인정해 줘요\n• 가면 증후군을 이겨내요\n• 이룬 진전을 보여 줘요\n• 자신감을 높여요\n\n뇌는 부정적인 것을 더 잘 기억해요(부정 편향).\n긍정적인 것도 보도록 훈련하세요.";
"tips.card.productivity.section4.title" = "‘거의 완벽’의 기술";
"tips.card.productivity.section4.content" = "완벽주의 = 스트레스의 주요 원인.\n\n80/20 법칙(파레토):\n• 결과의 80%는 노력의 20%에서 나와요\n• 나머지 20%의 결과에는 80%의 추가 노력이 필요해요\n\n질문: “마지막 20%가 정말 내 시간과 스트레스를 들일 가치가 있을까?”\n\n‘이 정도면 충분해’가 곧 완벽일 때가 많아요.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "환경 최적화하기";
"tips.card.environment.short_description" = "스트레스를 줄이는 생활 공간";
"tips.card.environment.section1.title" = "정리하기(곤마리 법칙 응용)";
"tips.card.environment.section1.content" = "일주일에 한 구역씩:\n\n물건 하나하나를 들고 스스로에게 물어보세요.\n• 지난 6개월 동안 사용했나?\n• 설레는가?\n• 정말 쓸모 있나?\n\n세 번 모두 아니라면 → 기부, 재활용, 또는 버리기.\n\n눈에 보이는 어수선함 = 정신적 과부하.\n깨끗한 공간 = 맑은 마음.";
"tips.card.environment.section2.title" = "실내 식물";
"tips.card.environment.section2.content" = "관리가 쉬운 스트레스 완화 식물 TOP 5:\n\n1. 스킨답서스(공기 + 스트레스)\n2. 산세베리아(밤에 산소 배출)\n3. 알로에 베라(공기 정화)\n4. 접란(쉽고 효과적)\n5. 라벤더(진정 효과가 있는 향)\n\n장점:\n• 더 차분하게 느껴지는 공간\n• 공기 질 개선\n• 마음을 편안하게 하는 시각 효과";
"tips.card.environment.section3.title" = "자연광 최대한 들이기";
"tips.card.environment.section3.content" = "• 일어나면 커튼 열기\n• 가능하면 창가에 책상 두기\n• 아침에는 주광색 전구(5000-6500K)\n• 저녁에는 전구색 전구(2700-3000K)\n• 침실에는 조광기\n\n빛 = 일주기 리듬의 최대 조절자.";
"tips.card.environment.section4.title" = "소리와 음악";
"tips.card.environment.section4.content" = "업무/집중:\n• 화이트/브라운 노이즈\n• 바로크 클래식 음악(60bpm)\n• 자연의 소리(비, 숲)\n• 가사 없는 음악\n\n휴식:\n• 432Hz 주파수\n• 티베트 싱잉볼\n• 명상 음악\n• 바이노럴 사운드(세타/델타)\n\n활동별로 플레이리스트를 만들어 보세요.";
"tips.card.environment.section5.title" = "온도와 공기";
"tips.card.environment.section5.content" = "최적의 온도:\n• 활동하는 낮: 20~22°C (68~72°F)\n• 수면: 18~19°C (64~66°F)\n• 너무 더우면 = 피로, 짜증\n\n공기:\n• 아침저녁으로 10~15분 환기\n• 겨울에는 가습기(습도 40~60%)\n• 유해한 향/향초는 피하기\n\n최적의 환경에서 몸은 스트레스를 더 잘 조절해요.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "스트레스 응급 키트";
"tips.card.emergency_kit.short_description" = "무너질 것 같을 때";
"tips.card.emergency_kit.section1.title" = "공황 발작이 오려 할 때";
"tips.card.emergency_kit.section1.content" = "지금 바로(순서대로):\n\n1. 4-7-8 호흡(위에서 설명)\n2. 얼굴에 찬물 또는 찬물 샤워\n3. 5-4-3-2-1 기법(감각으로 현재에 머물기)\n4. 가능하면 밖으로 나가기\n5. 믿을 수 있는 사람에게 전화하기\n\n기억하세요: 공황 발작 = 불쾌하지만 위험하지는 않아요.\n길어도 10~20분이면 지나가요.";
"tips.card.emergency_kit.section2.title" = "급히 몸으로 풀어내기";
"tips.card.emergency_kit.section2.content" = "스트레스가 몸에 쌓여 있을 때:\n\n• 30초간 전력 질주(안전한 곳이라면)\n• 팔벌려뛰기 20회\n• 베개/쿠션을 세게 쥐었다가 놓기(5회)\n• 온 힘을 다해 벽 밀기(10초)\n\n스트레스 에너지는 반드시 몸 밖으로 나가야 해요.";
"tips.card.emergency_kit.section3.title" = "연락할 사람";
"tips.card.emergency_kit.section3.content" = "지금 이 목록을 준비하세요(휴대폰에):\n\n• 믿을 수 있는 친구/가족 3명\n• 상담 전화(자살예방 상담전화: 109)\n• 상담 중인 치료사가 있다면 치료사\n• 즉각적인 위험이 있다면 응급 번호: 119\n\n위기 상황에서는 생각이 명확하지 않아요.\n준비된 목록 = 생명줄.";
"tips.card.emergency_kit.section4.title" = "쉬어도 괜찮아요";
"tips.card.emergency_kit.section4.content" = "이럴 권리가 있어요:\n\n• 약속 취소하기\n• “오늘은 안 돼”라고 말하기\n• 마음 휴식의 날 갖기\n• 맡길 수 있는 일은 맡기기\n• 휴대폰을 비행기 모드로 두기\n\n나를 돌보기 ≠ 이기심.\n이건 생존이에요.\n\n내가 괜찮지 않으면 누구도 도울 수 없어요.";
"tips.card.emergency_kit.section5.title" = "위기가 지나간 후";
"tips.card.emergency_kit.section5.content" = "진정되면:\n\n1. 물 마시기\n2. 가벼운 것 먹기\n3. 무엇이 계기였는지 적기(패턴 파악용)\n4. 자기 연민 연습하기(판단하지 않기)\n5. 반복된다면 전문가의 도움 계획하기\n\n도움이 필요하다 ≠ 약하다.\n그건 용기예요.";


