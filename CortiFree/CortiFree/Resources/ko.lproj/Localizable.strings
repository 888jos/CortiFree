// MARK: - Learning Card 1: Cortisol
"learning.card.cortisol.title" = "cortisol은 무엇입니까?";
"learning.card.cortisol.description" = "스트레스 호르몬 이해";
"learning.card.cortisol.section1.title" = "제품정보";
"learning.card.cortisol.section1.content" = "Cortisol은 종종 \" 스트레스 호르몬\"이라고합니다. 그것은 아드레날린 선에 의해 생성하고 긴장에 몸의 응답에 있는 근본적인 역할을 합니다.";
"learning.card.cortisol.section2.title" = "cortisol의 긍정적인 역할";
"learning.card.cortisol.section2.content" = "â¢는 하루 동안 에너지 수준을 규제\nâ¢는 어렵고 스트레스가 많은 상황을 관리합니다.\nâ¢는 혈압과 혈액 설탕을 통제합니다\nâ¢는 몸에 염증을 감소시킵니다.\nâ¢는 지방, 단백질 및 탄수화물의 물질 대사에 참여\nâ¢는 수면 울음주기 (circadian 리듬)를 규제합니다.";
"learning.card.cortisol.section3.title" = "만성 과잉 문제";
"learning.card.cortisol.section3.content" = "â¢ 만성 불안과 수면 장애\nâ¢ 체중 증가 (특히 복부 주변)\nâ¢ 면역 체계\nâ¢ 고혈압\nâ¢ Difficulty 집중 및 메모리 문제\nâ¢ Premature 피부 노화\nâ¢ Persistent 피로에도 불구하고 휴식\nâ¢ 소화 문제";
"learning.card.cortisol.section4.title" = "정상적인 수준";
"learning.card.cortisol.section4.content" = "Cortisol는 자연 리듬을 따릅니다: 아침에 높은 (약 8am을 말하십시오) 일어나기 위하여, 그 때 점차적으로 저녁에 그것의 가장 낮은것에 있을 것입니다 (약 11pm) 잠을 허용하.";
"learning.card.cortisol.section5.title" = "CortiFree의 목표";
"learning.card.cortisol.section5.content" = "이 호르몬을 자연적으로 통제하는 과학적으로 입증 된 습관을 통해 건강하고 균형 잡힌 코 티솔 수준을 유지하는 데 도움이됩니다.";

