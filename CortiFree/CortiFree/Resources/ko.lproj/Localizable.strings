"breathing.ex.physiological_sigh.when" = "스트레스가 치솟을 때, 회의 전, 나쁜 소식을 들은 후에. 1~3번만 해도 도움이 되며, 1~5분 하면 효과가 오래갑니다.";
"breathing.ex.physiological_sigh.science" = "짧은 두 번째 들숨이 쪼그라든 폐포를 다시 열고, 긴 날숨이 CO2를 배출합니다. 2023년 스탠퍼드 연구에서 하루 5분이 마음챙김 명상보다 기분을 더 개선했습니다.";
"breathing.ex.sos_214.title" = "공황 SOS 2-1-4";
"breathing.ex.sos_214.benefit" = "불안이나 공황 상태에서 통제력을 되찾는 짧고 쉬운 리듬.";
"breathing.ex.sos_214.when" = "숨이 가빠지거나 공황이 밀려올 때. 짧은 사이클이라 압도된 상태에서도 따라 하기 쉽고, 이후 ‘긴 날숨’으로 넘어가세요.";
"breathing.ex.sos_214.science" = "공황 중에는 길고 느린 호흡이 불가능하게 느껴집니다. 짧게 들이쉬고 두 배로 길게 내쉬면 과호흡을 줄이고 CO2를 안정시켜 어지럼증과 저림을 완화합니다.";
"breathing.ex.four_seven_eight.title" = "4-7-8 수면 호흡";
"breathing.ex.four_seven_eight.benefit" = "더 빨리 잠들기 위한 이완 호흡.";
"breathing.ex.four_seven_eight.when" = "불을 끄고 침대에 누워서, 또는 밤에 깼을 때. 몇 사이클로 시작해 점차 늘리세요.";
"breathing.ex.four_seven_eight.science" = "긴 숨 참기와 아주 긴 날숨이 심박을 늦추고 마음을 고요하게 합니다. 불안 감소와 쉬운 입면이 보고되었습니다.";
"breathing.ex.sleep_wave.title" = "수면 파도 4-6-2";
"breathing.ex.sleep_wave.benefit" = "잠이 올 때까지 천천히 이끌어 주는 부드러운 파도.";
"breathing.ex.sleep_wave.when" = "침대에서 5~15분. 내쉰 뒤의 멈춤을 무겁고 부드럽게 느껴보세요.";
"breathing.ex.sleep_wave.science" = "분당 약 5회로 호흡을 늦추고 날숨 뒤에 멈추면 각성이 낮아지고 잠으로의 전환이 쉬워집니다.";
"breathing.ex.slow66.title" = "느린 호흡 6-6";
"breathing.ex.slow66.benefit" = "분당 5회 호흡으로 깊고 오래가는 안정감.";
"breathing.ex.slow66.when" = "저녁에 긴장을 풀 때, 바쁜 하루 후, 명상 전에.";
"breathing.ex.slow66.science" = "분당 5~6회의 느린 호흡은 스트레스 회복력의 지표인 심박변이도와 압반사 민감도를 극대화합니다.";
"breathing.ex.box.title" = "박스 호흡 4-4-4-4";
"breathing.ex.box.benefit" = "압박 속에서도 침착함을 유지하기 위해 엘리트 팀이 쓰는 4박자 리듬.";
"breathing.ex.box.when" = "시험, 발표, 경기 등 압박이 큰 순간 전에.";
"breathing.ex.box.science" = "같은 길이의 단계와 짧은 숨 참기가 CO2를 조절하고 숫자 세기에 주의를 고정해, 각성은 낮추되 정신은 맑게 유지합니다.";
"breathing.ex.triangle.title" = "삼각 호흡 4-4-4";
"breathing.ex.triangle.benefit" = "세 개의 같은 단계로 머리를 비우고 다시 집중합니다.";
"breathing.ex.triangle.when" = "집중이 흐트러졌을 때나 몰입 작업 전에.";
"breathing.ex.triangle.science" = "일정하고 균형 잡힌 리듬이 주의를 호흡에 붙잡아 두고, 졸리지 않게 호흡을 부드럽게 늦춥니다.";
"breathing.ex.alternate_nostril.title" = "교대 콧구멍 호흡";
"breathing.ex.alternate_nostril.benefit" = "한쪽 콧구멍씩 번갈아 호흡하며 균형을 되찾고 집중합니다.";
"breathing.ex.alternate_nostril.when" = "집중이 필요한 일 전이나 마음이 들떠 있을 때. 엄지로 한쪽, 약지로 다른 쪽 콧구멍을 막고 안내를 따르세요.";
"breathing.ex.alternate_nostril.science" = "교대 콧구멍 호흡(나디 쇼다나)은 여러 대조 연구에서 심박수와 혈압 감소, 주의력 향상과 관련이 있었습니다.";
"breathing.ex.energize.title" = "활력 호흡 4-2";
"breathing.ex.energize.benefit" = "길게 들이쉬고 빠르게 내쉬기. 커피 없이 얻는 자연스러운 활력.";
"breathing.ex.energize.when" = "아침, 점심 식사 후, 에너지가 떨어질 때. 1~3분이면 충분합니다.";
"breathing.ex.energize.science" = "들숨을 강조하면 교감신경이 가볍게 활성화되어 각성도가 높아집니다. 어지러우면 멈추세요.";
"breathing.ex.kapalabhati.title" = "카팔라바티";
"breathing.ex.kapalabhati.benefit" = "배에서 짧고 힘차게 내쉬어 몸과 마음을 깨웁니다.";
"breathing.ex.kapalabhati.when" = "아침 공복에 허리를 펴고 앉아서. 임신 중이거나 고혈압, 심장 질환이 있다면 피하세요.";
"breathing.ex.kapalabhati.science" = "빠른 복식 호흡은 잠시 각성도와 에너지를 높입니다. 짧게 하고 이후에는 차분한 호흡으로 돌아오세요.";

