// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "Anti-stress 아침 일상";
"tips.card.morning_routine.short_description" = "오른쪽 발에서 하루를 시작";
"tips.card.morning_routine.section1.title" = "왜 중요한가?";
"tips.card.morning_routine.section1.content" = "하루의 첫 60 분은 하루 종일 코티솔 수준을 결정합니다.";
"tips.card.morning_routine.section2.title" = "이상적인 일상 (60 분)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: 일어나고 수화\nâ¢ 물의 음료 500ml 하이킹\nâ¢ 수면 8h 후에 몸을 재수축\nâ¢ 당신의 물질을 활성화\n\n6:15-6:30: 빛 노출\nâ¢ 외부 또는 창문 근처\nâ¢ 15-30 자연 빛의 분\nâ¢ 중지 melatonin, 건강한 아침 cortisol을 활성화\n\n6:30-6:45: 젠틀 운동\nâ¢ Stretching, 부드러운 요가, 또는 산책\nâ¢ Gently wake 올라 몸\nâ¢ 출시 종료\n\n6:45-7:00: 마음의 실천\nâ¢ 5-10 분의 명상 또는 호흡\nâ¢ 심장결\nâ¢ 하루 당신의 의도를 설정";
"tips.card.morning_routine.section3.title" = "처음 60 분";
"tips.card.morning_routine.section3.content" = "â¢ 전화 / 이메일 / 소셜 미디어\nâ¢ 뉴스 (의 부정적인)\nâ¢ 스트레스 상황\nâ¢ 수화 전에 카페인";
"tips.card.morning_routine.section4.title" = "왜 작동합니까?";
"tips.card.morning_routine.section4.content" = "이 루틴은 당신의 순환 리듬을 동기화, 당신의 아침 코티솔 피크를 최적화 (beneficial) 하루 긍정적 인 정신 상태에 넣어.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "진정한 bedtime 의식";
"tips.card.sleep_ritual.short_description" = "몸을 준비하고 휴식을위한 마음";
"tips.card.sleep_ritual.section1.title" = "완벽한 의식";
"tips.card.sleep_ritual.section1.content" = "좋은 수면은 90 분 전에 침대로 시작합니다.\n\n9:30 PM: 빛 흐리게 하기\nâ¢ 집에있는 빛\nâ¢ 활성 야간 모드 전화 / 컴퓨터\nâ¢ 따뜻한 조명 만\n\n오후 9:45: 화면 종료\nâ¢ 더 많은 전화, TV, 컴퓨터\nâ¢ 대신 종이 책을 읽으십시오\nâ¢ 블루 라이트 블록 melatonin\n\n10:00 PM: 위생과 일상\nâ¢ 따뜻한 샤워 (뜨거운)\nâ¢ Face/teeth 배려 일상\nâ¢ 준비 내일의 옷\n\n10:15 오후: 휴식 활동\nâ¢ 빛 독서 (스릴러 없습니다!)\nâ¢ 저널링 / 감사\nâ¢ 명상 또는 부드러운 호흡\nâ¢ 빛 기지개\n\n10:30 PM: 객실 준비\nâ¢ 차가운 온도 (64-66Â°F/18-19Â 온도 (°C)\nâ¢ 총 어둠 (블랙 아웃 커튼)\nâ¢ Silence (필요한 경우를 삽입하십시오)\n\n오후 10:45-11:00: 베드 타임\nâ¢ 항상 동시에\nâ¢ 주말에도\nâ¢ 일관성 = 더 나은 수면";
"tips.card.sleep_ritual.section2.title" = "추가 팁";
"tips.card.sleep_ritual.section2.content" = "â¢ 8 PM 후 강렬한 운동 없음\nâ¢ 마지막 식사 2-3 시간 전\nâ¢는 4 PM 후 알코올 및 카페인을 피합니다.\nâ¢ 침실 예약 수면 (작업 없음)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "업무의 스트레스 관리";
"tips.card.work_stress.short_description" = "사무실에서 zen을 유지하는 전략";
"tips.card.work_stress.section1.title" = "마이크로 브레이크 매 시간";
"tips.card.work_stress.section1.content" = "â¢ 2 분의 깊은 호흡\nâ¢ 사무실 스트레치\nâ¢ 멀리 봐 (relaxes 눈)\nâ¢ 도보 몇 단계";
"tips.card.work_stress.section2.title" = "Smart 우선순위";
"tips.card.work_stress.section2.content" = "Eisenhower 모체:\nâ¢ 긴급 + 중요 = 지금\nâ¢ 중요 + 긴급하지 = 일정\nâ¢ 긴급 + 중요하지 = Delegate\nâ¢ 긴급하지 + 중요하지 = Eliminate\n\n1-3-5 방법:\nâ¢ 1 일 당 주요 작업\nâ¢ 3 중간 작업\nâ¢ 5 작은 작업";
"tips.card.work_stress.section3.title" = "회사연혁";
"tips.card.work_stress.section3.content" = "â¢ 초점 형태: 중단 없이 90 분\nâ¢ 무해한 알림\nâ¢ \"오픈 문\"는 동료를위한 슬롯\nâ¢ Email: 최대 3회/일";
"tips.card.work_stress.section4.title" = "외교하지 말";
"tips.card.work_stress.section4.content" = "\"나는 도움이 좋아하지만, 나는 이미 [X]에 최선을 다했습니다. [항상] 또는 [일시]에서 사용할 수 있습니다.\n\n당신의 시간은 귀입니다. 보호하다.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "매일 항 스트레스 영양";
"tips.card.nutrition.short_description" = "아침 식사와 간식";
"tips.card.nutrition.section1.title" = "아침 식사";
"tips.card.nutrition.section1.content" = "단백질 + 건강한 지방 + 섬유:\n\n옵션 1 : 계란 + Avocado + 전체 곡물 빵\n선택권 2: 그리스 요구르트 + 견과 + 열매\n옵션 3 : 스무디 (바나, 시금치, 아몬드 버터, 식물 우유)\n\n왜 : 혈당과 코 티솔을 매일 안정화시킵니다.";
"tips.card.nutrition.section2.title" = "안티 스트레스";
"tips.card.nutrition.section2.content" = "hunger 파업 (10 AM 또는 4 PM) :\n\nâ¢ Almonds (15-20) + 1 평방 어두운 초콜릿\nâ¢ 애플 + 알몬드 버터\nâ¢ 일반 요구르트 + 블루베리\nâ¢ Hummus + Veggie 스틱\nâ¢ 바나나 + 몇몇 견과\n\n피하십시오: 가공된 막대기, 페이스트리, sodas";
"tips.card.nutrition.section3.title" = "스마트 수화";
"tips.card.nutrition.section3.content" = "â¢ 2L 물 / 일 최소\nâ¢ Calming 주입 (카모마일, 동사나, 린덴)\nâ¢ 녹차 (L-theanine anti-stress)\n아침에 â¢ 레몬 물\n\n제한:\nâ¢ 커피 : 하루에 최대 2-3, 오후 2시 이후\nâ¢ 알코올 : 최대 1 음료 / 일\nâ¢ Sodas: 가끔만";
"tips.card.nutrition.section4.title" = "빛 저녁 식사";
"tips.card.nutrition.section4.content" = "bedtime의 앞에 2-3h:\n\nâ¢ 야채 + Lean 단백질 (낚시, 닭, 두부)\n작은 수량에 â¢ Complex carbs (rice, quinoa)\nâ¢ 튀김 식품, 무거운 요리, 강한 향신료\nâ¢ 식사 후 소화 차";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "어려운 감정을 관리";
"tips.card.emotions.short_description" = "긴급 감정 기술";
"tips.card.emotions.section1.title" = "4-7-8 기술 (독립 비상)";
"tips.card.emotions.section1.content" = "1. 입을 통해서 완전하게 Exhale (whoosh)\n2. 4에 조사하는 코를 통해서 흡입\n3. 7에 당신의 숨을 파악하십시오\n4. 8에 조사하는 입을 통해서 Exhale\n\n반복 4 주기.\n효력: parasympathetic 체계를 활성화하고, 90 초에서 진정하십시오.";
"tips.card.emotions.section2.title" = "5-4-3-2-1 기술 (현재 고정)";
"tips.card.emotions.section2.content" = "압도적 인 느낌이 될 때, 밝히는 이름 :\n\nâ¢ 5 당신에게 주위를 볼\nâ¢ 4 당신에게 도전\nâ¢ 3 것들을 HEAR\nâ¢ 2 일 당신 SMELL\nâ¢ 1 일 당신 TASTE\n\n현재에 마음을 가져와 불안한 나선형을 멈추십시오.";
"tips.card.emotions.section3.title" = "Emotional 저널";
"tips.card.emotions.section3.content" = "강한 감정이 도착하면, 쓰기 :\n\n1. 이 감정은 무엇입니까? (일반 이름)\n2. 당신은 당신의 몸에서 그것을 느낄 수 있습니까?\n3. 어떤 생각이 트리거?\n4. 이것은 사실 또는 해석이 생각합니까?\n5. 더 현실적인 대안이 생각될 것입니까?\n\n쓰기 = ruminating 대신 감정을 처리.";
"tips.card.emotions.section4.title" = "연락처";
"tips.card.emotions.section4.content" = "Emotion = 몸에 갇힌 에너지.\n\nâ¢ 브리스크 도보 10-15 분\nâ¢는 팔 / 다리를 활기차게 흔들\nâ¢ 춤을 에너지 음악\nâ¢ 깊은 stretching\nâ¢ 크림으로 베개 (필요한 경우)\n\n신체 MUST는 물리적으로 스트레스를 풀어줍니다.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "매일의 마음";
"tips.card.mindfulness.short_description" = "모든것이 편안하게";
"tips.card.mindfulness.section1.title" = "커피/차 마음";
"tips.card.mindfulness.section1.content" = "음주 대신 :\n\n1. 액체의 색깔을 관찰하십시오\n2. 깊은 냄새 향기\n3. 당신의 손에 컵의 따뜻함을 느끼십시오\n4. 작은 sip를 가지고, 입에 앉아\n5. 맛, 질감, 온도 통지\n6. 따뜻하게\n\n순수한 존재의 5 분.";
"tips.card.mindfulness.section2.title" = "좋은 산책";
"tips.card.mindfulness.section2.content" = "명상으로 산책을 변환:\n\nâ¢는 각 단계의 배경과 발의 접촉을 느낍니다\nâ¢ 당신의 팔의 움직임을 통지\nâ¢ 당신은 판단없이 볼 수 있는지 관찰\nâ¢ 듣는 소리 주위에 당신\nâ¢는 당신의 피부에 공기, 당신의 머리에 바람을 느낍니다\n\n5-10 분은 당신의 마음을 재설정하는 것이 충분합니다.";
"tips.card.mindfulness.section3.title" = "Mindful 샤워";
"tips.card.mindfulness.section3.content" = "â¢는 수온을 느낍니다\nâ¢는 당신의 피부에 흐르는 하락을 고시합니다\n몸 감각에 초점 â¢\nâ¢ 물 소리 관찰\nâ¢ 냄새 비누 / 샴푸\n\n매일 활동 = 명상 기회.";
"tips.card.mindfulness.section4.title" = "좋은 식사";
"tips.card.mindfulness.section4.content" = "1개의 식사/일 최소한 distraction 없이:\n\nâ¢ 아니 전화, TV, 컴퓨터\nâ¢ 당신의 판을 관찰 (색상, 짜임새)\nâ¢ 냄새 향기\nâ¢ Chew 천천히 (20-30 비트 당 시간)\nâ¢ 공지 맛, 질감\nâ¢ 비트 사이 포크를 넣어\n\n더 나은 소화 + 자연 satiety + 진정의 순간";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "Nonviolent 커뮤니케이션";
"tips.card.nvc.short_description" = "충돌 없이 당신의 필요를 표현하십시오";
"tips.card.nvc.section1.title" = "NVC의 4 단계";
"tips.card.nvc.section1.content" = "1. OBSERVATION (objective fact)\n\"When you arrive late to appointments...\"\n(NOT \"You're always late\" = judgment)\n\n2. FEELING (your emotion)\n\"...I feel stressed and frustrated...\"\n(NOT \"You stress me out\" = accusation)\n\n3. NEED (what you need)\n\"...because I need to be able to count on our commitments...\"\n\n4. REQUEST (concrete action)\n\"...could you send me a message if you're running late?\"\n(NOT \"You need to be on time\" = order)";
"tips.card.nvc.section2.title" = "활동 듣기";
"tips.card.nvc.section2.content" = "When someone talks to you:\n\n• Stop what you're doing\n• Look the person in the eyes\n• Don't prepare your response while they speak\n• Rephrase to verify your understanding\n• Validate the emotion before giving advice\n\n\"If I understand correctly, you feel [emotion] because [situation]?\"";
"tips.card.nvc.section3.title" = "관련 상품";
"tips.card.nvc.section3.content" = "• Breathe deeply before responding\n• Look for the truth in it (even small)\n• Thank them for the feedback\n• Ask for clarification if needed\n• Take a step back before deciding on action\n\n\"Thank you for telling me. Can you give me a concrete example?\"\n\nNot taking personally ≠ Allowing mistreatment";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "긍정적 인 관계를 육성";
"tips.card.positive_relations.short_description" = "사회적 채권 강화";
"tips.card.positive_relations.section1.title" = "연결 의식";
"tips.card.positive_relations.section1.content" = "â¢ 1 비디오 통화 / 주 사랑과 함께\nâ¢ 1 커피/메달 페이스 투 페이스\nâ¢ 체크인 메시지 2-3 친구/주\nâ¢ 월간 그룹 활동 (스포츠, 취미)\n\n질 > 양, 그러나 견실함 사정.";
"tips.card.positive_relations.section2.title" = "고급 등급";
"tips.card.positive_relations.section2.content" = "At least once/day, tell someone:\n\n\"I really appreciate that you [concrete action]. It made me feel [positive emotion].\"\n\nExamples:\n• \"Thank you for listening to my concerns yesterday. I felt understood.\"\n• \"I appreciate that you thought of me. It made me smile.\"\n\nStrengthens bonds + Releases oxytocin (happiness hormone)";
"tips.card.positive_relations.section3.title" = "독성 관계 식별";
"tips.card.positive_relations.section3.content" = "경고 표시:\n\nâ¢ 당신은 상호 작용 후 배수\nâ¢ 일정한 비평, 결코 지원\nâ¢ 감정적 인 감정 (그들, 절대로)\nâ¢ Manipulation 또는 guilt-tripping\nâ¢ 당신의 경계에 대한 존중\n\n활동: 진보적인 distancing 또는 frank 대화.\n에너지를 보호 할 권리가 있습니다.";
"tips.card.positive_relations.section4.title" = "자주 묻는 질문";
"tips.card.positive_relations.section4.content" = "Asking for help ≠ weakness:\n\n\"I need help with [situation]. Would you have [time/skill] to help me?\"\n\nOr simply:\n\"I'm going through a difficult time. Can we get coffee to talk about it?\"\n\nPeople want to help, but don't always know how. Be specific.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "스트레스없는 생산성";
"tips.card.productivity.short_description" = "능률과 zen";
"tips.card.productivity.section1.title" = "적응 Pomodoro 기술";
"tips.card.productivity.section1.content" = "세션에서 일:\n\nâ¢ 25 분 총 초점에 한 작업\nâ¢ 5 분 휴식 (걷기, 스트레치, 호흡)\nâ¢ 반복 4 시간\nâ¢ 20-30 분의 긴 휴식\n\n규칙:\nâ¢ 가시 타이머\n비행기 모드에서 â¢ 전화\nâ¢ 알림 비활성화\n· 중단된 경우 = Pomodoro 재설정\n\n결과: 진짜 일의 4h는 distraction의 8h 보다는 더 낫습니다.";
"tips.card.productivity.section2.title" = "당신의 두뇌로 일하기";
"tips.card.productivity.section2.content" = "각 뇌에는 에너지 피크가 있습니다.\n\n아침 사람들 (이상 상승자):\nâ¢ 8 AM-12 PM: 복잡하고/creative 작업\nâ¢ 2-4 PM: 루틴 작업\n오후 4시 이후 â¢: 조직/이메일\n\n저녁 사람들 (아침) :\nâ¢ 아침 : 루시 / 이메일\nâ¢ 2-6 PM : 복잡한 작업\nâ¢ 저녁 : 창의력 / 프로젝트\n\n당신의 리듬을 식별하고 일정을 적응.";
"tips.card.productivity.section3.title" = "'Done' 목록은 'To-Do'에 추가됩니다.";
"tips.card.productivity.section3.content" = "하루 말에, 당신이 DID를 작성:\n\nâ¢ 당신의 업적을 검증\nâ¢ 전투 impostor 증후군\nâ¢ 쇼 진행\nâ¢ 부스트 자기 책임\n\n당신의 두뇌는 부정적인 것을 기억합니다 (negativity bias).\n긍정적 인 것을 볼 수 있습니다.";
"tips.card.productivity.section4.title" = "'최고의 완벽한'의 예술";
"tips.card.productivity.section4.content" = "Perfectionism = Major source of stress.\n\n80/20 Rule (Pareto):\n• 80% of result comes from 20% of effort\n• The remaining 20% of result requires 80% additional effort\n\nQuestion: \"Is this last 20% really worth my time and stress?\"\n\nOften, \"good enough\" IS perfect.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "당신의 환경을 최적화";
"tips.card.environment.short_description" = "Anti-stress 생활 공간";
"tips.card.environment.section1.title" = "Decluttering (코마리 규칙)";
"tips.card.environment.section1.content" = "1개의 지역/주:\n\n각 개체를 가져 가라.\nâ¢ 나는 지난 6 개월에 그것을 사용 했습니까?\nâ¢ 그것은 나를 기쁨을 가져?\nâ¢ 정말 유용합니까?\n\n3x no â Don Donate, 재활용, 또는 쓰레기.\n\n시각적인 clutter = 정신 하중 초과.\n공간 = 맑음";
"tips.card.environment.section2.title" = "실내 식물";
"tips.card.environment.section2.content" = "최고 5개의 easy-care 반대로 스트레스:\n\n1. 냄비 (공기 + 스트레스)\n2. 뱀 식물 (밤에 산소)\n3. 알로에 Vera (공기를 순화하십시오)\n4. 스파이더 공장 (쉽게, 효과적인)\n5. 라벤더 (광택 냄새)\n\n수익 혜택:\nâ¢ -15% 코티솔\nâ¢ 더 나은 공기 품질\nâ¢ Soothing 시각적 효과";
"tips.card.environment.section3.title" = "최대 자연 빛";
"tips.card.environment.section3.content" = "â¢ 열린 커튼 에 waking\n가능한 경우 창 근처의 â¢ Desk\n아침에 â¢ 일광 전구 (5000-6500K)\n저녁에 â¢ 따뜻한 전구 (2700-3000K)\n침실에 â¢ 빛 디머\n\n빛 = #1 순환 리듬의 조절.";
"tips.card.environment.section4.title" = "소리와 음악";
"tips.card.environment.section4.content" = "일/비율:\nâ¢ 백색/갈색 소음\nâ¢ Baroque 클래식 음악 (60 bpm)\nâ¢ 자연 소리 (rain, 숲)\nâ¢ 아니 lyrics\n\n휴식:\nâ¢ 432Hz 주파수\nâ¢ 티베탄 그릇\nâ¢ 명상 음악\nâ¢ Binaural 소리 (theta/delta)\n\n활동당 재생 목록 만들기.";
"tips.card.environment.section5.title" = "온도와 공기";
"tips.card.environment.section5.content" = "공급 능력:\nâ¢ 활성 일 : 68-72Â°F (20-22Â°C)\nâ¢ 수면 : 6466Â°F (18-19Â°C)\nâ¢ 너무 뜨거운 = 피로, 과민성\n\n공기:\nâ¢ 환기 10-15 분 아침과 저녁\nâ¢ 겨울에 가습기 (40-60% 습도)\nâ¢는 독성 incense/scented 초를 피합니다\n\n몸은 최선의 환경에서 스트레스를 잘 조절합니다.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "Anti-stress 응급 키트";
"tips.card.emergency_kit.short_description" = "끊기 같은 느낌";
"tips.card.emergency_kit.section1.title" = "Imminent 공황 공격";
"tips.card.emergency_kit.section1.content" = "지금 (주문에서):\n\n1. 4-7-8 호흡 (위 구독)\n2. 얼굴에 얼음 물 또는 찬 샤워\n3. 5-4-3-2-1 기술 (센서 고정)\n4. 가능한 경우에 밖에 이동\n5. 당신이 신뢰하는 누군가\n\nReminder: 공황 공격 = 불쾌하지만 위험한.\n최대 10-20 분에 전달합니다.";
"tips.card.emergency_kit.section2.title" = "Urgent 물리적 출시";
"tips.card.emergency_kit.section2.content" = "스트레스가 몸에있을 때 :\n\nâ¢ 스프 프린트 30 초 (안전한 장소)\nâ¢ 20 점프 잭\nâ¢ Squeeze a pillow/cushion 단단한 그때 방출 (5x)\nâ¢ 모든 힘 (10 SEC)와 벽에 대한 푸시\n\n스트레스 에너지는 몸을 떠나.";
"tips.card.emergency_kit.section3.title" = "전화 번호";
"tips.card.emergency_kit.section3.content" = "이 목록을 준비하십시오 (당신의 전화에서):\n\nâ¢ 3 신뢰할 수있는 친구 / 가족\nâ¢ 듣기 라인 (Crisis Text Line : 텍스트 HOME에서 741741)\nâ¢ 당신 therapist 경우 당신 있다 한\nâ¢ 긴급 경우 즉각적인 위험 : 911\n\n위기에서, 당신은 명확하게 생각하지 않습니다.\n준비된 목록 = lifeline.";
"tips.card.emergency_kit.section4.title" = "휴식의 권한";
"tips.card.emergency_kit.section4.content" = "당신은 권리가 있다:\n\nâ¢ 계획 취소\nâ¢ 라고 \"나는 오늘 할 수 없습니다\"\n· 정신 휴식의 날\nâ¢ Delegate 무엇 delegated 수 있는\nâ¢ 비행기 모드에서 휴대 전화를 넣어\n\n자신을 돌보는 â; Selfishness.\nSURVIVAL입니다.\n\n잘 되지 않은 경우, 누구나 도움이 될 수 없습니다.";
"tips.card.emergency_kit.section5.title" = "위기 후";
"tips.card.emergency_kit.section5.content" = "일단 진정:\n\n1. 음료 물\n2. 뭔가 빛을 먹어\n3. 트리거 된 것을 참고하십시오 ( 패턴을 식별하려면)\n4. 실습 자기 통행 (심판 없음)\n5. recurring 경우에 계획 전문가 도움\n\n도움이 필요하세요.\n그것은 용기입니다.";


