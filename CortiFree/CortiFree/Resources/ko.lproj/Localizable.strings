// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplasticity: 당신의 두뇌는 변화할 수 있습니다";
"learning.card.neuroplasticity.description" = "뇌가 적응하고 진화하는 방법";
"learning.card.neuroplasticity.section1.title" = "무엇을 의미합니까?";
"learning.card.neuroplasticity.section1.content" = "Neuroplasticity는 당신의 두뇌의 능력 자체를 재전송하고 당신의 생활 내내 새로운 신경 연결을 창조합니다.\n\nâ¢ 당신의 두뇌는 고정되지 않습니다, 그것은 지속적으로 진화\nâ¢ 각 새로운 습관은 새로운 신경 회로를 만듭니다\nâ¢ 오래된 습관은 \"불명한\"일 수 있습니다\n· 더 많은 연습, 더 강한 연결이되었습니다";
"learning.card.neuroplasticity.section2.title" = "과학적 증거";
"learning.card.neuroplasticity.section2.content" = "â¢ MRI 검사는 명상의 8 주 후에 구조상 변화를 보여줍니다\n스트레스 (amygdala)에 연결된 â¢ 두뇌 영역은 볼륨에서 줄일 수 있습니다.\nâ¢ 영역 농도에 연결 (전면 cortex)는 두껍게 할 수 있습니다\nâ¢ 회색 물질은 정기적으로 사용 된 지역에서 증가";
"learning.card.neuroplasticity.section3.title" = "얼마나 걸리는";
"learning.card.neuroplasticity.section3.content" = "â¢ 첫 번째 변경 : 2-4 주\nâ¢ Measurable 변화: 6-8 주\nâ¢ 마지막 변경: 2-3 개월";
"learning.card.neuroplasticity.section4.title" = "중요한 메시지";
"learning.card.neuroplasticity.section4.content" = "스트레스를 받지 못했습니다. CortiFree를 사용하면 두뇌를 더 잘 관리할 수 있습니다!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "수면주기";
"learning.card.sleep_cycles.description" = "자주 묻는 질문";
"learning.card.sleep_cycles.section1.title" = "수면의 4 단계";
"learning.card.sleep_cycles.section1.content" = "잠은 90 분 주기로 밤 당 4-6배 반복했습니다:\n\n1ï ̧âã£ 가벼운 잠 (5-10 분): Wake-sleep 전이, 근육이 휴식을 취하기 쉬운\n\n2ï ̧âã£ 딥 라이트 수면 (20 분) : 심장 박동, 체온 방울, 총 시간의 50%\n\n3ï ̧âã£ 딥 수면 (20-40 분) : 가장 복원 단계, 물리적 재생, MAXIMUM CORTISOL 교육\n\n4ï ̧âã£ REM / 패러다임 수면 (10-60 분) : 강렬한 꿈, 정서적 통합, 스트레스 처리";
"learning.card.sleep_cycles.section2.title" = "사이클 최적화";
"learning.card.sleep_cycles.section2.content" = "â¢ 7.5 또는 수면의 9 시간 (5 또는 6 완전한 주기)\nâ¢ 피 6 또는 8 시간 (중간 사이클 = 피로)\nâ¢ 침대로 이동하고 고정 시간에 일어나 (주말까지)";
"learning.card.sleep_cycles.section3.title" = "cortisol에 충격";
"learning.card.sleep_cycles.section3.content" = "â¢ 깊은 수면 = 70% cortisol에서 하락\n수면 부족 = +37% 다음 날\nâ¢ 3 나쁜 밤 = 인슐린 저항 (전 당뇨병)";
"learning.card.sleep_cycles.section4.title" = "품질 > 수량";
"learning.card.sleep_cycles.section4.content" = "8 시간 이상의 깊은 수면을 가진 6 시간을 보내고 수면을 파열!";

