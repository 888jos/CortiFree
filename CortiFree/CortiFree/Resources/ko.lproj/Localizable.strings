// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "자동 부정적인 생각";
"learning.card.negative_thoughts.description" = "독성 패턴을 식별하고 교체";
"learning.card.negative_thoughts.section1.title" = "독성의 7 가지 유형";
"learning.card.negative_thoughts.section1.content" = "Your thoughts directly influence your stress and cortisol level. Learning to identify and modify automatic negative thoughts is crucial.\n\n1️⃣ Catastrophizing: \"If I fail this exam, my life is over\"\n→ Reality: A failure isn't the end\n\n2️⃣ All-or-nothing thinking: \"If it's not perfect, it's a failure\"\n→ Reality: Life is made of nuances\n\n3️⃣ Overgeneralization: \"I failed once, I always fail\"\n→ Reality: One situation ≠ all situations\n\n4️⃣ Mental filter: Ignoring the positive, focusing on the negative\n→ Reality: Also look for what's going well\n\n5️⃣ Mind reading: \"They think I'm incompetent\"\n→ Reality: You can't read minds\n\n6️⃣ Personalization: \"It's definitely my fault\"\n→ Reality: Not everything depends on you\n\n7️⃣ Tyrannical obligations: \"I MUST be perfect\"\n→ Reality: Nobody is perfect";
"learning.card.negative_thoughts.section2.title" = "3 열 기술";
"learning.card.negative_thoughts.section2.content" = "란 1: 상황\n칼럼 2 : 자동 생각\nColumn 3: 현실적인 대안 생각";
"learning.card.negative_thoughts.section3.title" = "Measurable 충격";
"learning.card.negative_thoughts.section3.content" = "â¢ -40 % 인식 치료와 불안\nâ¢ -28% 이 생각을 식별하고 수정하여\nâ¢ 8-12 주 후에 지속 개선";
"learning.card.negative_thoughts.section4.title" = "공지사항";
"learning.card.negative_thoughts.section4.content" = "CortiFree 저널의 생각을 작성하면 식별, 질문 및 변환 할 수 있습니다!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "위도와 뇌";
"learning.card.gratitude.description" = "인정의 과학적 효과";
"learning.card.gratitude.section1.title" = "What happens in your brain";
"learning.card.gratitude.section1.content" = "Practicing gratitude isn't just \"positive thinking\": it's a scientifically validated technique that modifies your brain and stress level.\n\n• Activation of the medial prefrontal cortex (well-being)\n• Release of dopamine and serotonin (happiness)\n• Reduced amygdala activity (stress/fear)\n• -23% cortisol on average";
"learning.card.gratitude.section2.title" = "주요 과학 연구";
"learning.card.gratitude.section2.content" = "UC 버클리 (2015):\nâ¢ 3x / 주 저널\nâ¢ -27% 12 주 후 우울증\nâ¢ 향상된 수면 및 사회적 관계\n\n하버드 의료 학교 (2021) :\nâ¢ 하루 5 분\nâ¢ +25% 행복 펠트\nâ¢ -18% 불안";
"learning.card.gratitude.section3.title" = "효과적으로 연습하는 방법";
"learning.card.gratitude.section3.content" = "3 gratitudes method (5 min/day):\n1. Write 3 things you're grateful for\n2. Be specific (not just \"my family\")\n3. Feel the emotion while writing\n4. Vary your gratitudes each day\n\nExamples:\nToo vague: \"I'm grateful for my health\"\nSpecific: \"I'm grateful I could do my morning walk without pain and feel the fresh air on my face\"";
"learning.card.gratitude.section4.title" = "장기 효과";
"learning.card.gratitude.section4.content" = "After 4 weeks:\n• Measurable changes in the brain\n• Better sleep quality\n• More positive emotions\n\nAfter 12 weeks:\n• New higher happiness baseline\n• Increased resilience to stress\n• Better interpersonal relationships";
"learning.card.gratitude.section5.title" = "CortiFree에 통합";
"learning.card.gratitude.section5.content" = "저널은 매일 등급에주의 할 수 있습니다. 이 간단한 2-3 분 연습은 스트레스와 관계를 변형시킬 수 있습니다!";
"learning.card.gratitude.section6.title" = "주요 특징";
"learning.card.gratitude.section6.content" = "Gratitude는 문제없이, 그것은 당신의 두뇌를 훈련하고 또한 부정적인 초점 대신 긍정적 인 볼 수 있습니다.";

