// MARK: - Learning Card 1: Cortisol
"learning.card.cortisol.title" = "¿Qué es el cortisol?";
"learning.card.cortisol.description" = "Comprender la hormona del estrés";
"learning.card.cortisol.section1.title" = "Introducción";
"learning.card.cortisol.section1.content" = "El cortisol se suele llamar \"la hormona del estrés\". Lo producen las glándulas suprarrenales y desempeña un papel esencial en la respuesta de tu cuerpo al estrés.";
"learning.card.cortisol.section2.title" = "Funciones positivas del cortisol";
"learning.card.cortisol.section2.content" = "• Regula tus niveles de energía durante todo el día\n• Ayuda a manejar situaciones difíciles y estresantes\n• Controla la presión arterial y el azúcar en la sangre\n• Reduce la inflamación en el cuerpo\n• Participa en el metabolismo de las grasas, proteínas y carbohidratos\n• Regula el ciclo del sueño (ritmo circadiano)";
"learning.card.cortisol.section3.title" = "Problemas del exceso crónico";
"learning.card.cortisol.section3.content" = "• Ansiedad crónica y trastornos del sueño\n• Aumento de peso (sobre todo alrededor del abdomen)\n• Sistema inmunitario debilitado\n• Presión arterial alta\n• Dificultad para concentrarse y problemas de memoria\n• Envejecimiento prematuro de la piel\n• Fatiga persistente a pesar del descanso\n• Problemas digestivos";
"learning.card.cortisol.section4.title" = "Niveles normales";
"learning.card.cortisol.section4.content" = "El cortisol sigue un ritmo natural: alto por la mañana (pico hacia las 8 h) para despertarte, luego disminuye gradualmente a lo largo del día hasta alcanzar su nivel más bajo por la noche (hacia las 23 h), lo que te permite dormir.";
"learning.card.cortisol.section5.title" = "La meta de CortiFree";
"learning.card.cortisol.section5.content" = "Para ayudarle a mantener un nivel de cortisol saludable y equilibrado a través de hábitos científicamente probados que regulan naturalmente esta hormona.";

// MARK: - Learning Card 2: Meditation
"learning.card.meditation_science.title" = "La ciencia de la meditación";
"learning.card.meditation_science.description" = "Lo que la neurociencia dice";
"learning.card.meditation_science.section1.title" = "Pruebas científicas";
"learning.card.meditation_science.section1.content" = "Miles de estudios científicos han demostrado los beneficios de la meditación:\n\n• Engrosamiento de la corteza prefrontal\n• Reducción de la amígdala (centro del miedo)\n• Aumento de la materia gris";
"learning.card.meditation_science.section2.title" = "Resultados mensurables";
"learning.card.meditation_science.section2.content" = "• -30% de cortisol después de 8 semanas\n• Mejora del 40% en la concentración\n• Reducción del 50% de los síntomas de ansiedad";
"learning.card.meditation_science.section3.title" = "Tiempo necesario";
"learning.card.meditation_science.section3.content" = "Los cambios cerebrales visibles aparecen después de sólo 8 semanas de práctica diaria durante 10-15 minutos.\n\n¡Ya estás en el camino correcto con CortiFree!";

// MARK: - Learning Card 3: 66 days
"learning.card.66days.title" = "Los 66 días para formar un hábito";
"learning.card.66days.description" = "Por qué el programa dura 66 días";
"learning.card.66days.section1.title" = "El estudio de referencia";
"learning.card.66days.section1.content" = "• University College London (2009)\n• 66 días = tiempo promedio para automatizar un hábito\n• Rango de 18 a 254 días dependiendo de la complejidad";
"learning.card.66days.section2.title" = "Las 3 fases";
"learning.card.66days.section2.content" = "1. Semanas 1-3: Período de esfuerzo consciente\n2. Semanas 4-7: Inicio de la automatización\n3. Semanas 8-10: Hábito anclado";
"learning.card.66days.section3.title" = "Por qué funciona";
"learning.card.66days.section3.content" = "• Creación de nuevas conexiones neuronales\n• Refuerzo progresivo\n• Transformación en reflejo automático";
"learning.card.66days.section4.title" = "Tu objetivo";
"learning.card.66days.section4.content" = "¡Al final de los 66 días, tus nuevos hábitos antiestrés serán parte integral de tu vida!";

// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplasticidad: tu cerebro puede cambiar";
"learning.card.neuroplasticity.description" = "Cómo tu cerebro se adapta y evoluciona";
"learning.card.neuroplasticity.section1.title" = "Lo que significa";
"learning.card.neuroplasticity.section1.content" = "La neuroplasticidad es la capacidad de tu cerebro para reconfigurarse y crear nuevas conexiones neuronales a lo largo de toda tu vida.\n\n• Tu cerebro no es fijo, evoluciona constantemente\n• Cada nuevo hábito crea nuevos circuitos neuronales\n• Los viejos hábitos se pueden \"desaprender\"\n• Cuanto más practiques, más fuertes se vuelven las conexiones";
"learning.card.neuroplasticity.section2.title" = "Pruebas científicas";
"learning.card.neuroplasticity.section2.content" = "• Las resonancias magnéticas muestran cambios estructurales después de 8 semanas de meditación\n• Las áreas cerebrales vinculadas al estrés (amígdala) pueden disminuir de volumen\n• Las áreas vinculadas a la concentración (corteza prefrontal) pueden engrosarse\n• La materia gris aumenta en las áreas que se usan con regularidad";
"learning.card.neuroplasticity.section3.title" = "Cuánto tiempo lleva";
"learning.card.neuroplasticity.section3.content" = "• Primeros cambios: 2-4 semanas\n• Cambios mensurables: 6-8 semanas\n• Cambios duraderos: 2-3 meses";
"learning.card.neuroplasticity.section4.title" = "El mensaje importante";
"learning.card.neuroplasticity.section4.content" = "No estás condenado a seguir estresado. ¡Con CortiFree, estás literalmente reprogramando tu cerebro para manejar mejor el estrés!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "Ciclos de sueño";
"learning.card.sleep_cycles.description" = "Comprender y optimizar tu descanso";
"learning.card.sleep_cycles.section1.title" = "Las 4 fases del sueño";
"learning.card.sleep_cycles.section1.content" = "El sueño consiste en ciclos de 90 minutos que se repiten 4-6 veces por noche:\n\n1️⃣ Sueño ligero (5-10 min): transición entre vigilia y sueño, los músculos se relajan, es fácil despertarse\n\n2️⃣ Sueño ligero profundo (20 min): la frecuencia cardíaca disminuye, la temperatura corporal baja, 50% del tiempo total\n\n3️⃣ Sueño profundo (20-40 min): la fase más reparadora, regeneración física, MÁXIMA REDUCCIÓN DEL CORTISOL\n\n4️⃣ Sueño REM / paradójico (10-60 min): sueños intensos, consolidación emocional, procesamiento del estrés";
"learning.card.sleep_cycles.section2.title" = "Optimizar tus ciclos";
"learning.card.sleep_cycles.section2.content" = "• Apunta a 7,5 o 9 horas de sueño (5 o 6 ciclos completos)\n• Evita 6 u 8 horas (despertarte a mitad de ciclo = fatiga)\n• Acuéstate y levántate a horas fijas (incluso los fines de semana)";
"learning.card.sleep_cycles.section3.title" = "Impacto en el cortisol";
"learning.card.sleep_cycles.section3.content" = "• Sueño profundo = 70% menos de cortisol\n• Falta de sueño = +37% de cortisol al día siguiente\n• 3 malas noches = resistencia a la insulina (prediabetes)";
"learning.card.sleep_cycles.section4.title" = "Calidad > Cantidad";
"learning.card.sleep_cycles.section4.content" = "¡Mejor 6 horas con mucho sueño profundo que 8 horas de sueño ligero y fragmentado!";

// MARK: - Learning Card 6: Stress and body
"learning.card.stress_body.title" = "Cómo afecta el estrés a tu cuerpo";
"learning.card.stress_body.description" = "Los impactos físicos del estrés crónico";
"learning.card.stress_body.section1.title" = "Cerebro";
"learning.card.stress_body.section1.content" = "• Dificultad para concentrarse\n• Problemas de memoria\n• Ansiedad y depresión";
"learning.card.stress_body.section2.title" = "Corazón";
"learning.card.stress_body.section2.content" = "• Aumento de la presión arterial\n• Riesgo cardiovascular elevado\n• Palpitaciones";
"learning.card.stress_body.section3.title" = "Músculos";
"learning.card.stress_body.section3.content" = "• Tensión y dolor\n• Dolores de cabeza\n• fatiga crónica";
"learning.card.stress_body.section4.title" = "Energía";
"learning.card.stress_body.section4.content" = "• Agotamiento\n• Trastornos del sueño\n• Motivación reducida\n\nPor eso es crucial manejar el estrés diariamente.";

// MARK: - Learning Card 7: Anti-stress food
"learning.card.food.title" = "Nutrición antiestrés";
"learning.card.food.description" = "Alimentos que regulan el cortisol";
"learning.card.food.section1.title" = "Alimentos que REDUCEN el cortisol";
"learning.card.food.section1.content" = "Grasas saludables:\n• Aguacate, nueces, almendras\n• Aceite de oliva, pescado azul (salmón, caballa)\n• Ricos en omega-3 antiinflamatorios\n\nAlimentos ricos en magnesio:\n• Chocolate negro (>70% de cacao)\n• Espinacas, plátanos\n• Semillas de calabaza, almendras\n• El magnesio reduce la ansiedad y el cortisol\n\nVitamina C:\n• Cítricos, kiwis, pimientos\n• Reduce el cortisol un 15-20%\n• Fortalece el sistema inmunitario\n\nTé verde y negro:\n• L-teanina, que calma la mente\n• 20% menos de cortisol después de 6 semanas";
"learning.card.food.section2.title" = "Alimentos que AUMENTAN el cortisol";
"learning.card.food.section2.content" = "Exceso de cafeína:\n• Más de 400 mg/día (4 cafés)\n• Aumenta el cortisol un 30%\n• Altera el sueño\n\nAzúcares refinados:\n• Picos de azúcar en sangre = picos de cortisol\n• Inflamación sistémica\n• Adicción y antojos\n\nAlcohol:\n• Altera el sueño profundo\n• Aumenta el cortisol nocturno\n• Deshidratación";
"learning.card.food.section3.title" = "El momento importa";
"learning.card.food.section3.content" = "• Desayuno rico en proteínas (estabiliza el cortisol)\n• Evite los azúcares y la cafeína por la noche\n• Cena ligera 2-3 horas antes de la cama";

