"learning.card.hydration.section3.content" = "• Mínimo 2L de agua por día\n• Más si activo físicamente\n• Esparce durante todo el día";
"learning.card.hydration.section4.title" = "Tip";
"learning.card.hydration.section4.content" = "Comience su día con un gran vaso de agua para despertar su metabolismo!";

// MARK: - Learning Card 14: Physical exercise
"learning.card.exercise.title" = "Ejercicio físico antiestrés";
"learning.card.exercise.description" = "Cómo el deporte regula el cortisol";
"learning.card.exercise.section1.title" = "Efectos sobre el cortisol";
"learning.card.exercise.section1.content" = "La actividad física es un regulador de estrés natural:\n\n• A corto plazo: ligero aumento (normal)\n• A largo plazo: disminución significativa del cortisol de base";
"learning.card.exercise.section2.title" = "Beneficios adicionales";
"learning.card.exercise.section2.content" = "• La liberación de endorfinas (hormonas de felicidad)\n• El sueño mejorado\n• Mejor autoestima";
"learning.card.exercise.section3.title" = "Duración ideal";
"learning.card.exercise.section3.content" = "• 20-30 min por sesión\n• 3-5 veces por semana\n• Intensidad moderada";
"learning.card.exercise.section4.title" = "Precaución";
"learning.card.exercise.section4.content" = "El ejercicio demasiado intenso puede aumentar el cortisol. ¡El equilibrio es clave!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "Relaciones sociales positivas";
"learning.card.social.description" = "La importancia del apoyo social";
"learning.card.social.section1.title" = "Impacto en el cortisol";
"learning.card.social.section1.content" = "Las conexiones sociales de calidad son esenciales para manejar el estrés:\n\n• Interacciones positivas → -20% cortisol\n• Liberación de la oxitocina (\"hormona del amor\")\n• Sentimiento de seguridad y pertenencia";
"learning.card.social.section2.title" = "Tipos de conexiones beneficiosas";
"learning.card.social.section2.content" = "• Conversaciones profundas con amigos\n• Momentos de calidad con familia\n• Actividades de grupo (deportes, hobbies)";
"learning.card.social.section3.title" = "Para evitar";
"learning.card.social.section3.content" = "• Aislamiento prolongado\n• Relaciones tóxicas o conflictivas";
"learning.card.social.section4.title" = "¿Lo sabías?";
"learning.card.social.section4.content" = "Un simple abrazo de 20 segundos puede reducir significativamente su nivel de estrés!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "Exposición a la luz natural";
"learning.card.light.description" = "Regula tu reloj biológico";
"learning.card.light.section1.title" = "La importancia de la mañana";
"learning.card.light.section1.content" = "La luz natural juega un papel crucial en la regulación de su cortisol y ritmo circadiano:\n\n• Obtener exposición a la luz dentro de 30-60 min después de despertar\n• 10-30 minutos al aire libre mínimo (incluso en días nublados)\n• Activa la producción de cortisol matinal (normal y beneficioso)\n• Detiene la producción de melatonina (hormona de dormir)";
"learning.card.light.section2.title" = "Impacto en su reloj biológico";
"learning.card.light.section2.content" = "• Regula el ciclo de cortisol/melatonina\n• Mejora la calidad del sueño nocturno\n• Aumenta la energía diurna y la alerta\n• Sincroniza todos tus ritmos biológicos";
"learning.card.light.section3.title" = "Estudios científicos";
"learning.card.light.section3.content" = "• +25% de energía diurna con exposición matinal\n• Duerme 1 hora más rápido por la noche\n• -35% síntomas depresivos\n• Mejor regulación del apetito";
"learning.card.light.section4.title" = "Por la noche, evite";
"learning.card.light.section4.content" = "• Pantallas 1-2 horas antes de acostarse\n• Luces brillantes (preferir luces tibias/mezcladas)\n• Luz azul que bloquea la melatonina";
"learning.card.light.section5.title" = "Corti propina gratuita";
"learning.card.light.section5.content" = "Combine su caminata por la mañana con exposición a la luz natural para un efecto multiplicado en su energía y estrés!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "Pensamientos negativos automáticos";
"learning.card.negative_thoughts.description" = "Determinación y sustitución de patrones tóxicos";
"learning.card.negative_thoughts.section1.title" = "Los 7 tipos de pensamientos tóxicos";
"learning.card.negative_thoughts.section1.content" = "Sus pensamientos influencian directamente su estrés y nivel de cortisol. Aprender a identificar y modificar los pensamientos negativos automáticos es crucial.\n\n1⃣ Catastrofización: \"Si fallo este examen, mi vida ha terminado\"\n→ Realidad: Un fracaso no es el fin\n\n2️ Pensando todo o nada: \"Si no es perfecto, es un fracaso\"\n→ Realidad: La vida está hecha de matices\n\nSobregeneralización: \"He fallado una vez, siempre he fallado\"\n→ Realidad: Una situación ل todas las situaciones\n\n4️ Filtro mental: Ignorando lo positivo, centrándose en lo negativo\n→ Realidad: También busque lo que va bien\n\n5⃣ Lección de la mente: \"Creen que soy incompetente\"\n→ Realidad: No se puede leer mentes\n\nPersonalización: \"Definitivamente es mi culpa\"\n→ Realidad: No todo depende de ti\n\n7️ Obligaciones tiránicas: \"Debo ser perfecto\"\n→ Realidad: Nadie es perfecto";
"learning.card.negative_thoughts.section2.title" = "La técnica de 3 columnas";
"learning.card.negative_thoughts.section2.content" = "Columna 1: Situación\nColumna 2: Pensamiento automático\nColumna 3: Pensamiento alternativo realista";
"learning.card.negative_thoughts.section3.title" = "Impacto mensurable";
"learning.card.negative_thoughts.section3.content" = "• -40% de ansiedad con terapia cognitiva\n• -28% de cortisol identificando y modificando estos pensamientos\n• Mejora duradera después de 8-12 semanas";
"learning.card.negative_thoughts.section4.title" = "Consejo de revistas";
"learning.card.negative_thoughts.section4.content" = "Escribir tus pensamientos en la revista CortiFree te ayuda a identificar, cuestionar y transformarlos!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "Gratitud y cerebro";
"learning.card.gratitude.description" = "El efecto científico del reconocimiento";
"learning.card.gratitude.section1.title" = "Lo que pasa en tu cerebro";
"learning.card.gratitude.section1.content" = "Practicar la gratitud no es sólo \"pensamiento positivo\": es una técnica científicamente validada que modifica su cerebro y nivel de estrés.\n\n• Activación de la corteza prefrontal medial (bienestar)\n• Liberación de dopamina y serotonina (felicidad)\n• Actividad de ammígdala reducida (streza/temor)\n• -23% de cortisol en promedio";
"learning.card.gratitude.section2.title" = "Principales estudios científicos";
"learning.card.gratitude.section2.content" = "UC Berkeley (2015):\n• Revista de Gratitud 3x/semana\n• -27% de depresión después de 12 semanas\n• Mejor sueño y relaciones sociales\n\nHarvard Medical School (2021):\n• 5 minutos de gratitud por día\n• +25% de felicidad\n• -18% de ansiedad";
"learning.card.gratitude.section3.title" = "Cómo practicar eficazmente";
"learning.card.gratitude.section3.content" = "3 método de gratitud (5 min/día):\n1. Escribe 3 cosas que estás agradecido por\n2. Sea específico (no sólo \"mi familia\")\n3. Siente la emoción mientras escribe\n4. Agradezca cada día\n\nEjemplos:\nDemasiado vago: \"Estoy agradecido por mi salud\"\nEspecífico: \"Estoy agradecido de poder hacer mi caminata matutina sin dolor y sentir el aire fresco en mi cara\"";
"learning.card.gratitude.section4.title" = "Efectos a largo plazo";
"learning.card.gratitude.section4.content" = "Después de 4 semanas:\n• Cambios mensurables en el cerebro\n• Mejor calidad del sueño\n• Más emociones positivas\n\nDespués de 12 semanas:\n• Nueva base de la felicidad superior\n• Aumento de la resistencia al estrés\n• Mejores relaciones interpersonales";
"learning.card.gratitude.section5.title" = "Integrado en CortiFree";
"learning.card.gratitude.section5.content" = "La revista le permite observar sus agradecimientos diarios. Esta práctica simple de 2-3 minutos puede transformar su relación con el estrés!";
"learning.card.gratitude.section6.title" = "Importante";
"learning.card.gratitude.section6.content" = "La gratitud no niega problemas, entrena a tu cerebro para ver también lo positivo en lugar de centrarse sólo en lo negativo.";

