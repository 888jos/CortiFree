"learning.card.yoga.section3.content" = "Física:\n• Flexibilidad y fuerza muscular\n• Mejor postura\n• Dolor crónico reducido\n• Equilibrio mejorado\n\nMental:\n• -65% de los síntomas de ansiedad\n• Mejor regulación emocional\n• Mayor materia gris\n• Mejor concentración\n\nFisiológica:\n• Activación del sistema parasimpático (relajación)\n• Mejor variabilidad de la frecuencia cardíaca\n• Inflamación reducida\n• Digestión mejorada";
"learning.card.yoga.section4.title" = "Lo que pasa en tu cerebro";
"learning.card.yoga.section4.content" = "• Aumento del GABA ( neurotransmisor de calentamiento)\n• Actividad de ammígdala reducida (temor/streza)\n• Corteza prefrontal activada (control emocional)";
"learning.card.yoga.section5.title" = "No es necesario ser flexible";
"learning.card.yoga.section5.content" = "Yoga no es una competencia. Cada cuerpo es diferente, y los beneficios antiestrés vienen de las primeras sesiones, incluso con adaptaciones!";

