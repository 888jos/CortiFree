// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplicidad: tu cerebro puede cambiar";
"learning.card.neuroplasticity.description" = "Cómo tu cerebro se adapta y evoluciona";
"learning.card.neuroplasticity.section1.title" = "Lo que significa";
"learning.card.neuroplasticity.section1.content" = "La neuroplicidad es la capacidad de su cerebro para revivir y crear nuevas conexiones neuronales a lo largo de su vida.\n\n• Su cerebro no está fijo, evoluciona constantemente\n• Cada nuevo hábito crea nuevos circuitos neuronales\n• Los viejos hábitos pueden ser \"sin aprender\"\n• Cuanto más practiques, más fuertes serán las conexiones";
"learning.card.neuroplasticity.section2.title" = "Pruebas científicas";
"learning.card.neuroplasticity.section2.content" = "• Los escáneres de RM muestran cambios estructurales después de 8 semanas de meditación\n• Las áreas cerebrales vinculadas al estrés (amygdala) pueden disminuir el volumen\n• Áreas vinculadas a la concentración (corteza prefrontal) pueden engrosar\n• Aumenta la materia gris en áreas de uso regular";
"learning.card.neuroplasticity.section3.title" = "Cuánto tiempo lleva";
"learning.card.neuroplasticity.section3.content" = "• Primeros cambios: 2-4 semanas\n• Cambios mensurables: 6-8 semanas\n• Cambios duraderos: 2-3 meses";
"learning.card.neuroplasticity.section4.title" = "El mensaje importante";
"learning.card.neuroplasticity.section4.content" = "No estás condenado a permanecer estresado. Con CortiFree, estás literalmente reprogramando tu cerebro para manejar mejor el estrés!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "Ciclos de sueño";
"learning.card.sleep_cycles.description" = "Comprender y optimizar tu descanso";
"learning.card.sleep_cycles.section1.title" = "Las 4 fases del sueño";
"learning.card.sleep_cycles.section1.content" = "El sueño consiste en ciclos de 90 minutos repetidos 4-6 veces por noche:\n\n1⃣ Duerme ligero (5-10 min): transición de Despierta, los músculos relajan, fácil de despertar\n\n2️ El sueño profundo de la luz (20 min): La frecuencia cardíaca disminuye, la temperatura corporal baja, 50% del tiempo total\n\n3️ Dormir profundo (20-40 min): La mayor fase restaurativa, regeneración física, MAXIMUM CORTISOL REDUCCIÓN\n\n4 RE REM / sueño paradójico (10-60 min): sueños intensos, consolidación emocional, procesamiento del estrés";
"learning.card.sleep_cycles.section2.title" = "Optimizar sus ciclos";
"learning.card.sleep_cycles.section2.content" = "• Objetivo para 7,5 o 9 horas de sueño (5 o 6 ciclos completos)\n• Evite 6 o 8 horas (despertando el ciclo medio = fatiga)\n• Ve a la cama y despierta en horario fijo (incluso los fines de semana)";
"learning.card.sleep_cycles.section3.title" = "Impacto en el cortisol";
"learning.card.sleep_cycles.section3.content" = "• sueño profundo = 70% de caída en cortisol\n• Falta de sueño = +37% de cortisol al día siguiente\n• 3 noches malas = resistencia a la insulina (pre-diabetes)";
"learning.card.sleep_cycles.section4.title" = "Calidad > Cantidad";
"learning.card.sleep_cycles.section4.content" = "Mejor tener 6 horas con mucho sueño profundo que 8 horas de luz y sueño fragmentado!";

// MARK: - Learning Card 6: Stress and body
"learning.card.stress_body.title" = "Cómo afecta el estrés a su cuerpo";
"learning.card.stress_body.description" = "Los impactos físicos del estrés crónico";
"learning.card.stress_body.section1.title" = "Cerebro";
"learning.card.stress_body.section1.content" = "• Dificultad para concentrarse\n• Problemas de memoria\n• Ansiedad y depresión";
"learning.card.stress_body.section2.title" = "Corazón";
"learning.card.stress_body.section2.content" = "• Aumento de la presión arterial\n• Riesgo cardiovascular elevado\n• Palpitaciones";
"learning.card.stress_body.section3.title" = "Musculos";
"learning.card.stress_body.section3.content" = "• Tensión y dolor\n• Dolores de cabeza\n• fatiga crónica";
"learning.card.stress_body.section4.title" = "Energía";
"learning.card.stress_body.section4.content" = "• Agotamiento\n• Trastornos del sueño\n• Motivación reducida\n\nPor eso es crucial manejar el estrés diariamente.";

// MARK: - Learning Card 7: Anti-stress food
"learning.card.food.title" = "Nutrición antiestrés";
"learning.card.food.description" = "Alimentos que regulan el cortisol";
"learning.card.food.section1.title" = "Alimentos que REDUCE cortisol";
"learning.card.food.section1.content" = "Grasas saludables:\n• Aguacate, nueces, almendras\n• Aceite de oliva, pescado graso (salmón, caballa)\n• Rico en omega-3 antiinflamatorio\n\nAlimentos ricos en magnesio:\n• Chocolate oscuro (conjunto70% de cacao)\n• Espinacas, bananas\n• semillas de calabaza, almendras\n• El magnesio reduce la ansiedad y el cortisol\n\nVitamina C:\n• Frutas cítricas, kiwis, pimientos\n• Reduce el cortisol en 15-20%\n• Fortalece el sistema inmunitario\n\nTé verde y negro:\n• L-theanine que calma la mente\n• 20% de reducción en cortisol después de 6 semanas";
"learning.card.food.section2.title" = "Alimentos que INCREASE cortisol";
"learning.card.food.section2.content" = "Exceso de cafeína:\n• Más de 400 mg/día (4 cafés)\n• Aumenta el cortisol en un 30%\n• Dormir perturbado\n\nAzúcares refinados:\n• Puntos de azúcar en la sangre = picos de cortisol\n• Inflamación sistémica\n• Adicción y antojos\n\nAlcohol:\n• Trastornos de sueño profundo\n• Aumenta el cortisol nocturno\n• Deshidratación";
"learning.card.food.section3.title" = "Cuestiones relativas al calendario";
"learning.card.food.section3.content" = "• Desayuno rico en proteínas (estabiliza el cortisol)\n• Evite los azúcares y la cafeína por la noche\n• Cena ligera 2-3 horas antes de la cama";

