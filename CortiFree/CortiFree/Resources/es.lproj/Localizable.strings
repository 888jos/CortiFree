"learning.card.cardiac_coherence.section1.content" = "La coherencia cardíaca es una técnica de respiración que sincroniza su ritmo cardíaco con su cerebro para un poderoso efecto antiestrés.\n\n• Respiración: 6 ciclos por minuto (5 sec inhale, 5 sec exhale)\n• Duración: 5 minutos\n• Frecuencia: 3 veces al día (mañana, mediodía, noche)\n• Es el método 365: 3 veces/día, 6 respiraciones/min, 5 minutos";
"learning.card.cardiac_coherence.section2.title" = "Beneficios inmediatos";
"learning.card.cardiac_coherence.section2.content" = "• Reducción de cortisol en 3-5 minutos\n• Menor frecuencia cardíaca\n• Baja presión arterial\n• Sentimiento de calma y claridad mental";
"learning.card.cardiac_coherence.section3.title" = "Efectos a largo plazo (después de 2 semanas)";
"learning.card.cardiac_coherence.section3.content" = "• -24% de cortisol en promedio\n• Mejor regulación emocional\n• Mejora de la calidad del sueño\n• Sistema inmunitario reforzado\n• +17% DHEA (hormona anti-envejecimiento)";
"learning.card.cardiac_coherence.section4.title" = "Usado por";
"learning.card.cardiac_coherence.section4.content" = "• Pilotos de combate\n• Deportistas de élite\n• Médicos y trabajadores sanitarios\n• Ejecutivos de negocios";
"learning.card.cardiac_coherence.section5.title" = "En CortiFree";
"learning.card.cardiac_coherence.section5.content" = "El ejercicio \"5-5 Coherencia Cardiaca\" en la sección Respiración sigue exactamente este método científico.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "Yoga y flexibilidad mental";
