"breathing.ex.coherence.title" = "Coherencia cardíaca 5-5";
"breathing.ex.coherence.benefit" = "6 respiraciones por minuto para equilibrar tu sistema nervioso y bajar el cortisol.";
"breathing.ex.coherence.when" = "Tres veces al día (mañana, antes de comer, final de la tarde) o cuando el estrés aumente. La regla 3-6-5: 3 veces al día, 6 respiraciones por minuto, 5 minutos.";
"breathing.ex.coherence.science" = "Respirar a unas 6 respiraciones por minuto sincroniza corazón y respiración (resonancia), aumentando la variabilidad cardíaca y el tono vagal. La práctica regular se asocia con menos cortisol por la tarde.";
"breathing.ex.extended_exhale.title" = "Exhalación larga 4-8";
"breathing.ex.extended_exhale.benefit" = "Exhala el doble de lo que inhalas para activar el freno natural del estrés.";
"breathing.ex.extended_exhale.when" = "Cuando te sientas tenso, irritado o con la mente acelerada. Funciona en cualquier lugar, incluso con los ojos abiertos.";
"breathing.ex.extended_exhale.science" = "La exhalación ralentiza el corazón a través del nervio vago. Alargarla más que la inhalación inclina el equilibrio hacia el sistema parasimpático en pocos minutos.";
"breathing.ex.deep_abdominal.title" = "Respiración abdominal 4-2-6";
"breathing.ex.deep_abdominal.benefit" = "La base: respira hacia el vientre para soltar tensiones.";
"breathing.ex.deep_abdominal.when" = "Ideal para empezar o para hacer una pausa entre tareas. Pon una mano en el vientre y siente cómo se eleva.";
"breathing.ex.deep_abdominal.science" = "La respiración diafragmática reduce la frecuencia respiratoria y la tensión muscular. Los estudios muestran menos cortisol y mejor atención tras unas semanas.";
"breathing.ex.humming.title" = "Respiración de la abeja 4-7";
"breathing.ex.humming.benefit" = "Tararea suavemente al exhalar: la vibración calma y alarga la respiración.";
"breathing.ex.humming.when" = "Cuando tu mente está ruidosa o antes de una conversación difícil. Con la boca cerrada, haz un suave «mmm» durante toda la exhalación.";
"breathing.ex.humming.science" = "El tarareo (Bhramari) alarga la exhalación y estimula el nervio vago por la vibración de la garganta. También aumenta el óxido nítrico nasal.";
"breathing.ex.physiological_sigh.title" = "Suspiro fisiológico";
"breathing.ex.physiological_sigh.benefit" = "Dos inhalaciones por la nariz y una exhalación larga: la forma más rápida de calmarte.";
"breathing.ex.physiological_sigh.when" = "En un pico de estrés, antes de una reunión, tras una mala noticia. De 1 a 3 suspiros ya ayudan; de 1 a 5 minutos para un efecto duradero.";
"breathing.ex.physiological_sigh.science" = "La segunda inhalación corta reabre los alvéolos colapsados y la exhalación larga elimina CO2. Un estudio de Stanford (2023) halló que 5 minutos al día mejoran el ánimo más que la meditación mindfulness.";
"breathing.ex.sos_214.title" = "SOS pánico 2-1-4";
"breathing.ex.sos_214.benefit" = "Un ritmo corto y fácil para recuperar el control ante la ansiedad o el pánico.";
"breathing.ex.sos_214.when" = "Cuando te falta el aire o sube una ola de pánico. Los ciclos cortos son fáciles de seguir aunque estés desbordado; luego pasa a la exhalación larga.";
"breathing.ex.sos_214.science" = "En pleno pánico, los ciclos largos parecen imposibles. Una inhalación corta con una exhalación el doble de larga limita la hiperventilación y estabiliza el CO2, aliviando mareos y hormigueos.";
"breathing.ex.four_seven_eight.title" = "4-7-8 para dormir";
"breathing.ex.four_seven_eight.benefit" = "La respiración relajante para dormirte más rápido.";
"breathing.ex.four_seven_eight.when" = "En la cama con la luz apagada o al despertarte de noche. Empieza con pocos ciclos y aumenta poco a poco.";
"breathing.ex.four_seven_eight.science" = "La retención larga y la exhalación muy larga ralentizan el corazón y calman la mente. Los estudios muestran menos ansiedad y un sueño más fácil.";
"breathing.ex.sleep_wave.title" = "Ola del sueño 4-6-2";
"breathing.ex.sleep_wave.benefit" = "Una ola suave que te ralentiza hasta que llega el sueño.";
"breathing.ex.sleep_wave.when" = "En la cama, de 5 a 15 minutos. Deja que la pausa tras la exhalación sea pesada y suave.";
"breathing.ex.sleep_wave.science" = "Bajar a unas 5 respiraciones por minuto con una pausa a pulmón vacío reduce la activación y facilita la transición al sueño.";
"breathing.ex.slow66.title" = "Respiración lenta 6-6";
"breathing.ex.slow66.benefit" = "5 respiraciones por minuto para una calma profunda y duradera.";
"breathing.ex.slow66.when" = "Para desconectar por la noche, tras un día intenso o antes de meditar.";
"breathing.ex.slow66.science" = "Respirar a 5 o 6 ciclos por minuto maximiza la variabilidad cardíaca y la sensibilidad del barorreflejo, marcadores de resiliencia al estrés.";
"breathing.ex.box.title" = "Respiración cuadrada 4-4-4-4";
"breathing.ex.box.benefit" = "El ritmo en cuatro tiempos de los equipos de élite para mantener la calma bajo presión.";
"breathing.ex.box.when" = "Antes de un examen, una presentación, una competición o cualquier momento de presión.";
"breathing.ex.box.science" = "Fases iguales con breves retenciones regulan el CO2 y anclan la atención en el conteo: menos activación, sin perder el estado de alerta.";
"breathing.ex.triangle.title" = "Triángulo 4-4-4";
"breathing.ex.triangle.benefit" = "Tres fases iguales para despejar la mente y volver a enfocarte.";
"breathing.ex.triangle.when" = "Cuando pierdes la concentración o antes de una sesión de trabajo profundo.";
"breathing.ex.triangle.science" = "Un ritmo estable ancla la atención en la respiración y la ralentiza suavemente sin producir somnolencia.";
"breathing.ex.alternate_nostril.title" = "Respiración alterna";
"breathing.ex.alternate_nostril.benefit" = "Respira por una fosa nasal cada vez para reequilibrarte y centrarte.";
"breathing.ex.alternate_nostril.when" = "Antes de un trabajo que requiera concentración o para calmar la agitación. Tapa una fosa con el pulgar, la otra con el anular, y sigue la guía.";
"breathing.ex.alternate_nostril.science" = "La respiración alterna (Nadi Shodhana) se ha asociado con menor frecuencia cardíaca y presión arterial y mejor atención en varios estudios controlados.";
"breathing.ex.energize.title" = "Energizante 4-2";
"breathing.ex.energize.benefit" = "Inhalación larga, exhalación rápida: un impulso natural sin café.";
"breathing.ex.energize.when" = "Por la mañana, después de comer o en un bajón de energía. De 1 a 3 minutos bastan.";
"breathing.ex.energize.science" = "Enfatizar la inhalación activa ligeramente el sistema simpático y aumenta el estado de alerta. Detente si te mareas.";
"breathing.ex.kapalabhati.title" = "Kapalabhati";
"breathing.ex.kapalabhati.benefit" = "Exhalaciones cortas y activas desde el vientre para despertar cuerpo y mente.";
"breathing.ex.kapalabhati.when" = "Por la mañana en ayunas, sentado con la espalda recta. Evítalo durante el embarazo, con hipertensión o problemas cardíacos.";
"breathing.ex.kapalabhati.science" = "La respiración abdominal rápida aumenta brevemente la alerta y la energía. Haz sesiones cortas y vuelve después a una respiración tranquila.";

