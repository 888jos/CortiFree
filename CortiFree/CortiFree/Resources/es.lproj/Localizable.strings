// MARK: - Learning Card 12: Sleep and cortisol
"learning.card.sleep_cortisol.title" = "Sueño y cortisol";
"learning.card.sleep_cortisol.description" = "La importancia de un buen ritmo circadiano";
"learning.card.sleep_cortisol.section1.title" = "El ritmo natural";
"learning.card.sleep_cortisol.section1.content" = "Tu sueño y tu nivel de cortisol están íntimamente ligados:\n\n• Cortisol alto por la mañana (para despertarte)\n• Cortisol bajo por la noche (para dormir)";
"learning.card.sleep_cortisol.section2.title" = "Cuando sale mal";
"learning.card.sleep_cortisol.section2.content" = "• Sueño alterado → Cortisol alto 24/7\n• Círculo vicioso: estrés → mal sueño → más estrés";
"learning.card.sleep_cortisol.section3.title" = "Soluciones CortiFree";
"learning.card.sleep_cortisol.section3.content" = "• Despertarte antes de las 7 h (rutina matutina)\n• Acostarte antes de las 23 h (recuperación)\n• Meditación nocturna (preparación para el sueño)";
"learning.card.sleep_cortisol.section4.title" = "¿Lo sabías?";
"learning.card.sleep_cortisol.section4.content" = "¡Una sola noche de mal sueño puede aumentar tu cortisol un 37% al día siguiente!";

// MARK: - Learning Card 13: Hydration
"learning.card.hydration.title" = "Hidratación y estrés";
"learning.card.hydration.description" = "Por qué beber agua reduce el estrés";
"learning.card.hydration.section1.title" = "Efectos de deshidratación";
"learning.card.hydration.section1.content" = "El agua desempeña un papel crucial en la regulación del estrés:\n\n• Mayor cortisol (+25%)\n• Fatiga e irritabilidad\n• Dificultad para concentrarse";
"learning.card.hydration.section2.title" = "Beneficios de buena hidratación";
"learning.card.hydration.section2.content" = "• Regulación de la temperatura corporal\n• Eliminación de toxinas\n• Mejor función cerebral";
"learning.card.hydration.section3.title" = "Recomendación";
"learning.card.hydration.section3.content" = "• Mínimo 2 L de agua al día\n• Más si haces actividad física\n• Repartidos a lo largo del día";
"learning.card.hydration.section4.title" = "Consejo";
"learning.card.hydration.section4.content" = "¡Empieza tu día con un gran vaso de agua para despertar tu metabolismo!";

// MARK: - Learning Card 14: Physical exercise
"learning.card.exercise.title" = "Ejercicio físico antiestrés";
"learning.card.exercise.description" = "Cómo el deporte regula el cortisol";
"learning.card.exercise.section1.title" = "Efectos sobre el cortisol";
"learning.card.exercise.section1.content" = "La actividad física es un regulador de estrés natural:\n\n• A corto plazo: ligero aumento (normal)\n• A largo plazo: disminución significativa del cortisol de base";
"learning.card.exercise.section2.title" = "Beneficios adicionales";
"learning.card.exercise.section2.content" = "• La liberación de endorfinas (hormonas de felicidad)\n• El sueño mejorado\n• Mejor autoestima";
"learning.card.exercise.section3.title" = "Duración ideal";
"learning.card.exercise.section3.content" = "• 20-30 min por sesión\n• 3-5 veces por semana\n• Intensidad moderada";
"learning.card.exercise.section4.title" = "Precaución";
"learning.card.exercise.section4.content" = "El ejercicio demasiado intenso puede aumentar el cortisol. ¡El equilibrio es clave!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "Relaciones sociales positivas";
"learning.card.social.description" = "La importancia del apoyo social";
"learning.card.social.section1.title" = "Impacto en el cortisol";
"learning.card.social.section1.content" = "Las conexiones sociales de calidad son esenciales para manejar el estrés:\n\n• Interacciones positivas → -20% cortisol\n• Liberación de la oxitocina (\"hormona del amor\")\n• Sentimiento de seguridad y pertenencia";
"learning.card.social.section2.title" = "Tipos de conexiones beneficiosas";
"learning.card.social.section2.content" = "• Conversaciones profundas con amigos\n• Momentos de calidad con familia\n• Actividades de grupo (deportes, hobbies)";
"learning.card.social.section3.title" = "Para evitar";
"learning.card.social.section3.content" = "• Aislamiento prolongado\n• Relaciones tóxicas o conflictivas";
"learning.card.social.section4.title" = "¿Lo sabías?";
"learning.card.social.section4.content" = "¡Un simple abrazo de 20 segundos puede reducir significativamente tu nivel de estrés!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "Exposición a la luz natural";
"learning.card.light.description" = "Regula tu reloj biológico";
"learning.card.light.section1.title" = "La importancia de la mañana";
"learning.card.light.section1.content" = "La luz natural desempeña un papel crucial en la regulación de tu cortisol y tu ritmo circadiano:\n\n• Exponte a la luz en los 30-60 min posteriores a despertarte\n• Mínimo 10-30 minutos al aire libre (incluso en días nublados)\n• Activa la producción de cortisol matinal (normal y beneficiosa)\n• Detiene la producción de melatonina (hormona del sueño)";
"learning.card.light.section2.title" = "Impacto en tu reloj biológico";
"learning.card.light.section2.content" = "• Regula el ciclo de cortisol/melatonina\n• Mejora la calidad del sueño nocturno\n• Aumenta la energía diurna y la alerta\n• Sincroniza todos tus ritmos biológicos";
"learning.card.light.section3.title" = "Estudios científicos";
"learning.card.light.section3.content" = "• +25% de energía diurna con exposición matinal\n• Te duermes 1 hora antes por la noche\n• -35% de síntomas depresivos\n• Mejor regulación del apetito";
"learning.card.light.section4.title" = "Por la noche, evite";
"learning.card.light.section4.content" = "• Pantallas 1-2 horas antes de acostarte\n• Luces brillantes (mejor luces cálidas/tenues)\n• Luz azul que bloquea la melatonina";
"learning.card.light.section5.title" = "Consejo CortiFree";
"learning.card.light.section5.content" = "¡Combina tu caminata matutina con la exposición a la luz natural para multiplicar el efecto sobre tu energía y tu estrés!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "Pensamientos negativos automáticos";
"learning.card.negative_thoughts.description" = "Identificar y reemplazar patrones tóxicos";
"learning.card.negative_thoughts.section1.title" = "Los 7 tipos de pensamientos tóxicos";
"learning.card.negative_thoughts.section1.content" = "Tus pensamientos influyen directamente en tu nivel de estrés y de cortisol. Aprender a identificar y modificar los pensamientos negativos automáticos es crucial.\n\n1️⃣ Catastrofismo: \"Si suspendo este examen, mi vida se acabó\"\n→ Realidad: Un fracaso no es el fin\n\n2️⃣ Pensamiento de todo o nada: \"Si no es perfecto, es un fracaso\"\n→ Realidad: La vida está hecha de matices\n\n3️⃣ Sobregeneralización: \"Fallé una vez, siempre fallo\"\n→ Realidad: Una situación ≠ todas las situaciones\n\n4️⃣ Filtro mental: Ignorar lo positivo, centrarse en lo negativo\n→ Realidad: Busca también lo que va bien\n\n5️⃣ Lectura de mente: \"Creen que soy incompetente\"\n→ Realidad: No puedes leer mentes\n\n6️⃣ Personalización: \"Seguro que es culpa mía\"\n→ Realidad: No todo depende de ti\n\n7️⃣ Obligaciones tiránicas: \"DEBO ser perfecto\"\n→ Realidad: Nadie es perfecto";
"learning.card.negative_thoughts.section2.title" = "La técnica de 3 columnas";
"learning.card.negative_thoughts.section2.content" = "Columna 1: Situación\nColumna 2: Pensamiento automático\nColumna 3: Pensamiento alternativo realista";
"learning.card.negative_thoughts.section3.title" = "Impacto mensurable";
"learning.card.negative_thoughts.section3.content" = "• -40% de ansiedad con terapia cognitiva\n• -28% de cortisol identificando y modificando estos pensamientos\n• Mejora duradera después de 8-12 semanas";
"learning.card.negative_thoughts.section4.title" = "Consejo de diario";
"learning.card.negative_thoughts.section4.content" = "¡Escribir tus pensamientos en el diario de CortiFree te ayuda a identificarlos, cuestionarlos y transformarlos!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "Gratitud y cerebro";
"learning.card.gratitude.description" = "El efecto científico del reconocimiento";
"learning.card.gratitude.section1.title" = "Lo que pasa en tu cerebro";
"learning.card.gratitude.section1.content" = "Practicar la gratitud no es solo \"pensamiento positivo\": es una técnica científicamente validada que modifica tu cerebro y tu nivel de estrés.\n\n• Activación de la corteza prefrontal medial (bienestar)\n• Liberación de dopamina y serotonina (felicidad)\n• Menor actividad de la amígdala (estrés/miedo)\n• -23% de cortisol en promedio";
"learning.card.gratitude.section2.title" = "Principales estudios científicos";
"learning.card.gratitude.section2.content" = "UC Berkeley (2015):\n• Diario de gratitud 3x/semana\n• -27% de depresión después de 12 semanas\n• Mejor sueño y relaciones sociales\n\nHarvard Medical School (2021):\n• 5 minutos de gratitud al día\n• +25% de felicidad percibida\n• -18% de ansiedad";
"learning.card.gratitude.section3.title" = "Cómo practicar eficazmente";
"learning.card.gratitude.section3.content" = "Método de las 3 gratitudes (5 min/día):\n1. Escribe 3 cosas por las que estás agradecido\n2. Sé específico (no solo \"mi familia\")\n3. Siente la emoción mientras escribes\n4. Varía tus gratitudes cada día\n\nEjemplos:\nDemasiado vago: \"Estoy agradecido por mi salud\"\nEspecífico: \"Estoy agradecido de haber podido hacer mi caminata matutina sin dolor y sentir el aire fresco en la cara\"";
"learning.card.gratitude.section4.title" = "Efectos a largo plazo";
"learning.card.gratitude.section4.content" = "Después de 4 semanas:\n• Cambios medibles en el cerebro\n• Mejor calidad del sueño\n• Más emociones positivas\n\nDespués de 12 semanas:\n• Un nuevo nivel base de felicidad más alto\n• Mayor resiliencia frente al estrés\n• Mejores relaciones interpersonales";
"learning.card.gratitude.section5.title" = "Integrado en CortiFree";
"learning.card.gratitude.section5.content" = "El diario te permite anotar tus gratitudes diarias. ¡Esta sencilla práctica de 2-3 minutos puede transformar tu relación con el estrés!";
"learning.card.gratitude.section6.title" = "Importante";
"learning.card.gratitude.section6.content" = "La gratitud no niega problemas, entrena a tu cerebro para ver también lo positivo en lugar de centrarse sólo en lo negativo.";

