// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "Rutina matutina antiestrés";
"tips.card.morning_routine.short_description" = "Empieza tu día con buen pie";
"tips.card.morning_routine.section1.title" = "Por qué es importante";
"tips.card.morning_routine.section1.content" = "Los primeros 60 minutos de tu día determinan tu nivel de cortisol para todo el día.";
"tips.card.morning_routine.section2.title" = "La rutina ideal (60 min)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: Despertar e hidratación\n• Bebe 500 ml de agua al despertar\n• Rehidrata tu cuerpo después de 8 h de sueño\n• Activa tu metabolismo\n\n6:15-6:30: Exposición a la luz\n• Sal afuera o acércate a una ventana\n• 15-30 min de luz natural\n• Detiene la melatonina, activa el cortisol matutino saludable\n\n6:30-6:45: Movimiento suave\n• Estiramientos, yoga suave o caminar\n• Despierta el cuerpo con suavidad\n• Libera endorfinas\n\n6:45-7:00: Práctica de atención plena\n• 5-10 min de meditación o respiración\n• Coherencia cardíaca\n• Define tu intención para el día";
"tips.card.morning_routine.section3.title" = "A EVITAR en los primeros 60 minutos";
"tips.card.morning_routine.section3.content" = "• Teléfono/emails/redes sociales\n• Noticias (a menudo negativas)\n• Situaciones estresantes\n• Cafeína antes de hidratarte";
"tips.card.morning_routine.section4.title" = "Por qué funciona";
"tips.card.morning_routine.section4.content" = "Esta rutina sincroniza tu ritmo circadiano, optimiza tu pico de cortisol matinal (beneficioso) y te pone en un estado mental positivo para el día.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "Ritual óptimo para dormir";
"tips.card.sleep_ritual.short_description" = "Prepara tu cuerpo y tu mente para descansar";
"tips.card.sleep_ritual.section1.title" = "El ritual perfecto";
"tips.card.sleep_ritual.section1.content" = "Un buen sueño empieza 90 minutos antes de acostarte.\n\n21:30: Bajar la luz\n• Atenúa las luces de la casa\n• Activa el modo nocturno en el teléfono/ordenador\n• Solo luces cálidas\n\n21:45: Apagar pantallas\n• Nada de teléfono, TV ni ordenador\n• Lee un libro de papel en su lugar\n• La luz azul bloquea la melatonina\n\n22:00: Higiene y rutina\n• Ducha tibia (no caliente)\n• Rutina de cuidado facial y dental\n• Prepara la ropa de mañana\n\n22:15: Actividad relajante\n• Lectura ligera (¡nada de thrillers!)\n• Diario/gratitudes\n• Meditación o respiración suave\n• Estiramientos ligeros\n\n22:30: Preparar la habitación\n• Temperatura fresca (18-19 °C)\n• Oscuridad total (cortinas opacas)\n• Silencio (tapones para los oídos si hace falta)\n\n22:45-23:00: Hora de dormir\n• Siempre a la misma hora\n• Incluso los fines de semana\n• Constancia = mejor sueño";
"tips.card.sleep_ritual.section2.title" = "Consejos adicionales";
"tips.card.sleep_ritual.section2.content" = "• Sin ejercicio intenso después de las 8 PM\n• Última comida 2-3h antes de acostarse\n• Evite el alcohol y la cafeína después de las 4 PM\n• Dormitorio reservado para dormir (sin trabajo)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "Gestión del estrés en el trabajo";
"tips.card.work_stress.short_description" = "Estrategias para permanecer zen en la oficina";
"tips.card.work_stress.section1.title" = "Micropausas cada hora";
"tips.card.work_stress.section1.content" = "• 2 min de respiración profunda\n• Estiramientos en la oficina\n• Mira a lo lejos (relaja los ojos)\n• Camina unos pasos";
"tips.card.work_stress.section2.title" = "Priorización inteligente";
"tips.card.work_stress.section2.content" = "Matriz de Eisenhower:\n• Urgente + Importante = Hacer ahora\n• Importante + No urgente = Planificar\n• Urgente + No importante = Delegar\n• No urgente + No importante = Eliminar\n\nMétodo 1-3-5:\n• 1 tarea principal al día\n• 3 tareas medianas\n• 5 tareas pequeñas";
"tips.card.work_stress.section3.title" = "Gestión de interrupciones";
"tips.card.work_stress.section3.content" = "• Modo concentración: 90 min sin interrupciones\n• Desactiva las notificaciones no urgentes\n• Franjas de \"puerta abierta\" para los compañeros\n• Correo: revisarlo 3 veces al día como máximo";
"tips.card.work_stress.section4.title" = "Decir no con diplomacia";
"tips.card.work_stress.section4.content" = "\"Me gustaría ayudarte, pero ya me he comprometido con [X]. Puedo proponerte [alternativa] o estar disponible a partir del [fecha].\"\n\nTu tiempo es precioso. Protégelo.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "Nutrición diaria contra el estrés";
"tips.card.nutrition.short_description" = "Comidas y aperitivos que calman";
"tips.card.nutrition.section1.title" = "Desayuno ideal";
"tips.card.nutrition.section1.content" = "Proteína + Grasas saludables + fibra:\n\nOpción 1: Huevos + Aguacate + Pan integral\nOpción 2: yogur griego + nueces + bayas\nOpción 3: Smoothie (banana, espinacas, mantequilla de almendra, leche vegetal)\n\nPor qué: Estabiliza el azúcar en la sangre y el cortisol toda la mañana.";
"tips.card.nutrition.section2.title" = "Meriendas antiestrés";
"tips.card.nutrition.section2.content" = "Cuando aprieta el hambre (10 h o 16 h):\n\n• Almendras (15-20) + 1 onza de chocolate negro\n• Manzana + Mantequilla de almendra\n• Yogur natural + Arándanos\n• Hummus + Bastoncitos de verdura\n• Plátano + Unas cuantas nueces\n\nEvitar: Barritas procesadas, bollería, refrescos";
"tips.card.nutrition.section3.title" = "Hidratación inteligente";
"tips.card.nutrition.section3.content" = "• 2 L de agua/día como mínimo\n• Infusiones relajantes (manzanilla, verbena, tila)\n• Té verde (L-teanina antiestrés)\n• Agua con limón por la mañana\n\nLimitar:\n• Café: máx. 2-3 al día, no después de las 14 h\n• Alcohol: máx. 1 copa/día\n• Refrescos: solo ocasionalmente";
"tips.card.nutrition.section4.title" = "Cena ligera";
"tips.card.nutrition.section4.content" = "2-3 h antes de acostarte:\n\n• Verduras + Proteínas magras (pescado, pollo, tofu)\n• Carbohidratos complejos en pequeñas cantidades (arroz, quinoa)\n• Evita fritos, platos pesados, especias fuertes\n• Infusión digestiva después de la comida";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "Gestión de emociones difíciles";
"tips.card.emotions.short_description" = "Técnicas emocionales de emergencia";
"tips.card.emotions.section1.title" = "Técnica 4-7-8 (emergencia de ansiedad)";
"tips.card.emotions.section1.content" = "1. Exhala completamente a través de la boca (whoosh)\n2. Inhala a través de la nariz contando a 4\n3. Mantenga la respiración contando a 7\n4. Exhala a través de la boca contando a 8\n\nRepita 4 ciclos.\nEfecto: Activa el sistema parasimpático, se calma en 90 segundos.";
"tips.card.emotions.section2.title" = "Técnica 5-4-3-2-1 (anclaje en el presente)";
"tips.card.emotions.section2.content" = "Cuando te sientas abrumado, nombra en voz alta:\n\n• 5 cosas que VES a tu alrededor\n• 4 cosas que TOCAS\n• 3 cosas que OYES\n• 2 cosas que HUELES\n• 1 cosa que SABOREAS\n\nLleva tu mente al momento presente y detiene la espiral ansiosa.";
"tips.card.emotions.section3.title" = "Diario emocional";
"tips.card.emotions.section3.content" = "Cuando llegue una emoción fuerte, escribe:\n\n1. ¿Qué emoción es? (nombre exacto)\n2. ¿Dónde la sientes en tu cuerpo?\n3. ¿Qué pensamiento la provocó?\n4. ¿Este pensamiento es un hecho o una interpretación?\n5. ¿Cuál sería un pensamiento alternativo más realista?\n\nEscribir = Procesar la emoción en lugar de rumiar.";
"tips.card.emotions.section4.title" = "Movimiento liberador";
"tips.card.emotions.section4.content" = "Emoción = energía atrapada en el cuerpo.\n\n• Camina a paso ligero 10-15 min\n• Sacude los brazos/piernas con energía\n• Baila con música enérgica\n• Estiramientos profundos\n• Grita contra una almohada (si hace falta)\n\nEl cuerpo DEBE liberar el estrés físicamente.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "Atención plena diaria";
"tips.card.mindfulness.short_description" = "Integra la atención plena en todas partes";
"tips.card.mindfulness.section1.title" = "Atención plena con el café/té";
"tips.card.mindfulness.section1.content" = "En lugar de beber sin prestar atención:\n\n1. Observa el color del líquido\n2. Huele profundamente el aroma\n3. Siente el calor de la taza en tus manos\n4. Toma un sorbo pequeño y déjalo en la boca\n5. Nota el sabor, la textura, la temperatura\n6. Siente el calor bajando\n\n5 minutos de presencia pura.";
"tips.card.mindfulness.section2.title" = "Caminar con atención plena";
"tips.card.mindfulness.section2.content" = "Transforma cualquier caminata en meditación:\n\n• Siente el contacto de tu pie con el suelo a cada paso\n• Observa el movimiento de tus brazos\n• Observa lo que ves sin juzgar\n• Escucha los sonidos que te rodean\n• Siente el aire en tu piel, el viento en tu cabello\n\n5-10 min bastan para restablecer tu mente.";
"tips.card.mindfulness.section3.title" = "Ducha consciente";
"tips.card.mindfulness.section3.content" = "• Siente la temperatura del agua\n• Observa las gotas que corren por tu piel\n• Céntrate en las sensaciones corporales\n• Observa el sonido del agua\n• Huele el jabón / champú\n\nCada actividad diaria = oportunidad de meditación.";
"tips.card.mindfulness.section4.title" = "Comer con atención plena";
"tips.card.mindfulness.section4.content" = "Mínimo 1 comida al día sin distracciones:\n\n• Sin teléfono, TV ni ordenador\n• Observa tu plato (colores, texturas)\n• Huele los aromas\n• Mastica despacio (20-30 veces por bocado)\n• Nota los sabores, las texturas\n• Deja el tenedor entre bocado y bocado\n\nMejor digestión + Saciedad natural + Momento de calma";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "Comunicación no violenta";
"tips.card.nvc.short_description" = "Expresa tus necesidades sin conflicto";
"tips.card.nvc.section1.title" = "Los 4 pasos de la CNV";
"tips.card.nvc.section1.content" = "1. OBSERVACIÓN (hecho objetivo)\n\"Cuando llegas tarde a las citas...\"\n(NO \"Siempre llegas tarde\" = juicio)\n\n2. SENTIMIENTO (tu emoción)\n\"...me siento estresado y frustrado...\"\n(NO \"Me estresas\" = acusación)\n\n3. NECESIDAD (lo que necesitas)\n\"...porque necesito poder contar con nuestros compromisos...\"\n\n4. PETICIÓN (acción concreta)\n\"...¿podrías enviarme un mensaje si vas a llegar tarde?\"\n(NO \"Tienes que ser puntual\" = orden)";
"tips.card.nvc.section2.title" = "Escucha activa";
"tips.card.nvc.section2.content" = "Cuando alguien te habla:\n\n• Deja lo que estás haciendo\n• Mira a la persona a los ojos\n• No prepares tu respuesta mientras habla\n• Reformula para verificar que has entendido\n• Valida la emoción antes de dar consejos\n\n\"Si lo entiendo bien, ¿te sientes [emoción] porque [situación]?\"";
"tips.card.nvc.section3.title" = "Manejo de la crítica";
"tips.card.nvc.section3.content" = "• Respira hondo antes de responder\n• Busca la parte de verdad (aunque sea pequeña)\n• Agradece el comentario\n• Pide aclaraciones si hace falta\n• Toma distancia antes de decidir qué hacer\n\n\"Gracias por decírmelo. ¿Puedes darme un ejemplo concreto?\"\n\nNo tomárselo como algo personal ≠ Permitir malos tratos";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "Cultivar relaciones positivas";
"tips.card.positive_relations.short_description" = "Fortalece tus vínculos sociales";
"tips.card.positive_relations.section1.title" = "Rituales de conexión";
"tips.card.positive_relations.section1.content" = "• 1 videollamada/semana con un ser querido\n• 1 café/comida en persona por semana\n• Mensaje para saber cómo están a 2-3 amigos/semana\n• Actividad de grupo mensual (deporte, hobby)\n\nCalidad > cantidad, pero la constancia importa.";
"tips.card.positive_relations.section2.title" = "Expresando gratitud";
"tips.card.positive_relations.section2.content" = "Al menos una vez al día, dile a alguien:\n\n\"Aprecio mucho que [acción concreta]. Me hizo sentir [emoción positiva].\"\n\nEjemplos:\n• \"Gracias por escuchar mis preocupaciones ayer. Me sentí comprendido.\"\n• \"Aprecio que hayas pensado en mí. Me hizo sonreír.\"\n\nFortalece los lazos + Libera oxitocina (hormona de la felicidad)";
"tips.card.positive_relations.section3.title" = "Identificar relaciones tóxicas";
"tips.card.positive_relations.section3.content" = "Señales de alarma:\n\n• Te sientes agotado después de las interacciones\n• Crítica constante, nunca apoyo\n• Vampirismo emocional (siempre ellos, nunca tú)\n• Manipulación o chantaje emocional\n• Ningún respeto por tus límites\n\nAcción: Distanciamiento progresivo o conversación franca.\nTienes derecho a proteger tu energía.";
"tips.card.positive_relations.section4.title" = "Solicitar apoyo";
"tips.card.positive_relations.section4.content" = "Pedir ayuda ≠ debilidad:\n\n\"Necesito ayuda con [situación]. ¿Tendrías [tiempo/conocimientos] para ayudarme?\"\n\nO simplemente:\n\"Estoy pasando por un momento difícil. ¿Podemos tomar un café para hablarlo?\"\n\nLa gente quiere ayudar, pero no siempre sabe cómo. Sé específico.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "Productividad sin estrés";
"tips.card.productivity.short_description" = "Eficiente y zen";
"tips.card.productivity.section1.title" = "Técnica de Pomodoro adaptada";
"tips.card.productivity.section1.content" = "Trabajo en sesiones:\n\n• 25 minutos de enfoque total en UNA tarea\n• 5 minutos de descanso (caminar, estirar, respirar)\n• Repetir 4 veces\n• Larga pausa de 20-30 min\n\nNormas:\n• temporizador visible\n• Teléfono en modo de avión\n• Notificaciones desactivadas\n• Si se interrumpe = restablecer el Pomodoro\n\nResultado: 4h de trabajo real es mejor que 8h de distracción.";
"tips.card.productivity.section2.title" = "Trabajando con tu cerebro";
"tips.card.productivity.section2.content" = "Cada cerebro tiene sus picos de energía:\n\nPersonas matutinas (madrugadores):\n• 8-12 h: Tareas complejas/creativas\n• 14-16 h: Tareas rutinarias\n• Después de las 16 h: Organización/emails\n\nPersonas nocturnas (trasnochadores):\n• Mañana: Rutina/emails\n• 14-18 h: Tareas complejas\n• Noche: Creatividad/proyectos\n\nIdentifica TU ritmo y adapta tu horario.";
"tips.card.productivity.section3.title" = "Lista de 'Hecho' además de la de 'Por hacer'";
"tips.card.productivity.section3.content" = "Al final del día, escribe lo que HICISTE:\n\n• Valida tus logros\n• Combate el síndrome del impostor\n• Muestra el progreso realizado\n• Aumenta la confianza en ti mismo\n\nTu cerebro recuerda lo negativo (sesgo de negatividad).\nOblígalo a ver lo positivo.";
"tips.card.productivity.section4.title" = "El arte de 'casi perfecto'";
"tips.card.productivity.section4.content" = "Perfeccionismo = Gran fuente de estrés.\n\nRegla 80/20 (Pareto):\n• El 80% del resultado proviene del 20% del esfuerzo\n• El 20% restante del resultado requiere un 80% de esfuerzo adicional\n\nPregunta: \"¿Este último 20% realmente vale mi tiempo y mi estrés?\"\n\nA menudo, \"suficientemente bueno\" ES perfecto.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "Optimiza tu entorno";
"tips.card.environment.short_description" = "Espacio de vida antiestrés";
"tips.card.environment.section1.title" = "Ordenar (regla KonMari adaptada)";
"tips.card.environment.section1.content" = "1 zona/semana:\n\nToma cada objeto y pregúntate:\n• ¿Lo he usado en los últimos 6 meses?\n• ¿Me trae alegría?\n• ¿Es realmente útil?\n\nSi 3x no → Donar, reciclar o basura.\n\nDispersión visual = Sobrecarga mental.\nEspacio claro = mente clara.";
"tips.card.environment.section2.title" = "Plantas interiores";
"tips.card.environment.section2.content" = "Top 5 antiestrés de fácil cuidado:\n\n1. Poto (aire + estrés)\n2. Sansevieria (oxigena por la noche)\n3. Aloe vera (purifica el aire)\n4. Cinta (fácil, eficaz)\n5. Lavanda (aroma calmante)\n\nBeneficios demostrados:\n• -15% de cortisol\n• Mejor calidad del aire\n• Efecto visual relajante";
"tips.card.environment.section3.title" = "Máxima luz natural";
"tips.card.environment.section3.content" = "• Cortinas abiertas al despertar\n• Escritorio cerca de la ventana si es posible\n• Bombillas diurnas (5000-6500K) por la mañana\n• Bombillas calientes (2700-3000K) por la noche\n• Dimmers de luz en dormitorios\n\nLuz = #1 regulador del ritmo circadiano.";
"tips.card.environment.section4.title" = "Sonidos y música";
"tips.card.environment.section4.content" = "Trabajo/Concentración:\n• Ruido blanco/marrón\n• Música clásica barroca (60 bpm)\n• Sonidos de la naturaleza (lluvia, bosque)\n• Sin letra\n\nRelajación:\n• Frecuencias de 432 Hz\n• Cuencos tibetanos\n• Música meditativa\n• Sonidos binaurales (theta/delta)\n\nCrea una lista de reproducción por actividad.";
"tips.card.environment.section5.title" = "Temperatura y aire";
"tips.card.environment.section5.content" = "Temperatura óptima:\n• Día activo: 68-72°F (20-22°C)\n• Dormir: 64-66°F (18-19°C)\n• Demasiado caliente = fatiga, irritabilidad\n\nAire:\n• Ventilar 10-15 min por la mañana y por la noche\n• Humidificador en invierno (40-60% de humedad)\n• Evite las velas de incienso o aroma tóxicos\n\nSu cuerpo regula mejor el estrés en un entorno óptimo.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "Kit de emergencia antiestrés";
"tips.card.emergency_kit.short_description" = "Cuando sientes que vas a derrumbarte";
"tips.card.emergency_kit.section1.title" = "Ataque de pánico inminente";
"tips.card.emergency_kit.section1.content" = "AHORA (en orden):\n\n1. 4-7-8 respiración (descrita anteriormente)\n2. Agua de hielo en la cara o ducha fría\n3. 5-4-3-2-1 técnica (anclaje sensorial)\n4. Salir fuera si fuera posible\n5. Llama a alguien en quien confías\n\nRecordatorio: ataque de pánico = desagradable pero NO peligroso.\nPasa en 10-20 min máximo.";
"tips.card.emergency_kit.section2.title" = "Liberación física urgente";
"tips.card.emergency_kit.section2.content" = "Cuando el estrés está EN tu cuerpo:\n\n• Esprinta 30 segundos a toda velocidad (si es un lugar seguro)\n• 20 saltos de tijera\n• Aprieta fuerte una almohada/cojín y luego suelta (5x)\n• Empuja contra una pared con todas tus fuerzas (10 s)\n\nLa energía del estrés DEBE salir del cuerpo.";
"tips.card.emergency_kit.section3.title" = "A quién llamar";
"tips.card.emergency_kit.section3.content" = "Prepara esta lista AHORA (en tu teléfono):\n\n• 3 amigos/familiares de confianza\n• Línea de escucha (Línea 024 de atención a la conducta suicida)\n• Tu terapeuta si tienes uno\n• Emergencias si hay peligro inmediato: 112\n\nEn una crisis, no piensas con claridad.\nLista preparada = salvavidas.";
"tips.card.emergency_kit.section4.title" = "Permiso para tomar un descanso";
"tips.card.emergency_kit.section4.content" = "Tienes DERECHO a:\n\n• Cancelar planes\n• Decir \"Hoy no puedo\"\n• Tomarte un día de descanso mental\n• Delegar lo que se pueda delegar\n• Poner tu teléfono en modo avión\n\nCuidarte ≠ Egoísmo.\nEs SUPERVIVENCIA.\n\nSi no estás bien, no puedes ayudar a nadie.";
"tips.card.emergency_kit.section5.title" = "Después de la crisis";
"tips.card.emergency_kit.section5.content" = "Una vez que estés tranquilo:\n\n1. Bebe agua\n2. Come algo ligero\n3. Anota qué lo provocó (para identificar patrones)\n4. Practica la autocompasión (sin juicios)\n5. Plantéate ayuda profesional si se repite\n\nNecesitar ayuda ≠ Debilidad.\nEs valentía.";


