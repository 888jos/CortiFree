// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "rutina de la mañana antiestrés";
"tips.card.morning_routine.short_description" = "Comience su día en el pie derecho";
"tips.card.morning_routine.section1.title" = "Por qué es importante";
"tips.card.morning_routine.section1.content" = "Los primeros 60 minutos de su día determinan su nivel de cortisol para todo el día.";
"tips.card.morning_routine.section2.title" = "La rutina ideal (60 min)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: Despierta e hidratación\n• Beber 500 ml de agua al despertar\n• Rehidratar su cuerpo después de 8h de sueño\n• Activa tu metabolismo\n\n6:15-6:30: exposición a la luz\n• Ve afuera o cerca de una ventana\n• 15-30 min de luz natural\n• Detiene la melatonina, activa el cortisol de la mañana saludable\n\n6:30-6:45: movimiento suave\n• Stretching, yoga suave o caminando\n• Despertarse suavemente el cuerpo\n• Liberar endorfinas\n\n6:45-7:00: Práctica de atención\n• 5-10 minutos de meditación o respiración\n• Coherencia cardíaca\n• Establecer su intención para el día";
"tips.card.morning_routine.section3.title" = "AVOID los primeros 60 minutos";
"tips.card.morning_routine.section3.content" = "• Teléfono/emails/medios sociales\n• Noticias (a menudo negativas)\n• Situaciones difíciles\n• Cafeína antes de la hidratación";
"tips.card.morning_routine.section4.title" = "Por qué funciona";
"tips.card.morning_routine.section4.content" = "Esta rutina sincroniza tu ritmo circadiano, optimiza tu pico de cortisol matinal (beneficial) y te pone en un estado mental positivo para el día.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "ritual de tiempo de cama óptimo";
"tips.card.sleep_ritual.short_description" = "Prepara tu cuerpo y tu mente para descansar";
"tips.card.sleep_ritual.section1.title" = "El ritual perfecto";
"tips.card.sleep_ritual.section1.content" = "El buen sueño comienza 90 minutos antes de ir a la cama.\n\n9:30 PM: Atenuación de la luz\n• Dim las luces en la casa\n• Activar el modo nocturno en el teléfono/computador\n• Luces calientes solamente\n\n9:45 PM: cierre de pantalla\n• No más teléfono, TV, ordenador\n• Lea un libro de papel en su lugar\n• La luz azul bloquea la melatonina\n\n10:00 PM: Higiene y rutina\n• Ducha caliente (no caliente)\n• La rutina de cuidado facial y de dientes\n• Preparar la ropa de mañana\n\n10:15 PM: Actividad relajante\n• Lectura de luz (sin thrillers!)\n• Journaling/gratitudes\n• Meditación o respiración suave\n• Ligero estiramiento\n\n10:30 PM: Preparación de habitaciones\n• Temperatura fresca (64-66°F / 18-19°C)\n• Oscuridad total ( cortinas negras)\n• Silencio (de ser necesario)\n\n10:45-11:00 PM: Hora de dormir\n• Siempre al mismo tiempo\n• Incluso los fines de semana\n• Consistencia = mejor sueño";
"tips.card.sleep_ritual.section2.title" = "Consejos adicionales";
"tips.card.sleep_ritual.section2.content" = "• Sin ejercicio intenso después de las 8 PM\n• Última comida 2-3h antes de acostarse\n• Evite el alcohol y la cafeína después de las 4 PM\n• Dormitorio reservado para dormir (sin trabajo)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "Gestión del estrés en el trabajo";
"tips.card.work_stress.short_description" = "Estrategias para permanecer zen en la oficina";
"tips.card.work_stress.section1.title" = "Micro rompe cada hora";
"tips.card.work_stress.section1.content" = "• 2 min de respiración profunda\n• Funciones de oficina\n• Mira muy lejos (relaja los ojos)\n• Camine unos pasos";
"tips.card.work_stress.section2.title" = "Priorización inteligente";
"tips.card.work_stress.section2.content" = "Matriz Eisenhower:\n• Urgente + Importante = Do now\n• Importante + no urgente = Horario\n• Urgente + No importante = Delegado\n• No urgente + no importante = Eliminar\n\n1-3-5 Método:\n• 1 tarea principal por día\n• 3 tareas medianas\n• 5 pequeñas tareas";
"tips.card.work_stress.section3.title" = "Gestión de interrupciones";
"tips.card.work_stress.section3.content" = "• Modo de enfoque: 90 min sin interrupción\n• Notificaciones no urgentes\n• \"Puerta abierta\" ranuras para colegas\n• Correo electrónico: check 3 veces/día máximo";
"tips.card.work_stress.section4.title" = "No decir diplomáticamente";
"tips.card.work_stress.section4.content" = "\"Me gustaría ayudar, pero ya me he comprometido con [X]. Puedo sugerir [alternativo] o estar disponible de [fecha].\"\n\nTu tiempo es precioso. Protégelo.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "Nutrición diaria contra el estrés";
"tips.card.nutrition.short_description" = "Comidas y aperitivos que calman";
"tips.card.nutrition.section1.title" = "Desayuno ideal";
"tips.card.nutrition.section1.content" = "Proteína + Grasas saludables + fibra:\n\nOpción 1: Huevos + Aguacate + Pan integral\nOpción 2: yogur griego + nueces + bayas\nOpción 3: Smoothie (banana, espinacas, mantequilla de almendra, leche vegetal)\n\nPor qué: Estabiliza el azúcar en la sangre y el cortisol toda la mañana.";
"tips.card.nutrition.section2.title" = "Meriendas antiestrés";
"tips.card.nutrition.section2.content" = "Cuando huelga de hambre (10 AM o 4 PM):\n\n• Almendras (15-20) + 1 chocolate oscuro cuadrado\n• Manteca de manzana + almendra\n• Yogur de cola + Blueberries\n• Pegatinas Hummus + Veggie\n• Banana + Unas pocas nueces\n\nEvitar: Barritas procesadas, pastas, sodas";
"tips.card.nutrition.section3.title" = "Hidratación inteligente";
"tips.card.nutrition.section3.content" = "• 2L de agua/día mínimo\n• Infusiones de calma (chamomile, verbena, linden)\n• Té verde (L-theanine anti-stress)\n• Agua de limón por la mañana\n\nLímite:\n• Café: max 2-3 por día, no después de 2 PM\n• Alcohol: máximo 1 bebida/día\n• Sodas: ocasionalmente sólo";
"tips.card.nutrition.section4.title" = "Cena ligera";
"tips.card.nutrition.section4.content" = "2-3h antes de acostarse:\n\n• Verduras + proteínas magras (pescado, pollo, tofu)\n• Carbs complejos en pequeñas cantidades (rice, quinoa)\n• Evitar alimentos fritos, platos pesados, especias fuertes\n• Té digestivo después de la comida";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "Gestión de emociones difíciles";
"tips.card.emotions.short_description" = "Técnicas emocionales de emergencia";
"tips.card.emotions.section1.title" = "Técnica 4-7-8 (emergencia de ansiedad)";
"tips.card.emotions.section1.content" = "1. Exhala completamente a través de la boca (whoosh)\n2. Inhala a través de la nariz contando a 4\n3. Mantenga la respiración contando a 7\n4. Exhala a través de la boca contando a 8\n\nRepita 4 ciclos.\nEfecto: Activa el sistema parasimpático, se calma en 90 segundos.";
"tips.card.emotions.section2.title" = "técnica 5-4-3-2-1 (presente anclaje)";
"tips.card.emotions.section2.content" = "Cuando se siente abrumado, llame fuerte:\n\n• 5 cosas que ves a tu alrededor\n• 4 cosas que TOUCH\n• 3 cosas que oyes\n• 2 cosas que SMELL\n• 1 cosa que TASTE\n\nLleva tu mente al momento presente y detiene la espiral ansiosa.";
"tips.card.emotions.section3.title" = "Revista emocional";
"tips.card.emotions.section3.content" = "Cuando llegue una emoción fuerte, escriba:\n\n1. ¿Qué es esta emoción? (nombre exacto)\n2. ¿Dónde lo sientes en tu cuerpo?\n3. ¿Qué pensamiento lo provocó?\n4. ¿Es esto un hecho o una interpretación?\n5. ¿Qué sería un pensamiento alternativo más realista?\n\nEscribir = Procesar la emoción en lugar de oxidar.";
"tips.card.emotions.section4.title" = "Movimiento liberador";
"tips.card.emotions.section4.content" = "Emoción = energía atrapada en el cuerpo.\n\n• Brisk walk 10-15 min\n• Agitar los brazos / piernas vigorosamente\n• Danza a música energética\n• El estiramiento profundo\n• Creer en una almohada (si es necesario)\n\nEl cuerpo debe liberar el estrés físicamente.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "Competencia diaria";
"tips.card.mindfulness.short_description" = "Integrar la mente en todas partes";
"tips.card.mindfulness.section1.title" = "Café y té";
"tips.card.mindfulness.section1.content" = "En lugar de beber sin sentido:\n\n1. Observa el color del líquido\n2. Huele profundamente el aroma\n3. Siente la calidez de la taza en sus manos\n4. Toma un sorbo pequeño, deja que se siente en tu boca\n5. Observe el gusto, textura, temperatura\n6. Siente el calor bajando\n\n5 minutos de presencia pura.";
"tips.card.mindfulness.section2.title" = "Caminando con cuidado";
"tips.card.mindfulness.section2.content" = "Transformar cualquier caminata en meditación:\n\n• Siente el contacto de su pie con el suelo a cada paso\n• Observe el movimiento de sus brazos\n• Observa lo que ves sin juicio\n• Escucha los sonidos que te rodean\n• Siente el aire en tu piel, el viento en tu cabello\n\n5-10 min es suficiente para restablecer tu mente.";
"tips.card.mindfulness.section3.title" = "Ducha sensible";
"tips.card.mindfulness.section3.content" = "• Siente la temperatura del agua\n• Observe las gotas que fluyen en su piel\n• Centrarse en sensaciones corporales\n• Observar el sonido del agua\n• Huele el jabón / champú\n\nCada actividad diaria = oportunidad de meditación.";
"tips.card.mindfulness.section4.title" = "Comida mental";
"tips.card.mindfulness.section4.content" = "1 comida/día mínimo sin distracción:\n\n• Sin teléfono, TV, ordenador\n• Observa tu placa (colores, texturas)\n• Huele los aromas\n• Agarre lentamente (20-30 veces por mordida)\n• Observe sabores, texturas\n• Baja el tenedor entre las mordeduras\n\nMejor digestión + Satiedad natural + Momento de calma";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "Comunicación no violenta";
"tips.card.nvc.short_description" = "Expresa tus necesidades sin conflicto";
"tips.card.nvc.section1.title" = "Los 4 pasos de NVC";
"tips.card.nvc.section1.content" = "1. OBSERVACIÓN (hecho objetivo)\n\"Cuando llegues tarde a las citas...\"\n(NO \"Siempre llegas tarde\" = juicio)\n\n2. SIENTO (su emoción)\n\"...me siento estresada y frustrada...\"\n(NO \"Me estás estresando\" = acusación)\n\n3. NEED (lo que necesitas)\n\"...porque necesito poder contar con nuestros compromisos...\"\n\n4. SOLICITUD (acción concreta)\n\"¿Podrías enviarme un mensaje si llegas tarde?\"\n(NO \"Necesitas estar a tiempo\" = orden)";
"tips.card.nvc.section2.title" = "Escuchar activo";
"tips.card.nvc.section2.content" = "Cuando alguien te habla:\n\n• Para lo que estás haciendo\n• Mira a la persona en los ojos\n• No prepare su respuesta mientras hablan\n• Rephrase para verificar su comprensión\n• Validar la emoción antes de dar consejos\n\n\"Si entiendo correctamente, se siente [emoción] porque [situación]?\"";
"tips.card.nvc.section3.title" = "Manejo de la crítica";
"tips.card.nvc.section3.content" = "• Respira profundamente antes de responder\n• Busca la verdad en ella (incluso pequeña)\n• Gracias por los comentarios\n• Solicitar aclaración si es necesario\n• Da un paso atrás antes de decidir sobre la acción\n\n\"Gracias por decírmelo. ¿Puedes darme un ejemplo concreto?\"\n\nNo tomar personalmente √ Permitir malos tratos";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "Cultivar relaciones positivas";
"tips.card.positive_relations.short_description" = "Fortalecer sus vínculos sociales";
"tips.card.positive_relations.section1.title" = "rituales de conexión";
"tips.card.positive_relations.section1.content" = "• 1 videollamada/semana con un ser querido\n• 1 café / comida cara a cara por semana\n• Mensaje de entrada a 2-3 amigos/semana\n• Actividad mensual de grupo (deporte, hobby)\n\nCantidad de calidad, pero asuntos de consistencia.";
"tips.card.positive_relations.section2.title" = "Expresando gratitud";
"tips.card.positive_relations.section2.content" = "Al menos una vez/día, dile a alguien:\n\n\"Realmente aprecio que usted [acción concreta]. Me hizo sentir [ emoción positiva].\"\n\nEjemplos:\n• \"Gracias por escuchar mis preocupaciones ayer. Me sentí comprendida.\"\n• \"Aprecio que hayas pensado en mí. Me hizo sonreír.\"\n\nFortalece los lazos + Libera la oxitocina (hormona de felicidad)";
"tips.card.positive_relations.section3.title" = "Identificar relaciones tóxicas";
"tips.card.positive_relations.section3.content" = "Signos de advertencia:\n\n• Te sientes drenado después de las interacciones\n• Constante crítica, nunca apoyo\n• Vampirismo emocional (siempre ellos, nunca tú)\n• Manipulación o golpe de culpa\n• Sin respeto por tus límites\n\nAcción: Distancia progresiva o conversación franca.\nTienes derecho a proteger tu energía.";
"tips.card.positive_relations.section4.title" = "Solicitar apoyo";
"tips.card.positive_relations.section4.content" = "Preguntar por ayuda ل weakness:\n\n\"Necesito ayuda con [situación]. ¿Tendrías [tiempo / hora] para ayudarme?\"\n\nO simplemente:\n\"Estoy pasando por un momento difícil. ¿Podemos conseguir café para hablar de ello?\"\n\nLa gente quiere ayudar, pero no siempre sabe cómo. Sé específico.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "Productividad sin estrés";
"tips.card.productivity.short_description" = "Eficiente y zen";
"tips.card.productivity.section1.title" = "Técnica de Pomodoro adaptada";
"tips.card.productivity.section1.content" = "Trabajo en sesiones:\n\n• 25 minutos de enfoque total en UNA tarea\n• 5 minutos de descanso (caminar, estirar, respirar)\n• Repetir 4 veces\n• Larga pausa de 20-30 min\n\nNormas:\n• temporizador visible\n• Teléfono en modo de avión\n• Notificaciones desactivadas\n• Si se interrumpe = restablecer el Pomodoro\n\nResultado: 4h de trabajo real es mejor que 8h de distracción.";
"tips.card.productivity.section2.title" = "Trabajando con tu cerebro";
"tips.card.productivity.section2.content" = "Cada cerebro tiene sus picos energéticos:\n\nGente matutina (resucitantes)\n• 8 AM-12 PM: tareas complejas/creativas\n• 2-4 PM: tareas de rutina\n• Después de las 4 PM: Organización/emails\n\nLa gente de la noche (dormideros a la pila):\n• Mañana: Rutina/emails\n• 2-6 PM: tareas complejas\n• Evento: Creatividad/proyectos\n\nIdentifique su ritmo y adapte su horario.";
"tips.card.productivity.section3.title" = "'Done' lista además de 'To-Do'";
"tips.card.productivity.section3.content" = "Al final del día, escribe lo que DID:\n\n• Valida tus logros\n• Lucha contra el síndrome del impostor\n• Muestra el progreso realizado\n• Aumenta la autoconfianza\n\nSu cerebro recuerda el sesgo negativo.\nForzarlo a ver lo positivo.";
"tips.card.productivity.section4.title" = "El arte de 'casi perfecto'";
"tips.card.productivity.section4.content" = "Perfección = fuente de estrés mayor.\n\nRegla 80/20 (Pareto):\n• 80% del resultado proviene del 20% del esfuerzo\n• El 20% restante del resultado requiere un 80% de esfuerzo adicional\n\nPregunta: \"¿Este último 20% realmente vale mi tiempo y mi estrés?\"\n\nA menudo, \"lo suficientemente bueno\" es perfecto.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "Optimize your environment";
"tips.card.environment.short_description" = "Espacio de vida antiestrés";
"tips.card.environment.section1.title" = "Decluttering (regla de KonMari adaptada)";
"tips.card.environment.section1.content" = "1 zona/semana:\n\nToma cada objeto y pregúntate:\n• ¿Lo he usado en los últimos 6 meses?\n• ¿Me trae alegría?\n• ¿Es realmente útil?\n\nSi 3x no → Donar, reciclar o basura.\n\nDispersión visual = Sobrecarga mental.\nEspacio claro = mente clara.";
"tips.card.environment.section2.title" = "Plantas interiores";
"tips.card.environment.section2.content" = "Top 5 de fácil cuidado antiestrés:\n\n1. Pothos (aire + estrés)\n2. Planta de serpiente (oxigenados por la noche)\n3. Aloe Vera (purifica el aire)\n4. Planta de araña (fácil, eficaz)\n5. Lavender (centro de calentamiento)\n\nBeneficios provenientes:\n• -15% cortisol\n• Mejor calidad del aire\n• Efecto visual relajante";
"tips.card.environment.section3.title" = "Máxima luz natural";
"tips.card.environment.section3.content" = "• Cortinas abiertas al despertar\n• Escritorio cerca de la ventana si es posible\n• Bombillas diurnas (5000-6500K) por la mañana\n• Bombillas calientes (2700-3000K) por la noche\n• Dimmers de luz en dormitorios\n\nLuz = #1 regulador del ritmo circadiano.";
"tips.card.environment.section4.title" = "Sonidos y música";
"tips.card.environment.section4.content" = "Trabajo/Concentración:\n• Ruido blanco/rojo\n• Música clásica barroca (60 bpm)\n• Sonidos de la naturaleza (raíz, bosque)\n• Sin letras\n\nRelajación:\n• Frecuencias 432Hz\n• Tazones tibetanos\n• Música meditativa\n• Sonidos binaurales (theta/delta)\n\nCrear una lista de reproducción por actividad.";
"tips.card.environment.section5.title" = "Temperatura y aire";
"tips.card.environment.section5.content" = "Temperatura óptima:\n• Día activo: 68-72°F (20-22°C)\n• Dormir: 64-66°F (18-19°C)\n• Demasiado caliente = fatiga, irritabilidad\n\nAire:\n• Ventilar 10-15 min por la mañana y por la noche\n• Humidificador en invierno (40-60% de humedad)\n• Evite las velas de incienso o aroma tóxicos\n\nSu cuerpo regula mejor el estrés en un entorno óptimo.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "Kit de emergencia antiestrés";
"tips.card.emergency_kit.short_description" = "Cuando tienes ganas de romper";
"tips.card.emergency_kit.section1.title" = "Imminent panic attack";
"tips.card.emergency_kit.section1.content" = "AHORA (en orden):\n\n1. 4-7-8 respiración (descrita anteriormente)\n2. Agua de hielo en la cara o ducha fría\n3. 5-4-3-2-1 técnica (anclaje sensorial)\n4. Salir fuera si fuera posible\n5. Llama a alguien en quien confías\n\nRecordatorio: ataque de pánico = desagradable pero NO peligroso.\nPasa en 10-20 min máximo.";
"tips.card.emergency_kit.section2.title" = "Liberación física urgente";
"tips.card.emergency_kit.section2.content" = "Cuando el estrés está en su cuerpo:\n\n• Sprint 30 segundos a toda velocidad (si lugar seguro)\n• 20 gatos saltando\n• Apriete una almohada / cojín duro luego soltar (5x)\n• Empuja contra una pared con toda tu fuerza (10 segundos)\n\nLa energía del estrés debe dejar el cuerpo.";
"tips.card.emergency_kit.section3.title" = "Quien llama";
"tips.card.emergency_kit.section3.content" = "Prepare esta lista AHORA (en su teléfono):\n\n• 3 amigos de confianza/familia\n• Línea de escucha (Crisis Text Line: texto INICIO a 741741)\n• Tu terapeuta si tienes uno\n• Emergencia si peligro inmediato: 911\n\nEn crisis, no piensas claramente.\nLista preparada = línea de vida.";
"tips.card.emergency_kit.section4.title" = "Permiso para tomar un descanso";
"tips.card.emergency_kit.section4.content" = "Tienes derecho a:\n\n• Cancelar planes\n• Di \"No puedo hoy\"\n• Tomar un día de descanso mental\n• Delegado lo que se puede delegar\n• Pon tu teléfono en modo de avión\n\nCuidar de ti mismo ≠ Serishness.\nEs SURVIVAL.\n\nSi no estás bien, no puedes ayudar a nadie.";
"tips.card.emergency_kit.section5.title" = "Después de la crisis";
"tips.card.emergency_kit.section5.content" = "Una vez tranquila:\n\n1. Agua potable\n2. Come algo ligero\n3. Observe lo que lo provocó (para identificar patrones)\n4. Practicar la autocompasión (sin juicio)\n5. Planifique ayuda profesional si se repite\n\nNecesidad de ayuda.\nEs coraje.";


