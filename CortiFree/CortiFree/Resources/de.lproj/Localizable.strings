// MARK: - Exercise Instructions - Body Scan
"exercise.body_scan.step_1.title" = "Bequem wie eine Katze";
"exercise.body_scan.step_1.subtitle" = "Finden Sie die perfekte Position (ja, bewegen Sie sich ein bisschen mehr)";
"exercise.body_scan.step_1.duration" = "30 Sekunden";

"exercise.body_scan.step_2.title" = "Schließe die Augen, lass uns gehen!";
"exercise.body_scan.step_2.subtitle" = "Dein Atem wird dein Anker";
"exercise.body_scan.step_2.duration" = "30 Sekunden";

"exercise.body_scan.step_3.title" = "Konzentriere dich auf dein Gesicht";
"exercise.body_scan.step_3.subtitle" = "Entspannen Sie Ihren Kiefer, glätten Sie Ihre Stirn - runzeln Sie die Stirn, ohne es zu wissen?";
"exercise.body_scan.step_3.duration" = "1 min";

"exercise.body_scan.step_4.title" = "Deine Schultern fallen...";
"exercise.body_scan.step_4.subtitle" = "Lass sie fallen, als würdest du eine schwere Tasche hinlegen";
"exercise.body_scan.step_4.duration" = "1 min";

"exercise.body_scan.step_5.title" = "Atmen Sie in Ihren Bauch";
"exercise.body_scan.step_5.subtitle" = "Stellen Sie sich einen Ballon vor, der sanft aufbläst und entlädt";
"exercise.body_scan.step_5.duration" = "1 min";

"exercise.body_scan.step_6.title" = "Deine Beine erden dich";
"exercise.body_scan.step_6.subtitle" = "Fühlen Sie Ihre Füße gut verankert - solide wie ein Baum";
"exercise.body_scan.step_6.duration" = "1 min";

"exercise.body_scan.step_7.title" = "Tolle Arbeit, du hast deinen ganzen Körper gescannt!";
"exercise.body_scan.step_7.subtitle" = "Öffne deine Augen, wann immer du willst, keine Eile";
"exercise.body_scan.step_7.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - 5-4-3-2-1 Anchoring
"exercise.anchoring.step_1.title" = "Finden Sie 5 Dinge zu sehen";
"exercise.anchoring.step_1.subtitle" = "Ein Detail, das Sie noch nie zuvor bemerkt haben, zählt doppelt!";
"exercise.anchoring.step_1.duration" = "1 min";

"exercise.anchoring.step_2.title" = "Touch 4 verschiedene Texturen";
"exercise.anchoring.step_2.subtitle" = "Glatt, rauh, kalt, warm... Entdecken Sie!";
"exercise.anchoring.step_2.duration" = "1 min";

"exercise.anchoring.step_3.title" = "Fangen Sie 3 Sounds";
"exercise.anchoring.step_3.subtitle" = "Die entfernteste, die nächste, die diskreteste...";
"exercise.anchoring.step_3.duration" = "50 Sekunden";

"exercise.anchoring.step_4.title" = "Gerüche nach Fang 2";
"exercise.anchoring.step_4.subtitle" = "Atmen Sie tief - neutral zählt auch!";
"exercise.anchoring.step_4.duration" = "40 Sekunden";

"exercise.anchoring.step_5.title" = "Finden Sie 1 Geschmack";
"exercise.anchoring.step_5.subtitle" = "In deinem Mund oder auf deinen Lippen - es gibt immer etwas";
"exercise.anchoring.step_5.duration" = "30 Sekunden";

"exercise.anchoring.step_6.title" = "Mission erfüllt ✓";
"exercise.anchoring.step_6.subtitle" = "Du bist genau hier, genau jetzt, gut geerdet";
"exercise.anchoring.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - 2-Minute Meditation
"exercise.meditation_2min.step_1.title" = "Sitzen (wirklich) bequem";
"exercise.meditation_2min.step_1.subtitle" = "Keine Notwendigkeit für Lotus-Position, nur bequem sein";
"exercise.meditation_2min.step_1.duration" = "20 Sekunden";

"exercise.meditation_2min.step_2.title" = "Schließen Sie die Augen oder senken Sie den Blick";
"exercise.meditation_2min.step_2.subtitle" = "Wählen Sie, was Sie am bequemsten macht";
"exercise.meditation_2min.step_2.duration" = "15 Sekunden";

"exercise.meditation_2min.step_3.title" = "3 tiefe Atemzüge zum Start";
"exercise.meditation_2min.step_3.subtitle" = "Atmen Sie durch die Nase ein, blasen Sie durch den Mund aus (wie eine Kerze ausblasen)";
"exercise.meditation_2min.step_3.duration" = "30 Sekunden";

"exercise.meditation_2min.step_4.title" = "Deine Gedanken werden fließen";
"exercise.meditation_2min.step_4.subtitle" = "Es ist normal! Beobachten Sie, wie sie wie ein Slow-Motion-Film passieren";
"exercise.meditation_2min.step_4.duration" = "30 Sekunden";

"exercise.meditation_2min.step_5.title" = "Zurück zum Atem";
"exercise.meditation_2min.step_5.subtitle" = "In Gedanken verloren? Keine Sorge, komm einfach zurück zum Atmen";
"exercise.meditation_2min.step_5.duration" = "30 Sekunden";

"exercise.meditation_2min.step_6.title" = "Letzter tiefer Atemzug";
"exercise.meditation_2min.step_6.subtitle" = "Stretch, gähnen, öffnen Sie Ihre Augen - Sie meditiert!";
"exercise.meditation_2min.step_6.duration" = "15 Sekunden";

// MARK: - Exercise Instructions - 5 Senses Grounding
"exercise.grounding.step_1.title" = "Tiefer Atemzug zum Start";
"exercise.grounding.step_1.subtitle" = "Boden Sie sich im Hier und Jetzt";
"exercise.grounding.step_1.duration" = "20 Sekunden";

"exercise.grounding.step_2.title" = "Sight: 5 Details zum Spot";
"exercise.grounding.step_2.subtitle" = "Farben, Formen, Lichter - werde ein Detektiv des Augenblicks";
"exercise.grounding.step_2.duration" = "50 Sekunden";

"exercise.grounding.step_3.title" = "Berührung: 4 taktile Empfindungen";
"exercise.grounding.step_3.subtitle" = "Temperatur, Textur, Gewicht ... Was fühlt sich Ihre Haut an?";
"exercise.grounding.step_3.duration" = "40 Sekunden";

"exercise.grounding.step_4.title" = "Hören: 3 Geräusche zu fangen";
"exercise.grounding.step_4.subtitle" = "Das lauteste, das weichste, das überraschendste";
"exercise.grounding.step_4.duration" = "30 Sekunden";

"exercise.grounding.step_5.title" = "Geruch: 2 Düfte in der Luft";
"exercise.grounding.step_5.subtitle" = "Atmen Sie tief - kein Duft ist auch ein Duft!";
"exercise.grounding.step_5.duration" = "20 Sekunden";

"exercise.grounding.step_6.title" = "Geschmack: Was bleibt in deinem Mund?";
"exercise.grounding.step_6.subtitle" = "Sogar subtil, es gibt immer etwas";
"exercise.grounding.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - Conscious Stretching
"exercise.stretching.step_1.title" = "Steh auf, Füße Schulterbreite auseinander";
"exercise.stretching.step_1.subtitle" = "Stabil, als wühlst du dich selbst";
"exercise.stretching.step_1.duration" = "20 Sekunden";

"exercise.stretching.step_2.title" = "Arme zum Himmel, berühren Sie die Wolken";
"exercise.stretching.step_2.subtitle" = "Steigen Sie beim Einatmen, senken Sie beim Ausatmen - 3 mal";
"exercise.stretching.step_2.duration" = "30 Sekunden";

"exercise.stretching.step_3.title" = "Rollen Sie Ihre Schultern (Sie tragen sie zu lange)";
"exercise.stretching.step_3.subtitle" = "5 Kreise rückwärts, 5 vorwärts - binden Sie alles auf";
"exercise.stretching.step_3.duration" = "30 Sekunden";

"exercise.stretching.step_4.title" = "Lehnen Sie sich zu den Seiten";
"exercise.stretching.step_4.subtitle" = "Arme zum Himmel, strecken Sie eine Seite dann die andere - halten Sie für 3 Atemzüge";
"exercise.stretching.step_4.duration" = "40 Sekunden";

"exercise.stretching.step_5.title" = "Drehe dich wie eine Wetterfahne";
"exercise.stretching.step_5.subtitle" = "Verdrehen Sie Ihren Oberkörper sanft, schauen Sie hinter sich - bricht er? Das ist ein gutes Zeichen!";
"exercise.stretching.step_5.duration" = "30 Sekunden";

"exercise.stretching.step_6.title" = "3 letzte tiefe Atemzüge";
"exercise.stretching.step_6.subtitle" = "Fühlen Sie, wie viel besser Ihr Körper jetzt atmet";
"exercise.stretching.step_6.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - Audio Relaxation
"exercise.audio.step_1.title" = "Setzen Sie Ihre Kopfhörer auf (max. Komfort!)";
"exercise.audio.step_1.subtitle" = "Finde einen ruhigen Ort, an dem dich niemand stören wird";
"exercise.audio.step_1.duration" = "30 Sekunden";

"exercise.audio.step_2.title" = "Leg dich hin wie ein Seestern";
"exercise.audio.step_2.subtitle" = "Oder sitzen im Kokon-Modus - das Wichtigste ist, entspannt zu sein";
"exercise.audio.step_2.duration" = "30 Sekunden";

"exercise.audio.step_3.title" = "Starten Sie das Audio und schließen Sie die Augen";
"exercise.audio.step_3.subtitle" = "Lassen Sie die Stimme zu Ihrem GPS zur Entspannung werden";
"exercise.audio.step_3.duration" = "1 min";

"exercise.audio.step_4.title" = "Zwinge nichts, folge einfach der Stimme";
"exercise.audio.step_4.subtitle" = "Es weiß, wohin es geht (Versprechen)";
"exercise.audio.step_4.duration" = "2 min";

"exercise.audio.step_5.title" = "Dein Körper wird schwerer und schwerer";
"exercise.audio.step_5.subtitle" = "Als würdest du langsam in deine Matratze / deinen Stuhl sinken";
"exercise.audio.step_5.duration" = "2 min";

"exercise.audio.step_6.title" = "Stretch wie beim Aufwachen";
"exercise.audio.step_6.subtitle" = "Nimm dir Zeit, öffne die Augen - wie fühlst du dich?";
"exercise.audio.step_6.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - Positive Mantra
"exercise.mantra.step_1.title" = "Wähle deinen Zaubersatz";
"exercise.mantra.step_1.subtitle" = "\"Ich bin ruhig\", \"Alles ist gut\", \"Ich habe das\" - eine, die wirklich zu dir spricht";
"exercise.mantra.step_1.duration" = "20 Sekunden";

"exercise.mantra.step_2.title" = "Sitzen Sie bequem";
"exercise.mantra.step_2.subtitle" = "Hand auf dein Herz, wenn du willst (es verstärkt die Wirkung)";
"exercise.mantra.step_2.duration" = "15 Sekunden";

"exercise.mantra.step_3.title" = "Schließen Sie die Augen und lächeln Sie leicht";
"exercise.mantra.step_3.subtitle" = "Ja, Lächeln aktiviert bereits den positiven Modus in Ihrem Gehirn";
"exercise.mantra.step_3.duration" = "15 Sekunden";

"exercise.mantra.step_4.title" = "Wiederhole dein Mantra mit jedem Atemzug";
"exercise.mantra.step_4.subtitle" = "In Ihrem Kopf oder ruhig - tun Sie es mindestens 10 Mal";
"exercise.mantra.step_4.duration" = "1 min";

"exercise.mantra.step_5.title" = "Spüren Sie wirklich die Worte";
"exercise.mantra.step_5.subtitle" = "Nicht nur sie sagen, ihnen glauben - sogar ein wenig";
"exercise.mantra.step_5.duration" = "30 Sekunden";

"exercise.mantra.step_6.title" = "Atmen Sie tief 3 mal";
"exercise.mantra.step_6.subtitle" = "Öffne deine Augen - dein Satz bleibt den ganzen Tag bei dir";
"exercise.mantra.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - Visual Micro-Break
"exercise.visual_break.step_1.title" = "Blick weg von deinem Bildschirm!";
"exercise.visual_break.step_1.subtitle" = "Finden Sie das am weitesten entfernte, was Sie sehen können (Fenster ideal)";
"exercise.visual_break.step_1.duration" = "15 Sekunden";

"exercise.visual_break.step_2.title" = "20-20-20 Regel: 20 Sekunden lang auf einen entfernten Punkt starren";
"exercise.visual_break.step_2.subtitle" = "Mindestens 20 Meter entfernt - ein Baum, ein Gebäude, das Ende der Straße";
"exercise.visual_break.step_2.duration" = "20 Sekunden";

"exercise.visual_break.step_3.title" = "Blink 10 mal (für real)";
"exercise.visual_break.step_3.subtitle" = "Deine Augen sind trocken vom Starren - rehydriere sie";
"exercise.visual_break.step_3.duration" = "15 Sekunden";

"exercise.visual_break.step_4.title" = "Expressmassage: Kreise auf Tempeln";
"exercise.visual_break.step_4.subtitle" = "3 sanfte Kreise auf jeder Seite - ja, es entspannt sich wirklich";
"exercise.visual_break.step_4.duration" = "20 Sekunden";

"exercise.visual_break.step_5.title" = "Schließen Sie die Augen für 10 Sekunden (Mini Spa)";
"exercise.visual_break.step_5.subtitle" = "Völlige Dunkelheit, genau das, was deine Augen begehrten";
"exercise.visual_break.step_5.duration" = "15 Sekunden";

"exercise.visual_break.step_6.title" = "Wieder öffnen - besser schon, oder?";
"exercise.visual_break.step_6.subtitle" = "Wiederholen Sie jede Stunde Bildschirmzeit (Herausforderung akzeptiert?)";
"exercise.visual_break.step_6.duration" = "15 Sekunden";

// MARK: - Exercise Instructions - Slow Walk
"exercise.slow_walk.step_1.title" = "Finden Sie 15-30 Fuß freien Raum";
"exercise.slow_walk.step_1.subtitle" = "Indoor, Outdoor, Flur - spielt keine Rolle, nur ein Mini-Pfad";
"exercise.slow_walk.step_1.duration" = "30 Sekunden";

"exercise.slow_walk.step_2.title" = "Stand up, Füße geerdet";
"exercise.slow_walk.step_2.subtitle" = "Fühle dein ganzes Gewicht - du bist mit der Erde verbunden wie ein Baum";
"exercise.slow_walk.step_2.duration" = "20 Sekunden";

"exercise.slow_walk.step_3.title" = "Walk SUPER SLOWLY (wie Schildkrötenmodus)";
"exercise.slow_walk.step_3.subtitle" = "Brechen Sie es auf: Fersenheben, Fußrollen, Zehenabdrücken ... faszinierend, oder?";
"exercise.slow_walk.step_3.duration" = "1 min";

"exercise.slow_walk.step_4.title" = "Synchronisieren Sie jeden Schritt mit Ihrem Atem";
"exercise.slow_walk.step_4.subtitle" = "1 Schritt = 1 Atemzug, 1 Schritt = 1 Atemzug (Finden Sie Ihren Rhythmus)";
