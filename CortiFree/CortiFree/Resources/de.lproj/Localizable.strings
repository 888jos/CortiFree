"breathing.ex.coherence.title" = "Herzkohärenz 5-5";
"breathing.ex.coherence.benefit" = "6 Atemzüge pro Minute, um dein Nervensystem auszugleichen und Cortisol zu senken.";
"breathing.ex.coherence.when" = "Dreimal täglich (morgens, vor dem Mittagessen, am späten Nachmittag) oder wann immer Stress aufkommt. Die 3-6-5-Regel: 3-mal am Tag, 6 Atemzüge pro Minute, 5 Minuten.";
"breathing.ex.coherence.science" = "Mit etwa 6 Atemzügen pro Minute synchronisieren sich Herz und Atmung (Resonanz); Herzratenvariabilität und Vagustonus steigen. Regelmäßiges Üben geht mit niedrigerem Abend-Cortisol einher.";
"breathing.ex.extended_exhale.title" = "Lange Ausatmung 4-8";
"breathing.ex.extended_exhale.benefit" = "Atme doppelt so lang aus wie ein, um die natürliche Stressbremse zu aktivieren.";
"breathing.ex.extended_exhale.when" = "Wenn du angespannt oder gereizt bist oder deine Gedanken rasen. Überall möglich, auch mit offenen Augen.";
"breathing.ex.extended_exhale.science" = "Das Ausatmen verlangsamt das Herz über den Vagusnerv. Ist es länger als das Einatmen, verschiebt sich das Gleichgewicht in wenigen Minuten zum Parasympathikus.";
"breathing.ex.deep_abdominal.title" = "Bauchatmung 4-2-6";
"breathing.ex.deep_abdominal.benefit" = "Die Basis: tief in den Bauch atmen, um Spannungen zu lösen.";
"breathing.ex.deep_abdominal.when" = "Ideal für den Einstieg oder als Reset zwischen zwei Aufgaben. Leg eine Hand auf den Bauch und spüre, wie er sich hebt.";
"breathing.ex.deep_abdominal.science" = "Zwerchfellatmung senkt Atemfrequenz und Muskelspannung. Studien zeigen nach einigen Wochen weniger Cortisol und bessere Aufmerksamkeit.";
"breathing.ex.humming.title" = "Bienenatmung 4-7";
"breathing.ex.humming.benefit" = "Summe sanft beim Ausatmen: Die Vibration beruhigt und verlängert den Atem.";
"breathing.ex.humming.when" = "Wenn dein Kopf voll ist oder vor einem schwierigen Gespräch. Mund geschlossen, ein leises „mmm“ während der ganzen Ausatmung.";
"breathing.ex.humming.science" = "Summen (Bhramari) verlängert die Ausatmung und stimuliert den Vagusnerv über die Vibration im Hals. Es erhöht zudem das Stickstoffmonoxid in der Nase.";
"breathing.ex.physiological_sigh.title" = "Physiologischer Seufzer";
"breathing.ex.physiological_sigh.benefit" = "Zweimal durch die Nase einatmen, einmal lang ausatmen: der schnellste Weg zur Ruhe.";
"breathing.ex.physiological_sigh.when" = "Bei einer Stressspitze, vor einem Meeting, nach schlechten Nachrichten. Schon 1 bis 3 Seufzer helfen; 1 bis 5 Minuten für eine anhaltende Wirkung.";
"breathing.ex.physiological_sigh.science" = "Das kurze zweite Einatmen öffnet kollabierte Lungenbläschen, das lange Ausatmen gibt CO2 ab. Eine Stanford-Studie (2023) zeigte: 5 Minuten täglich verbessern die Stimmung stärker als Achtsamkeitsmeditation.";
"breathing.ex.sos_214.title" = "Panik-SOS 2-1-4";
"breathing.ex.sos_214.benefit" = "Ein kurzer, leichter Rhythmus, um bei Angst oder Panik die Kontrolle zurückzugewinnen.";
"breathing.ex.sos_214.when" = "Wenn der Atem kurz wird oder Panik aufsteigt. Kurze Zyklen sind auch in Überforderung leicht zu folgen; wechsle danach zur langen Ausatmung.";
"breathing.ex.sos_214.science" = "In Panik wirken lange, langsame Zyklen unmöglich. Kurzes Einatmen mit doppelt so langem Ausatmen begrenzt Hyperventilation und stabilisiert CO2, was Schwindel und Kribbeln lindert.";
"breathing.ex.four_seven_eight.title" = "4-7-8 zum Einschlafen";
"breathing.ex.four_seven_eight.benefit" = "Die entspannende Atmung, um schneller einzuschlafen.";
"breathing.ex.four_seven_eight.when" = "Im Bett bei ausgeschaltetem Licht oder beim nächtlichen Aufwachen. Mit wenigen Zyklen beginnen und langsam steigern.";
"breathing.ex.four_seven_eight.science" = "Das lange Halten und sehr lange Ausatmen verlangsamen den Herzschlag und beruhigen den Geist. Studien zeigen weniger Angst und leichteres Einschlafen.";
"breathing.ex.sleep_wave.title" = "Schlafwelle 4-6-2";
"breathing.ex.sleep_wave.benefit" = "Eine sanfte Welle, die dich verlangsamt, bis der Schlaf kommt.";
"breathing.ex.sleep_wave.when" = "Im Bett, 5 bis 15 Minuten. Lass die Pause nach dem Ausatmen schwer und weich werden.";
"breathing.ex.sleep_wave.science" = "Etwa 5 Atemzüge pro Minute mit einer Pause bei leerer Lunge senken die Erregung und erleichtern den Übergang in den Schlaf.";
"breathing.ex.slow66.title" = "Langsame Atmung 6-6";
"breathing.ex.slow66.benefit" = "5 Atemzüge pro Minute für tiefe, anhaltende Ruhe.";
"breathing.ex.slow66.when" = "Zum Abschalten am Abend, nach einem vollen Tag oder vor dem Meditieren.";
"breathing.ex.slow66.science" = "Langsames Atmen mit 5 bis 6 Zügen pro Minute maximiert Herzratenvariabilität und Baroreflex-Sensitivität, zwei Marker für Stressresilienz.";
"breathing.ex.box.title" = "Box-Atmung 4-4-4-4";
"breathing.ex.box.benefit" = "Der Vier-Takt-Rhythmus von Eliteteams, um unter Druck ruhig zu bleiben.";
"breathing.ex.box.when" = "Vor einer Prüfung, einer Präsentation, einem Wettkampf oder jedem Moment unter Druck.";
"breathing.ex.box.science" = "Gleich lange Phasen mit kurzem Halten regulieren CO2 und binden die Aufmerksamkeit ans Zählen: weniger Erregung, aber wach.";
"breathing.ex.triangle.title" = "Dreieck 4-4-4";
"breathing.ex.triangle.benefit" = "Drei gleiche Phasen, um den Kopf zu leeren und dich neu zu fokussieren.";
"breathing.ex.triangle.when" = "Wenn du den Faden verlierst oder vor konzentrierter Arbeit.";
"breathing.ex.triangle.science" = "Ein gleichmäßiger Rhythmus verankert die Aufmerksamkeit im Atem und verlangsamt ihn sanft, ohne müde zu machen.";
"breathing.ex.alternate_nostril.title" = "Wechselatmung";
"breathing.ex.alternate_nostril.benefit" = "Atme abwechselnd durch ein Nasenloch, um ins Gleichgewicht zu kommen.";
"breathing.ex.alternate_nostril.when" = "Vor Aufgaben, die Konzentration erfordern, oder bei Unruhe. Verschließe ein Nasenloch mit dem Daumen, das andere mit dem Ringfinger und folge der Anleitung.";
"breathing.ex.alternate_nostril.science" = "Wechselatmung (Nadi Shodhana) wurde in mehreren kontrollierten Studien mit niedrigerer Herzfrequenz, niedrigerem Blutdruck und besserer Aufmerksamkeit verbunden.";
"breathing.ex.energize.title" = "Aktivierend 4-2";
"breathing.ex.energize.benefit" = "Lang einatmen, kurz ausatmen: ein natürlicher Energieschub ohne Kaffee.";
"breathing.ex.energize.when" = "Morgens, nach dem Mittagessen oder bei einem Energietief. 1 bis 3 Minuten reichen.";
"breathing.ex.energize.science" = "Die Betonung des Einatmens aktiviert leicht den Sympathikus und erhöht die Wachheit. Bei Benommenheit aufhören.";
"breathing.ex.kapalabhati.title" = "Kapalabhati";
"breathing.ex.kapalabhati.benefit" = "Kurze, aktive Ausatmungen aus dem Bauch, um Körper und Geist zu wecken.";
"breathing.ex.kapalabhati.when" = "Morgens auf nüchternen Magen, aufrecht sitzend. Nicht in der Schwangerschaft, bei Bluthochdruck oder Herzproblemen.";
"breathing.ex.kapalabhati.science" = "Schnelle Bauchatmung steigert kurzzeitig Wachheit und Energie. Kurz halten und danach ruhig weiteratmen.";

