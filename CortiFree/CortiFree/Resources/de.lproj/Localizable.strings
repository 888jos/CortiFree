// MARK: - Tips Card: Morning Routine
"tips.card.morning_routine.title" = "Anti-Stress-Morgenroutine";
"tips.card.morning_routine.short_description" = "Starte gut in deinen Tag";
"tips.card.morning_routine.section1.title" = "Warum es wichtig ist";
"tips.card.morning_routine.section1.content" = "Die ersten 60 Minuten deines Tages bestimmen deinen Cortisolspiegel für den ganzen Tag.";
"tips.card.morning_routine.section2.title" = "Die ideale Routine (60 min)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: Aufwachen und trinken\n• Trink direkt nach dem Aufwachen 500 ml Wasser\n• Versorge deinen Körper nach 8 Stunden Schlaf wieder mit Flüssigkeit\n• Aktiviere deinen Stoffwechsel\n\n6:15-6:30: Licht tanken\n• Geh nach draußen oder ans Fenster\n• 15-30 Minuten natürliches Licht\n• Stoppt Melatonin, aktiviert das gesunde Morgencortisol\n\n6:30-6:45: Sanfte Bewegung\n• Dehnen, sanftes Yoga oder Gehen\n• Weckt den Körper sanft auf\n• Setzt Endorphine frei\n\n6:45-7:00: Achtsamkeitspraxis\n• 5-10 Minuten Meditation oder Atmung\n• Herzkohärenz\n• Lege deine Absicht für den Tag fest";
"tips.card.morning_routine.section3.title" = "In den ersten 60 Minuten VERMEIDEN";
"tips.card.morning_routine.section3.content" = "• Telefon / E-Mails / Social Media\n• Nachrichten (oft negativ)\n• Stresssituationen\n• Koffein vor der Hydratation";
"tips.card.morning_routine.section4.title" = "Warum es funktioniert";
"tips.card.morning_routine.section4.content" = "Diese Routine synchronisiert deinen zirkadianen Rhythmus, optimiert deinen morgendlichen Cortisolpeak (nützlich) und versetzt dich in einen positiven mentalen Zustand für den Tag.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "Optimales Schlafenszeit-Ritual";
"tips.card.sleep_ritual.short_description" = "Bereite Körper und Geist auf die Ruhe vor";
"tips.card.sleep_ritual.section1.title" = "Das perfekte Ritual";
"tips.card.sleep_ritual.section1.content" = "Guter Schlaf beginnt 90 Minuten vor dem Zubettgehen.\n\n21:30 Uhr: Licht dimmen\n• Dimm die Lichter im Haus\n• Aktiviere den Nachtmodus auf Handy/Computer\n• Nur warmes Licht\n\n21:45 Uhr: Bildschirme aus\n• Kein Handy, Fernseher, Computer mehr\n• Lies stattdessen ein gedrucktes Buch\n• Blaues Licht blockiert Melatonin\n\n22:00 Uhr: Hygiene und Routine\n• Warme Dusche (nicht heiß)\n• Gesichts- und Zahnpflege\n• Kleidung für morgen bereitlegen\n\n22:15 Uhr: Entspannende Aktivität\n• Leichte Lektüre (keine Thriller!)\n• Journaling/Dankbarkeit\n• Meditation oder sanftes Atmen\n• Leichtes Dehnen\n\n22:30 Uhr: Schlafzimmer vorbereiten\n• Kühle Temperatur (18-19 °C)\n• Völlige Dunkelheit (Verdunkelungsvorhänge)\n• Stille (Ohrstöpsel, wenn nötig)\n\n22:45-23:00 Uhr: Schlafenszeit\n• Immer zur gleichen Zeit\n• Auch am Wochenende\n• Regelmäßigkeit = besserer Schlaf";
"tips.card.sleep_ritual.section2.title" = "Zusätzliche Tipps";
"tips.card.sleep_ritual.section2.content" = "• Kein intensiver Sport nach 20 Uhr\n• Letzte Mahlzeit 2-3 Stunden vor dem Zubettgehen\n• Kein Alkohol und Koffein nach 16 Uhr\n• Schlafzimmer nur zum Schlafen (keine Arbeit)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "Stressmanagement am Arbeitsplatz";
"tips.card.work_stress.short_description" = "Strategien, um im Büro zen zu bleiben";
"tips.card.work_stress.section1.title" = "Mikropausen jede Stunde";
"tips.card.work_stress.section1.content" = "• 2 Minuten tiefes Atmen\n• Dehnübungen am Schreibtisch\n• In die Ferne schauen (entspannt die Augen)\n• Ein paar Schritte gehen";
"tips.card.work_stress.section2.title" = "Intelligente Priorisierung";
"tips.card.work_stress.section2.content" = "Eisenhower-Matrix:\n• Dringend + Wichtig = Sofort erledigen\n• Wichtig + Nicht dringend = Einplanen\n• Dringend + Nicht wichtig = Delegieren\n• Nicht dringend + Nicht wichtig = Streichen\n\n1-3-5-Methode:\n• 1 Hauptaufgabe pro Tag\n• 3 mittlere Aufgaben\n• 5 kleine Aufgaben";
"tips.card.work_stress.section3.title" = "Verwaltung von Unterbrechungen";
"tips.card.work_stress.section3.content" = "• Fokusmodus: 90 min ohne Unterbrechung\n• Nicht dringende Benachrichtigungen deaktivieren\n• \"Offene Tür\"-Zeitfenster für Kollegen\n• E-Mail: maximal 3 Mal / Tag checken";
"tips.card.work_stress.section4.title" = "Diplomatisch Nein sagen";
"tips.card.work_stress.section4.content" = "\"Ich würde dir gerne helfen, aber ich habe mich schon für [X] verpflichtet. Ich kann dir [Alternative] vorschlagen oder ab [Datum] verfügbar sein.\"\n\nDeine Zeit ist kostbar. Schütze sie.";

// MARK: - Tips Card: Anti-Stress Nutrition
"tips.card.nutrition.title" = "Tägliche Anti-Stress Ernährung";
"tips.card.nutrition.short_description" = "Mahlzeiten und Snacks, die beruhigen";
"tips.card.nutrition.section1.title" = "Ideales Frühstück";
"tips.card.nutrition.section1.content" = "Protein + Gesunde Fette + Ballaststoffe:\n\nOption 1: Eier + Avocado + Vollkornbrot\nOption 2: Griechischer Joghurt + Nüsse + Beeren\nOption 3: Smoothie (Banane, Spinat, Mandelmus, Pflanzenmilch)\n\nWarum: Stabilisiert Blutzucker und Cortisol den ganzen Vormittag.";
"tips.card.nutrition.section2.title" = "Anti-Stress-Snacks";
"tips.card.nutrition.section2.content" = "Wenn der Hunger kommt (10 oder 16 Uhr):\n\n• Mandeln (15-20) + 1 Stück dunkle Schokolade\n• Apfel + Mandelmus\n• Naturjoghurt + Heidelbeeren\n• Hummus + Gemüsesticks\n• Banane + Ein paar Nüsse\n\nVermeide: Industrielle Riegel, Gebäck, Limonaden";
"tips.card.nutrition.section3.title" = "Clever trinken";
"tips.card.nutrition.section3.content" = "• Mindestens 2 Liter Wasser/Tag\n• Beruhigende Kräutertees (Kamille, Verbene, Linde)\n• Grüner Tee (L-Theanin gegen Stress)\n• Zitronenwasser am Morgen\n\nEinschränken:\n• Kaffee: max. 2-3 pro Tag, nicht nach 14 Uhr\n• Alkohol: max. 1 Glas/Tag\n• Limonaden: nur gelegentlich";
"tips.card.nutrition.section4.title" = "Leichtes Abendessen";
"tips.card.nutrition.section4.content" = "2-3 Stunden vor dem Schlafengehen:\n\n• Gemüse + Magere Proteine (Fisch, Huhn, Tofu)\n• Komplexe Kohlenhydrate in kleinen Mengen (Reis, Quinoa)\n• Vermeide Frittiertes, schwere Gerichte, scharfe Gewürze\n• Verdauungstee nach der Mahlzeit";

// MARK: - Tips Card: Managing Emotions
"tips.card.emotions.title" = "Umgang mit schwierigen Emotionen";
"tips.card.emotions.short_description" = "Emotionale Notfalltechniken";
"tips.card.emotions.section1.title" = "4-7-8 Technik (Angstnotfall)";
"tips.card.emotions.section1.content" = "1. Atme vollständig durch den Mund aus (Whoosh)\n2. Atme durch die Nase ein und zähle bis 4\n3. Halte den Atem an und zähle bis 7\n4. Atme durch den Mund aus und zähle bis 8\n\n4 Zyklen wiederholen.\nWirkung: Aktiviert das parasympathische System, beruhigt in 90 Sekunden.";
"tips.card.emotions.section2.title" = "5-4-3-2-1-Technik (im Moment verankern)";
"tips.card.emotions.section2.content" = "Wenn du dich überwältigt fühlst, benenne laut:\n\n• 5 Dinge, die du um dich herum SIEHST\n• 4 Dinge, die du BERÜHRST\n• 3 Dinge, die du HÖRST\n• 2 Dinge, die du RIECHST\n• 1 Sache, die du SCHMECKST\n\nBringt deinen Geist in den gegenwärtigen Moment und stoppt die Angstspirale.";
"tips.card.emotions.section3.title" = "Emotionales Journaling";
"tips.card.emotions.section3.content" = "Wenn eine starke Emotion aufkommt, schreib auf:\n\n1. Was ist diese Emotion? (genauer Name)\n2. Wo spürst du sie in deinem Körper?\n3. Welcher Gedanke hat sie ausgelöst?\n4. Ist dieser Gedanke eine Tatsache oder eine Interpretation?\n5. Was wäre ein realistischerer alternativer Gedanke?\n\nSchreiben = Emotion verarbeiten statt grübeln.";
"tips.card.emotions.section4.title" = "Befreiende Bewegung";
"tips.card.emotions.section4.content" = "Emotion = Energie, die im Körper feststeckt.\n\n• Zügiger Spaziergang 10-15 min\n• Schüttle deine Arme / Beine kräftig aus\n• Tanze zu energiegeladener Musik\n• Tiefes Dehnen\n• Schrei in ein Kissen (falls nötig)\n\nDer Körper MUSS Stress körperlich loslassen.";

// MARK: - Tips Card: Daily Mindfulness
"tips.card.mindfulness.title" = "Tägliche Achtsamkeit";
"tips.card.mindfulness.short_description" = "Achtsamkeit überall integrieren";
"tips.card.mindfulness.section1.title" = "Kaffee/Tee Achtsamkeit";
"tips.card.mindfulness.section1.content" = "Statt gedankenlos zu trinken:\n\n1. Betrachte die Farbe der Flüssigkeit\n2. Rieche tief das Aroma\n3. Spüre die Wärme der Tasse in deinen Händen\n4. Nimm einen kleinen Schluck und lass ihn im Mund\n5. Achte auf Geschmack, Textur, Temperatur\n6. Spüre, wie die Wärme hinunterfließt\n\n5 Minuten reine Präsenz.";
"tips.card.mindfulness.section2.title" = "Achtsames Gehen";
"tips.card.mindfulness.section2.content" = "Verwandle jeden Spaziergang in eine Meditation:\n\n• Spüre bei jedem Schritt den Kontakt deines Fußes mit dem Boden\n• Achte auf die Bewegung deiner Arme\n• Beobachte, was du siehst, ohne zu urteilen\n• Lausche den Geräuschen um dich herum\n• Spüre die Luft auf deiner Haut, den Wind in deinem Haar\n\n5-10 min reichen, um deinen Kopf zurückzusetzen.";
"tips.card.mindfulness.section3.title" = "Achtsame Dusche";
"tips.card.mindfulness.section3.content" = "• Spüre die Wassertemperatur\n• Achte auf die Tropfen, die über deine Haut fließen\n• Konzentriere dich auf die Körperempfindungen\n• Lausche dem Geräusch des Wassers\n• Rieche die Seife/das Shampoo\n\nJede alltägliche Aktivität = Gelegenheit zur Meditation.";
"tips.card.mindfulness.section4.title" = "Achtsames Essen";
"tips.card.mindfulness.section4.content" = "Mindestens 1 Mahlzeit/Tag ohne Ablenkung:\n\n• Kein Handy, Fernseher, Computer\n• Betrachte deinen Teller (Farben, Texturen)\n• Rieche die Aromen\n• Kaue langsam (20-30 Mal pro Bissen)\n• Achte auf Geschmäcker, Texturen\n• Leg die Gabel zwischen den Bissen ab\n\nBessere Verdauung + Natürliche Sättigung + Moment der Ruhe";

// MARK: - Tips Card: Non-Violent Communication
"tips.card.nvc.title" = "Gewaltfreie Kommunikation";
"tips.card.nvc.short_description" = "Drücke deine Bedürfnisse ohne Konflikte aus";
"tips.card.nvc.section1.title" = "Die 4 Schritte der GFK";
"tips.card.nvc.section1.content" = "1. BEOBACHTUNG (objektive Tatsache)\n\"Wenn du zu spät zu Verabredungen kommst ...\"\n(NICHT \"Du bist immer zu spät\" = Urteil)\n\n2. GEFÜHL (deine Emotion)\n\"... fühle ich mich gestresst und frustriert ...\"\n(NICHT \"Du stresst mich\" = Vorwurf)\n\n3. BEDÜRFNIS (was du brauchst)\n\"... weil ich mich auf unsere Abmachungen verlassen können muss ...\"\n\n4. BITTE (konkrete Handlung)\n\"... könntest du mir eine Nachricht schicken, wenn du dich verspätest?\"\n(NICHT \"Du musst pünktlich sein\" = Befehl)";
"tips.card.nvc.section2.title" = "Aktives Zuhören";
"tips.card.nvc.section2.content" = "Wenn jemand mit dir spricht:\n\n• Hör auf mit dem, was du gerade tust\n• Schau der Person in die Augen\n• Bereite deine Antwort nicht vor, während sie spricht\n• Formuliere um, um zu prüfen, ob du richtig verstanden hast\n• Erkenne die Emotion an, bevor du Ratschläge gibst\n\n\"Wenn ich dich richtig verstehe, fühlst du dich [Emotion], weil [Situation]?\"";
"tips.card.nvc.section3.title" = "Umgang mit Kritik";
"tips.card.nvc.section3.content" = "• Atme tief durch, bevor du antwortest\n• Such den wahren Kern darin (auch wenn er klein ist)\n• Bedanke dich für das Feedback\n• Bitte bei Bedarf um Klarstellung\n• Nimm Abstand, bevor du über eine Reaktion entscheidest\n\n\"Danke, dass du es mir sagst. Kannst du mir ein konkretes Beispiel geben?\"\n\nNicht persönlich nehmen ≠ Schlechte Behandlung zulassen";

// MARK: - Tips Card: Positive Relationships
"tips.card.positive_relations.title" = "Positive Beziehungen pflegen";
"tips.card.positive_relations.short_description" = "Stärke deine sozialen Bindungen";
"tips.card.positive_relations.section1.title" = "Verbindungsrituale";
"tips.card.positive_relations.section1.content" = "• 1 Videoanruf / Woche mit einem geliebten Menschen\n• 1 Kaffee / Mahlzeit von Angesicht zu Angesicht pro Woche\n• Check-in Nachricht an 2-3 Freunde/Woche\n• Monatliche Gruppenaktivität (Sport, Hobby)\n\nQualität > Quantität, aber Konsistenz zählt.";
"tips.card.positive_relations.section2.title" = "Dankbarkeit ausdrücken";
"tips.card.positive_relations.section2.content" = "Sag mindestens einmal am Tag zu jemandem:\n\n\"Ich schätze es sehr, dass du [konkrete Handlung]. Dadurch habe ich mich [positive Emotion] gefühlt.\"\n\nBeispiele:\n• \"Danke, dass du mir gestern bei meinen Sorgen zugehört hast. Ich habe mich verstanden gefühlt.\"\n• \"Schön, dass du an mich gedacht hast. Das hat mich zum Lächeln gebracht.\"\n\nStärkt Bindungen + Setzt Oxytocin (Glückshormon) frei";
"tips.card.positive_relations.section3.title" = "Identifizierung toxischer Beziehungen";
"tips.card.positive_relations.section3.content" = "Warnzeichen:\n\n• Du fühlst dich nach Begegnungen erschöpft\n• Ständige Kritik, niemals Unterstützung\n• Emotionaler Vampirismus (immer sie, niemals du)\n• Manipulation oder Schuldgefühle einreden\n• Kein Respekt für deine Grenzen\n\nAktion: Schrittweise Distanz oder ein offenes Gespräch.\nDu hast das Recht, deine Energie zu schützen.";
"tips.card.positive_relations.section4.title" = "Bitte um Unterstützung";
"tips.card.positive_relations.section4.content" = "Um Hilfe bitten ≠ Schwäche:\n\n\"Ich brauche Hilfe bei [Situation]. Hättest du [Zeit/Fähigkeit], mir zu helfen?\"\n\nOder einfach:\n\"Ich mache gerade eine schwierige Zeit durch. Können wir einen Kaffee trinken und darüber reden?\"\n\nMenschen wollen helfen, wissen aber nicht immer wie. Sei konkret.";

// MARK: - Tips Card: Productivity
"tips.card.productivity.title" = "Stressfreie Produktivität";
"tips.card.productivity.short_description" = "Effizient und Zen";
"tips.card.productivity.section1.title" = "Angepasste Pomodoro-Technik";
"tips.card.productivity.section1.content" = "Arbeiten in Sitzungen:\n\n• 25 Minuten Gesamtfokus auf EINE Aufgabe\n• 5 Minuten Pause (Gehen, Strecken, Atmen)\n• 4 Mal wiederholen\n• Lange Pause von 20-30 min\n\nRegeln:\n• Sichtbarer Timer\n• Telefon im Flugzeugmodus\n• Benachrichtigungen deaktiviert\n• Wenn unterbrochen = Pomodoro zurücksetzen\n\nErgebnis: 4 Stunden echte Arbeit ist besser als 8 Stunden Ablenkung.";
"tips.card.productivity.section2.title" = "Arbeiten mit deinem Gehirn";
"tips.card.productivity.section2.content" = "Jedes Gehirn hat seine Energiespitzen:\n\nMorgenmenschen (Frühaufsteher):\n• 8-12 Uhr: Komplexe/kreative Aufgaben\n• 14-16 Uhr: Routineaufgaben\n• Nach 16 Uhr: Organisation/E-Mails\n\nAbendmenschen (Nachteulen):\n• Morgens: Routine/E-Mails\n• 14-18 Uhr: Komplexe Aufgaben\n• Abends: Kreativität/Projekte\n\nFinde DEINEN Rhythmus und passe deinen Zeitplan an.";
"tips.card.productivity.section3.title" = "'Erledigt'-Liste zusätzlich zur 'To-do'-Liste";
"tips.card.productivity.section3.content" = "Schreib am Ende des Tages auf, was du GESCHAFFT hast:\n\n• Würdigt deine Leistungen\n• Bekämpft das Impostor-Syndrom\n• Zeigt Fortschritte\n• Steigert das Selbstvertrauen\n\nDein Gehirn merkt sich das Negative (Negativitätsbias).\nZwinge es, das Positive zu sehen.";
"tips.card.productivity.section4.title" = "Die Kunst von \"fast perfekt\"";
"tips.card.productivity.section4.content" = "Perfektionismus = Hauptquelle von Stress.\n\n80/20 Regel (Pareto):\n• 80% des Ergebnisses kommt von 20% des Aufwands\n• Die restlichen 20% des Ergebnisses erfordern 80% zusätzlichen Aufwand\n\nFrage: \"Sind diese letzten 20% wirklich meine Zeit und meinen Stress wert?\"\n\nOft ist \"gut genug\" perfekt.";

// MARK: - Tips Card: Environment
"tips.card.environment.title" = "Optimiere deine Umgebung";
"tips.card.environment.short_description" = "Wohnraum gegen Stress";
"tips.card.environment.section1.title" = "Ausmisten (angepasste KonMari-Regel)";
"tips.card.environment.section1.content" = "1 Zone/Woche:\n\nNimm jedes Objekt und frage dich:\n• Habe ich es in den letzten 6 Monaten verwendet?\n• Bringt es mir Freude?\n• Ist es wirklich nützlich?\n\nWenn 3x nein → Spenden, recyceln oder Müll.\n\nVisuelles Durcheinander = Mentale Überlastung.\nKlarer Raum = Klarer Geist.";
"tips.card.environment.section2.title" = "Zimmerpflanzen";
"tips.card.environment.section2.content" = "Top 5 pflegeleichte Anti-Stress-Pflanzen:\n\n1. Efeutute (Luft + Stress)\n2. Bogenhanf (gibt nachts Sauerstoff ab)\n3. Aloe Vera (reinigt die Luft)\n4. Grünlilie (pflegeleicht, wirksam)\n5. Lavendel (beruhigender Duft)\n\nNachgewiesene Vorteile:\n• -15% Cortisol\n• Bessere Luftqualität\n• Beruhigende visuelle Wirkung";
"tips.card.environment.section3.title" = "Maximales natürliches Licht";
"tips.card.environment.section3.content" = "• Vorhänge gleich nach dem Aufwachen öffnen\n• Schreibtisch möglichst in Fensternähe\n• Tageslichtlampen (5000-6500K) am Morgen\n• Warmweiße Lampen (2700-3000K) am Abend\n• Dimmer in den Schlafzimmern\n\nLicht = Regulator Nr. 1 des zirkadianen Rhythmus.";
"tips.card.environment.section4.title" = "Klänge und Musik";
"tips.card.environment.section4.content" = "Arbeit/Konzentration:\n• Weißes/braunes Rauschen\n• Klassische Barockmusik (60 bpm)\n• Naturgeräusche (Regen, Wald)\n• Musik ohne Gesang\n\nEntspannung:\n• 432-Hz-Frequenzen\n• Tibetische Klangschalen\n• Meditative Musik\n• Binaurale Klänge (Theta/Delta)\n\nErstelle eine Playlist pro Aktivität.";
"tips.card.environment.section5.title" = "Temperatur und Luft";
"tips.card.environment.section5.content" = "Optimale Temperatur:\n• Aktiver Tag: 20-22 °C\n• Schlaf: 18-19 °C\n• Zu warm = Müdigkeit, Reizbarkeit\n\nLuft:\n• Morgens und abends 10-15 min lüften\n• Luftbefeuchter im Winter (40-60% Luftfeuchtigkeit)\n• Giftige Räucherstäbchen/Duftkerzen vermeiden\n\nDein Körper reguliert Stress in einer optimalen Umgebung besser.";

// MARK: - Tips Card: Emergency Kit
"tips.card.emergency_kit.title" = "Anti-Stress-Notfallkit";
"tips.card.emergency_kit.short_description" = "Wenn du das Gefühl hast, zusammenzubrechen";
"tips.card.emergency_kit.section1.title" = "Unmittelbare Panikattacke";
"tips.card.emergency_kit.section1.content" = "JETZT (in dieser Reihenfolge):\n\n1. 4-7-8-Atmung (oben beschrieben)\n2. Eiswasser ins Gesicht oder kalte Dusche\n3. 5-4-3-2-1-Technik (sensorische Verankerung)\n4. Wenn möglich nach draußen gehen\n5. Jemanden anrufen, dem du vertraust\n\nZur Erinnerung: Panikattacke = unangenehm, aber NICHT gefährlich.\nSie geht nach höchstens 10-20 min vorbei.";
"tips.card.emergency_kit.section2.title" = "Stress sofort körperlich abbauen";
"tips.card.emergency_kit.section2.content" = "Wenn der Stress IN deinem Körper sitzt:\n\n• 30 Sekunden Vollgas-Sprint (an einem sicheren Ort)\n• 20 Hampelmänner\n• Ein Kissen fest zusammendrücken, dann loslassen (5x)\n• Mit aller Kraft gegen eine Wand drücken (10 Sek.)\n\nDie Stressenergie MUSS den Körper verlassen.";
"tips.card.emergency_kit.section3.title" = "Wen anrufen";
"tips.card.emergency_kit.section3.content" = "Bereite diese Liste JETZT vor (in deinem Handy):\n\n• 3 Freunde/Familienmitglieder, denen du vertraust\n• Telefonseelsorge: 0800 111 0 111\n• Deinen Therapeuten, falls du einen hast\n• Notruf bei unmittelbarer Gefahr: 112\n\nIn der Krise denkt man nicht klar.\nVorbereitete Liste = Rettungsanker.";
"tips.card.emergency_kit.section4.title" = "Erlaubnis, eine Pause einzulegen";
"tips.card.emergency_kit.section4.content" = "Du hast das RECHT:\n\n• Pläne abzusagen\n• \"Heute kann ich nicht\" zu sagen\n• Einen mentalen Ruhetag zu nehmen\n• Zu delegieren, was delegiert werden kann\n• Dein Handy in den Flugmodus zu schalten\n\nFür sich selbst sorgen ≠ Egoismus.\nEs ist ÜBERLEBEN.\n\nWenn es dir nicht gut geht, kannst du niemandem helfen.";
"tips.card.emergency_kit.section5.title" = "Nach der Krise";
"tips.card.emergency_kit.section5.content" = "Sobald du ruhig bist:\n\n1. Trink Wasser\n2. Iss etwas Leichtes\n3. Notiere, was es ausgelöst hat (um Muster zu erkennen)\n4. Übe Selbstmitgefühl (ohne Urteil)\n5. Plane professionelle Hilfe ein, wenn es wiederkehrt\n\nHilfe brauchen ≠ Schwäche.\nEs ist Mut.";


