// MARK: - Meditation Detailed Descriptions
"meditation.conscious_breathing.detailed_description" = "Beobachte deinen natürlichen Atem, ohne ihn zu verändern. Aktiviert dein parasympathisches System, reduziert Stresshormone und schafft sofortige Ruhe in deinem ganzen Körper.";
"meditation.body_scan.detailed_description" = "Scanne deinen Körper von Kopf bis Fuß. Nimm die Empfindungen in jedem Bereich ohne Urteil wahr und löse bewusst alle angesammelten Spannungen für eine schnelle Entspannung.";
"meditation.mindfulness.detailed_description" = "Beobachte deine Gedanken wie vorbeiziehende Wolken, ohne Urteil oder Anhaftung. Entwickelt ein Bewusstsein für den gegenwärtigen Moment, reduziert das geistige Wiederkäuen und verbessert achtsame Reaktionen gegenüber Impulsen.";
"meditation.grounding.detailed_description" = "Nutze deine fünf Sinne, um dich sofort mit dem gegenwärtigen Moment zu verbinden. Achte auf das, was du siehst, berührst, hörst, riechst und schmeckst. Unterbricht Angstspiralen sofort.";
"meditation.visualization.detailed_description" = "Erschaffe einen sicheren inneren Rückzugsort, an dem du dich vollkommen in Frieden fühlst. Stell dir diese Zuflucht mit allen Sinnen vor. Greife jederzeit darauf zurück, um Stress und Angst zu reduzieren.";
"meditation.compassion.detailed_description" = "Behandle dich mit der gleichen Freundlichkeit und Geduld, die du einem lieben Freund anbieten würdest. Diese Praxis reduziert Selbstkritik, kultiviert innere Wärme und stärkt dein Selbstwertgefühl.";
"meditation.focus_clarity.detailed_description" = "Trainiere deinen Geist wie einen Muskel, indem du die Aufmerksamkeit immer wieder auf einen einzigen Fokuspunkt lenkst. Stärkt die Konzentration, reduziert Ablenkungen und verbessert Entscheidungsklarheit und anhaltenden Fokus.";
"meditation.yoga_nidra.detailed_description" = "Yoga Nidra führt dich in tiefe Entspannung, während du bewusst bleibst. Entspannt systematisch jeden Teil von Körper und Geist für erholsamen Schlaf und tiefe Ruhe.";

