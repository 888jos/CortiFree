// MARK: - Breathing Pattern Detailed Descriptions
"breathing_pattern.deep_abdominal.detailed_description" = "Atmen Sie tief mit Ihrem Bauch, um das parasympathische Nervensystem auf natürliche Weise zu aktivieren und einen sofortigen Zustand der Ruhe im gesamten Körper zu schaffen";
"breathing_pattern.four_seven_eight.detailed_description" = "Eine leistungsstarke Methode, um Ihr Nervensystem sofort zu beruhigen, indem Sie Ihre Atmung in einem präzisen Rhythmus steuern, der die Angst reduziert und ein schnelles Einschlafen erleichtert";
"breathing_pattern.coherence.detailed_description" = "Atmen Sie in einem Rhythmus von sechs Zyklen pro Minute, um ein optimales Gleichgewicht zwischen Herz und Gehirn zu schaffen und dadurch Cortisol messbar zu reduzieren";
"breathing_pattern.slow66.detailed_description" = "Verlängern Sie jede Atmungsphase auf sechs Sekunden, um Ihre Herzfrequenz schrittweise zu verlangsamen und Ihrem Körper zu signalisieren, dass es Zeit ist, sich tief auszuruhen";
"breathing_pattern.triangle.detailed_description" = "Passen Sie die drei Phasen Ihres Atems an, um einen regelmäßigen Rhythmus zu erzeugen, der Ihren Geist beruhigt und alle angesammelten körperlichen Spannungen reduziert";
"breathing_pattern.box.detailed_description" = "Die Technik, die von Spezialkräften verwendet wird, um bei intensivem Stress Ruhe zu bewahren, indem Sie vier gleiche Schläge einatmen, die Ihre Herzfrequenz synchronisieren";
"breathing_pattern.kapalabhati.detailed_description" = "Eine dynamische yogische Technik, die Ihr Atmungssystem reinigt und Vitalenergie durch schnelle Ausatmungen stimuliert, die Gehirn und Körper intensiv mit Sauerstoff versorgen";
"breathing_pattern.bhastrika.detailed_description" = "Ein kraftvoller rhythmischer Atem, der intensive Hitze erzeugt und die körperliche Energie steigert, indem er die Sauerstoffversorgung Ihres Organismus und Nervensystems dramatisch erhöht";

