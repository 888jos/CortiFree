"tips.card.morning_routine.title" = "Anti-Stress-Morgenroutine";
"tips.card.morning_routine.short_description" = "Beginnen Sie Ihren Tag auf dem rechten Fuß";
"tips.card.morning_routine.section1.title" = "Warum es wichtig ist";
"tips.card.morning_routine.section1.content" = "Die ersten 60 Minuten Ihres Tages bestimmen Ihren Cortisolspiegel für den ganzen Tag.";
"tips.card.morning_routine.section2.title" = "Die ideale Routine (60 min)";
"tips.card.morning_routine.section2.content" = "6:00-6:15: Aufwachen und Hydratation\n• Trinken Sie 500 ml Wasser beim Aufwachen\n• Rehydratisieren Sie Ihren Körper nach 8 Stunden Schlaf\n• Aktivieren Sie Ihren Stoffwechsel\n\n6:15-6:30: Lichtexposition\n• Gehen Sie nach draußen oder in die Nähe eines Fensters\n• 15-30 Minuten natürliches Licht\nStoppt Melatonin, aktiviert gesundes Morgencortisol\n\n6:30-6:45: Sanfte Bewegung\n• Stretching, sanftes Yoga oder Gehen\n• Sanft den Körper aufwecken\n• Endorphine freisetzen\n\n6:45-7:00: Achtsamkeitspraxis\n• 5-10 Minuten Meditation oder Atmung\n• Herzkohärenz\n• Setzen Sie Ihre Absicht für den Tag";
"tips.card.morning_routine.section3.title" = "Um die ersten 60 Minuten zu vermeiden";
"tips.card.morning_routine.section3.content" = "• Telefon / E-Mails / Social Media\n• Nachrichten (oft negativ)\n• Stresssituationen\n• Koffein vor der Hydratation";
"tips.card.morning_routine.section4.title" = "Warum es funktioniert";
"tips.card.morning_routine.section4.content" = "Diese Routine synchronisiert Ihren zirkadianen Rhythmus, optimiert Ihren morgendlichen Cortisolpeak (nützlich) und versetzt Sie in einen positiven mentalen Zustand für den Tag.";

// MARK: - Tips Card: Sleep Ritual
"tips.card.sleep_ritual.title" = "Optimales Schlafenszeit-Ritual";
"tips.card.sleep_ritual.short_description" = "Bereiten Sie Ihren Körper und Geist für Ruhe";
"tips.card.sleep_ritual.section1.title" = "Das perfekte Ritual";
"tips.card.sleep_ritual.section1.content" = "Guter Schlaf beginnt 90 Minuten vor dem Schlafengehen.\n\n9:30 Uhr: Lichtdimmung\n• Dimmen Sie die Lichter im Haus\n• Nachtmodus auf Telefon/Computer aktivieren\n• Nur warme Lichter\n\n9:45 Uhr: Bildschirmabschaltung\n• Kein Telefon, Fernseher, Computer mehr\n• Lesen Sie stattdessen ein Papierbuch\n• Blaues Licht blockiert Melatonin\n\n22:00 Uhr: Hygiene und Routine\n• Warme Dusche (nicht heiß)\n• Gesicht / Zähne Pflege Routine\n• Die Kleidung von morgen vorbereiten\n\n10:15 Uhr: Entspannungsaktivität\n• Light Reading (keine Thriller!)\n• Journaling / Dankbarkeit\n• Meditation oder sanftes Atmen\n• Light Stretching\n\n10:30 Uhr: Raumvorbereitung\n• Kühle Temperatur (64-66°F / 18-19°C)\n• Totale Dunkelheit (Blackout-Vorhänge)\n• Stille (Ohrstöpsel, wenn nötig)\n\n10:45-11:00 Uhr: Schlafenszeit\n• Immer zur gleichen Zeit\n• Auch am Wochenende\n• Konsistenz = besserer Schlaf";
"tips.card.sleep_ritual.section2.title" = "Zusätzliche Tipps";
"tips.card.sleep_ritual.section2.content" = "• Keine intensive Übung nach 20 Uhr\n• Letzte Mahlzeit 2-3 Stunden vor dem Zubettgehen\n• Vermeiden Sie Alkohol und Koffein nach 4 Uhr\n• Schlafzimmer für den Schlaf reserviert (keine Arbeit)";

// MARK: - Tips Card: Work Stress
"tips.card.work_stress.title" = "Stressmanagement am Arbeitsplatz";
"tips.card.work_stress.short_description" = "Strategien, um Zen im Büro zu bleiben";
