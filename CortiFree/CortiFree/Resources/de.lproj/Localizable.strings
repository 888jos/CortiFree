"tips.card.work_stress.section2.title" = "Intelligente Priorisierung";
"tips.card.work_stress.section2.content" = "Eisenhower Matrix:\n• Dringend + Wichtig = Jetzt tun\n• Wichtig + Nicht dringend = Zeitplan\n• Dringend + Nicht wichtig = Delegierter\n• Nicht dringend + Nicht wichtig = Eliminieren\n\n1-3-5 Methode:\n• 1 Hauptaufgabe pro Tag\n• 3 mittlere Aufgaben\n• 5 kleine Aufgaben";
