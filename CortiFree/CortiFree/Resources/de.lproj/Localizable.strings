// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplastizität: Ihr Gehirn kann sich verändern";
"learning.card.neuroplasticity.description" = "Wie sich Ihr Gehirn anpasst und entwickelt";
"learning.card.neuroplasticity.section1.title" = "Was es bedeutet";
"learning.card.neuroplasticity.section1.content" = "Neuroplastizität ist die Fähigkeit Ihres Gehirns, sich neu zu verkabeln und neue neuronale Verbindungen während Ihres gesamten Lebens zu schaffen.\n\n• Ihr Gehirn ist nicht fixiert, es entwickelt sich ständig weiter\n• Jede neue Gewohnheit schafft neue neuronale Schaltkreise\n• Alte Gewohnheiten können \"verlernt\" werden\n• Je mehr Sie üben, desto stärker werden die Verbindungen";
"learning.card.neuroplasticity.section2.title" = "Wissenschaftliche Erkenntnisse";
"learning.card.neuroplasticity.section2.content" = "• MRT-Scans zeigen strukturelle Veränderungen nach 8 Wochen Meditation\n• Gehirnareale, die mit Stress verbunden sind (Amygdala), können das Volumen verringern\n• Bereiche, die mit Konzentration verbunden sind (präfrontaler Cortex) können sich verdicken\n• Graue Materie erhöht sich in regelmäßig genutzten Bereichen";
"learning.card.neuroplasticity.section3.title" = "Wie lange es dauert";
"learning.card.neuroplasticity.section3.content" = "• Erste Änderungen: 2-4 Wochen\n• Messbare Veränderungen: 6-8 Wochen\n• Dauerhafte Änderungen: 2-3 Monate";
"learning.card.neuroplasticity.section4.title" = "Die wichtige Botschaft";
"learning.card.neuroplasticity.section4.content" = "Du bist nicht dazu verdammt, gestresst zu bleiben. Mit CortiFree programmierst du dein Gehirn buchstäblich um, um Stress besser zu bewältigen!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "Schlafzyklen";
"learning.card.sleep_cycles.description" = "Verstehen und Optimieren Ihrer Ruhe";
"learning.card.sleep_cycles.section1.title" = "Die 4 Phasen des Schlafes";
"learning.card.sleep_cycles.section1.content" = "Der Schlaf besteht aus 90-minütigen Zyklen, die 4-6 Mal pro Nacht wiederholt werden:\n\nLeichter Schlaf (5-10 min): Wach-Schlaf-Übergang, Muskeln entspannen, leicht aufzuwachen\n\n2. Tiefer leichter Schlaf (20 min): Herzfrequenz verlangsamt sich, Körpertemperatur sinkt, 50% der Gesamtzeit\n\nTiefschlaf (20-40 min): Meiste restaurative Phase, physikalische Regeneration, MAXIMALE KORTISOLREDUKTION\n\nREM / Paradoxer Schlaf (10-60 min): Intensive Träume, emotionale Konsolidierung, Stressverarbeitung";
"learning.card.sleep_cycles.section2.title" = "Optimierung Ihrer Zyklen";
"learning.card.sleep_cycles.section2.content" = "• Ziel für 7,5 oder 9 Stunden Schlaf (5 oder 6 komplette Zyklen)\n• Vermeiden Sie 6 oder 8 Stunden (Wach Mitte des Zyklus = Müdigkeit)\n• Zu Bett gehen und zu festen Zeiten aufwachen (auch am Wochenende)";
"learning.card.sleep_cycles.section3.title" = "Auswirkungen auf Cortisol";
"learning.card.sleep_cycles.section3.content" = "Tiefschlaf = 70% Rückgang des Cortisols\n• Schlafmangel = +37% Cortisol am nächsten Tag\n• 3 schlechte Nächte = Insulinresistenz (Prä-Diabetes)";
"learning.card.sleep_cycles.section4.title" = "Qualität > Quantität";
"learning.card.sleep_cycles.section4.content" = "Besser 6 Stunden mit viel Tiefschlaf als 8 Stunden Licht und fragmentierten Schlaf!";

