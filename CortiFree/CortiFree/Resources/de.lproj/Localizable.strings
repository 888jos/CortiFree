// MARK: - Meditation Detailed Descriptions
"meditation.conscious_breathing.detailed_description" = "Beobachten Sie Ihren natürlichen Atem, ohne ihn zu verändern. Aktiviert Ihr parasympathisches System, reduziert Stresshormone und schafft sofortige Ruhe im gesamten Körper.";
"meditation.body_scan.detailed_description" = "Scannen Sie Ihren Körper von Kopf bis Fuß. Bemerken Sie Empfindungen in jedem Bereich ohne Urteil und lösen Sie bewusst alle angesammelten Spannungen für eine schnelle Entspannung.";
"meditation.mindfulness.detailed_description" = "Beobachte deine Gedanken wie vorbeiziehende Wolken, ohne Urteil oder Anhaftung. Entwickelt ein Bewusstsein für den gegenwärtigen Moment, reduziert das geistige Wiederkäuen und verbessert achtsame Reaktionen gegenüber Impulsen.";
"meditation.grounding.detailed_description" = "Benutze deine fünf Sinne, um dich sofort mit dem gegenwärtigen Moment zu verbinden. Engagieren Sie sich mit dem, was Sie sehen, berühren, hören, riechen und schmecken. Unterbricht sofort die Angstzyklen.";
"meditation.visualization.detailed_description" = "Erschaffe ein sicheres geistiges Heiligtum, in dem du dich vollkommen in Frieden fühlst. Stellen Sie sich diese Zuflucht mit all Ihren Sinnen vor. Greifen Sie jederzeit darauf zu, um Stress und Angst zu reduzieren.";
"meditation.compassion.detailed_description" = "Behandle dich mit der gleichen Freundlichkeit und Geduld, die du einem lieben Freund anbieten würdest. Diese Praxis reduziert Selbstkritik, kultiviert innere Wärme und stärkt dein Selbstwertgefühl.";
"meditation.focus_clarity.detailed_description" = "Trainieren Sie Ihren Geist wie ein Muskel, indem Sie die Aufmerksamkeit auf einen einzigen Schwerpunkt zurückbringen. Stärkt die Konzentration, reduziert Ablenkungen und verbessert die Entscheidungsklarheit und nachhaltige Konzentration.";
"meditation.yoga_nidra.detailed_description" = "Yoga Nidra führt Sie in tiefe Entspannung, während Sie das Bewusstsein bewahren. Systematisch entspannt jeden Teil von Körper und Geist für erholsamen Schlaf und tiefe Ruhe.";

