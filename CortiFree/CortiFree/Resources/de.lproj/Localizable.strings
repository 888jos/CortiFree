// MARK: - Learning Card 4: Neuroplasticity
"learning.card.neuroplasticity.title" = "Neuroplastizität: Dein Gehirn kann sich verändern";
"learning.card.neuroplasticity.description" = "Wie sich dein Gehirn anpasst und entwickelt";
"learning.card.neuroplasticity.section1.title" = "Was es bedeutet";
"learning.card.neuroplasticity.section1.content" = "Neuroplastizität ist die Fähigkeit deines Gehirns, sich neu zu verschalten und während deines gesamten Lebens neue neuronale Verbindungen zu schaffen.\n\n• Dein Gehirn ist nicht starr, es entwickelt sich ständig weiter\n• Jede neue Gewohnheit schafft neue neuronale Schaltkreise\n• Alte Gewohnheiten können \"verlernt\" werden\n• Je mehr du übst, desto stärker werden die Verbindungen";
"learning.card.neuroplasticity.section2.title" = "Wissenschaftliche Erkenntnisse";
"learning.card.neuroplasticity.section2.content" = "• MRT-Scans zeigen strukturelle Veränderungen nach 8 Wochen Meditation\n• Gehirnareale, die mit Stress verbunden sind (Amygdala), können das Volumen verringern\n• Bereiche, die mit Konzentration verbunden sind (präfrontaler Cortex) können sich verdicken\n• Graue Materie erhöht sich in regelmäßig genutzten Bereichen";
"learning.card.neuroplasticity.section3.title" = "Wie lange es dauert";
"learning.card.neuroplasticity.section3.content" = "• Erste Änderungen: 2-4 Wochen\n• Messbare Veränderungen: 6-8 Wochen\n• Dauerhafte Änderungen: 2-3 Monate";
"learning.card.neuroplasticity.section4.title" = "Die wichtige Botschaft";
"learning.card.neuroplasticity.section4.content" = "Du bist nicht dazu verdammt, gestresst zu bleiben. Mit CortiFree programmierst du dein Gehirn buchstäblich um, um Stress besser zu bewältigen!";

// MARK: - Learning Card 5: Sleep cycles
"learning.card.sleep_cycles.title" = "Schlafzyklen";
"learning.card.sleep_cycles.description" = "Deine Erholung verstehen und optimieren";
"learning.card.sleep_cycles.section1.title" = "Die 4 Phasen des Schlafes";
"learning.card.sleep_cycles.section1.content" = "Der Schlaf besteht aus 90-minütigen Zyklen, die sich 4-6 Mal pro Nacht wiederholen:\n\n1️⃣ Leichter Schlaf (5-10 min): Übergang vom Wachen zum Schlafen, die Muskeln entspannen sich, leicht aufzuwecken\n\n2️⃣ Stabiler leichter Schlaf (20 min): Die Herzfrequenz verlangsamt sich, die Körpertemperatur sinkt, 50 % der Gesamtzeit\n\n3️⃣ Tiefschlaf (20-40 min): Die erholsamste Phase, körperliche Regeneration, MAXIMALE CORTISOLSENKUNG\n\n4️⃣ REM / Paradoxer Schlaf (10-60 min): Intensive Träume, emotionale Verarbeitung, Stressverarbeitung";
"learning.card.sleep_cycles.section2.title" = "Optimierung deiner Zyklen";
"learning.card.sleep_cycles.section2.content" = "• Ziele auf 7,5 oder 9 Stunden Schlaf (5 oder 6 vollständige Zyklen)\n• Vermeide 6 oder 8 Stunden (Aufwachen mitten im Zyklus = Müdigkeit)\n• Geh zu festen Zeiten ins Bett und steh zu festen Zeiten auf (auch am Wochenende)";
"learning.card.sleep_cycles.section3.title" = "Auswirkungen auf Cortisol";
"learning.card.sleep_cycles.section3.content" = "• Tiefschlaf = 70 % weniger Cortisol\n• Schlafmangel = +37 % Cortisol am nächsten Tag\n• 3 schlechte Nächte = Insulinresistenz (Prädiabetes)";
"learning.card.sleep_cycles.section4.title" = "Qualität > Quantität";
"learning.card.sleep_cycles.section4.content" = "Lieber 6 Stunden mit viel Tiefschlaf als 8 Stunden leichter, unterbrochener Schlaf!";

