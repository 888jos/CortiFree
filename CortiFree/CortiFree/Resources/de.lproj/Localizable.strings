// MARK: - Learning Card 1: Cortisol
"learning.card.cortisol.title" = "Was ist Cortisol?";
"learning.card.cortisol.description" = "Das Stresshormon verstehen";
"learning.card.cortisol.section1.title" = "Einleitung";
"learning.card.cortisol.section1.content" = "Cortisol wird oft \"das Stresshormon\" genannt. Es wird von den Nebennieren produziert und spielt eine wesentliche Rolle in der Reaktion Ihres Körpers auf Stress.";
"learning.card.cortisol.section2.title" = "Positive Rollen von Cortisol";
"learning.card.cortisol.section2.content" = "• Reguliert Ihr Energieniveau während des Tages\n• Hilft, schwierige und stressige Situationen zu bewältigen\n• Kontrolliert den Blutdruck und Blutzucker\n• Reduziert Entzündungen im Körper\n• Beteiligt sich am Stoffwechsel von Fetten, Proteinen und Kohlenhydraten\n• Reguliert den Schlaf-Wach-Zyklus (zirkadianer Rhythmus)";
"learning.card.cortisol.section3.title" = "Probleme mit chronischem Überschuss";
"learning.card.cortisol.section3.content" = "• Chronische Angstzustände und Schlafstörungen\n• Gewichtszunahme (besonders um den Bauch herum)\n• Geschwächtes Immunsystem\n• Hoher Blutdruck\n• Konzentrationsschwierigkeiten und Gedächtnisprobleme\n• Vorzeitige Hautalterung\n• Anhaltende Müdigkeit trotz Ruhe\n• Verdauungsprobleme";
"learning.card.cortisol.section4.title" = "Normale Werte";
"learning.card.cortisol.section4.content" = "Cortisol folgt einem natürlichen Rhythmus: Hoch am Morgen (Peak gegen 8 Uhr), um Sie aufzuwecken, dann nimmt es den ganzen Tag über ab, um abends am niedrigsten zu sein (um 23 Uhr), so dass Sie schlafen können.";
"learning.card.cortisol.section5.title" = "Ziel von CortiFree";
"learning.card.cortisol.section5.content" = "Um Ihnen zu helfen, einen gesunden und ausgewogenen Cortisolspiegel durch wissenschaftlich nachgewiesene Gewohnheiten aufrechtzuerhalten, die dieses Hormon auf natürliche Weise regulieren.";

