// MARK: - Learning Card 7: Anti-stress food
"learning.card.food.title" = "Antistressernährung";
"learning.card.food.description" = "Lebensmittel, die Cortisol regulieren";
"learning.card.food.section1.title" = "Lebensmittel, die Cortisol reduzieren";
"learning.card.food.section1.content" = "Gesunde Fette:\n• Avocados, Nüsse, Mandeln\n• Olivenöl, fetter Fisch (Lachs, Makrele)\n• Reich an entzündungshemmenden Omega-3-Fettsäuren\n\nMagnesiumreiche Lebensmittel:\n• Dunkle Schokolade (>70 % Kakao)\n• Spinat, Bananen\n• Kürbiskerne, Mandeln\n• Magnesium reduziert Angst und Cortisol\n\nVitamin C:\n• Zitrusfrüchte, Kiwis, Paprika\n• Senkt Cortisol um 15-20 %\n• Stärkt das Immunsystem\n\nGrüner und schwarzer Tee:\n• L-Theanin, das den Geist beruhigt\n• 20 % weniger Cortisol nach 6 Wochen";
"learning.card.food.section2.title" = "Lebensmittel, die Cortisol erhöhen";
"learning.card.food.section2.content" = "Zu viel Koffein:\n• Mehr als 400 mg/Tag (4 Kaffees)\n• Erhöht Cortisol um 30 %\n• Stört den Schlaf\n\nRaffinierter Zucker:\n• Blutzuckerspitzen = Cortisolspitzen\n• Systemische Entzündungen\n• Sucht und Heißhunger\n\nAlkohol:\n• Stört den Tiefschlaf\n• Erhöht das nächtliche Cortisol\n• Dehydrierung";
"learning.card.food.section3.title" = "Der Zeitpunkt zählt";
"learning.card.food.section3.content" = "• Proteinreiches Frühstück (stabilisiert Cortisol)\n• Vermeide Zucker und Koffein am Abend\n• Leichtes Abendessen 2-3 Stunden vor dem Schlafengehen";

// MARK: - Learning Card 8: Conscious breathing
"learning.card.breathing.title" = "Die Vorteile der bewussten Atmung";
"learning.card.breathing.description" = "Warum bewusstes Atmen wirkt";
"learning.card.breathing.section1.title" = "Sofortige Auswirkungen";
"learning.card.breathing.section1.content" = "Bewusstes Atmen ist eines der wirksamsten Werkzeuge, um deinen Stress zu regulieren:\n\n• Aktiviert das parasympathische Nervensystem (Entspannung)\n• Reduziert die Herzfrequenz\n• Senkt den Blutdruck";
"learning.card.breathing.section2.title" = "Langfristige Vorteile";
"learning.card.breathing.section2.content" = "• Verbessert das Stressmanagement\n• Erhöhung der Lungenkapazität\n• Förderung der mentalen Klarheit";
"learning.card.breathing.section3.title" = "Wusstest du das?";
"learning.card.breathing.section3.content" = "Ein tiefer Atemzug kann deinen Cortisolspiegel in nur 2-3 Minuten reduzieren!\n\nDeshalb sind Atemübungen das Herzstück des CortiFree-Programms.";

// MARK: - Learning Card 9: Power of nature
"learning.card.nature.title" = "Die Kraft der Natur";
"learning.card.nature.description" = "Warum die Natur beruhigt";
"learning.card.nature.section1.title" = "Wissenschaftliche Untersuchungen";
"learning.card.nature.section1.content" = "Der Kontakt mit der Natur wirkt sich nachweislich auf Stress aus:\n\n• -15% Cortisol nach 20 Minuten in der Natur\n• Verminderter Blutdruck\n• Verbesserte Stimmung";
"learning.card.nature.section2.title" = "Waldbaden (Shinrin-yoku)";
"learning.card.nature.section2.content" = "• Alte japanische Praxis\n• Langsamer Spaziergang im Wald\n• Verbindung mit den 5 Sinnen";
"learning.card.nature.section3.title" = "Vorteile";
"learning.card.nature.section3.content" = "• Stärkung des Immunsystems\n• Reduzierte Angst\n• Bessere Kreativität";
"learning.card.nature.section4.title" = "Selbst in der Stadt";
"learning.card.nature.section4.content" = "Ein Park, Garten oder Zimmerpflanzen haben bereits positive Auswirkungen!";

// MARK: - Learning Card 10: Cardiac coherence
"learning.card.cardiac_coherence.title" = "Herzkohärenz";
"learning.card.cardiac_coherence.description" = "Synchronisieren von Herz und Gehirn";
"learning.card.cardiac_coherence.section1.title" = "Wie es funktioniert";
"learning.card.cardiac_coherence.section1.content" = "Herzkohärenz ist eine Atemtechnik, die deine Herzfrequenz mit deinem Gehirn synchronisiert und so stark gegen Stress wirkt.\n\n• Atmung: 6 Zyklen pro Minute (5 Sek. Einatmen, 5 Sek. Ausatmen)\n• Dauer: 5 Minuten\n• Häufigkeit: 3 mal am Tag (morgens, mittags, abends)\n• Es ist die 365-Methode: 3 mal / Tag, 6 Atemzüge / min, 5 Minuten";
"learning.card.cardiac_coherence.section2.title" = "Sofortige Vorteile";
"learning.card.cardiac_coherence.section2.content" = "• Cortisolreduktion in 3-5 Minuten\n• Verminderte Herzfrequenz\n• niedrigerer Blutdruck\n• Gefühl von Ruhe und geistiger Klarheit";
"learning.card.cardiac_coherence.section3.title" = "Langzeitwirkungen (nach 2 Wochen)";
"learning.card.cardiac_coherence.section3.content" = "• -24 % Cortisol im Durchschnitt\n• Bessere emotionale Regulierung\n• Verbesserte Schlafqualität\n• Stärkung des Immunsystems\n• +17 % DHEA (Anti-Aging-Hormon)";
"learning.card.cardiac_coherence.section4.title" = "Verwendet von";
"learning.card.cardiac_coherence.section4.content" = "• Kampfpiloten\n• Elitesportler\n• Ärzte und Gesundheitspersonal\n• Geschäftsführer";
"learning.card.cardiac_coherence.section5.title" = "In CortiFree";
"learning.card.cardiac_coherence.section5.content" = "Die Übung \"5-5 Herzkohärenz\" im Bereich Atmung folgt genau dieser wissenschaftlichen Methode.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "Yoga und mentale Flexibilität";
"learning.card.yoga.description" = "Über einfache Flexibilität hinaus";
"learning.card.yoga.section1.title" = "Arten von Anti-Stress Yoga";
"learning.card.yoga.section1.content" = "Yoga ist viel mehr als eine körperliche Praxis. Es ist ein wirkungsvolles Werkzeug zur Stressregulierung, das auf deinen Körper UND deinen Geist wirkt.\n\n• Hatha Yoga: sanft, perfekt für Anfänger\n• Yin Yoga: lange Haltungen, sehr entspannend\n• Yoga Nidra: geführte Meditation im Liegen\n• Vinyasa: dynamisch, aber meditativ";
"learning.card.yoga.section2.title" = "Auswirkungen auf Cortisol";
"learning.card.yoga.section2.content" = "• -27% nach einer 60-minütigen Sitzung\n• Kumulative Effekte mit regelmäßiger Praxis\n• -41% Cortisol nach 12 Wochen (3x / Woche)";
"learning.card.yoga.section3.title" = "Wissenschaftlich nachgewiesene Vorteile";
"learning.card.yoga.section3.content" = "Körperlich:\n• Beweglichkeit und Muskelkraft\n• Bessere Haltung\n• Weniger chronische Schmerzen\n• Verbessertes Gleichgewicht\n\nMental:\n• -65 % Angstsymptome\n• Bessere emotionale Regulierung\n• Mehr graue Substanz\n• Verbesserte Konzentration\n\nPhysiologisch:\n• Aktivierung des parasympathischen Systems (Entspannung)\n• Bessere Herzfrequenzvariabilität\n• Weniger Entzündungen\n• Verbesserte Verdauung";
"learning.card.yoga.section4.title" = "Was passiert in deinem Gehirn";
"learning.card.yoga.section4.content" = "• Erhöhte GABA (beruhigender Neurotransmitter)\n• Reduzierte Amygdala-Aktivität (Angst / Stress)\n• Aktivierter präfrontaler Cortex (emotionale Kontrolle)";
"learning.card.yoga.section5.title" = "Keine Notwendigkeit, flexibel zu sein";
"learning.card.yoga.section5.content" = "Yoga ist kein Wettbewerb. Jeder Körper ist anders, und die Anti-Stress-Vorteile stellen sich schon ab den ersten Einheiten ein, auch mit Anpassungen!";

// MARK: - Learning Card 12: Sleep and cortisol
"learning.card.sleep_cortisol.title" = "Schlaf und Cortisol";
"learning.card.sleep_cortisol.description" = "Die Bedeutung eines guten circadianen Rhythmus";
"learning.card.sleep_cortisol.section1.title" = "Der natürliche Rhythmus";
"learning.card.sleep_cortisol.section1.content" = "Dein Schlaf und dein Cortisolspiegel sind eng miteinander verbunden:\n\n• Hohes Cortisol am Morgen (um dich aufzuwecken)\n• Niedriges Cortisol am Abend (zum Schlafen)";
"learning.card.sleep_cortisol.section2.title" = "Wenn es schief geht";
"learning.card.sleep_cortisol.section2.content" = "• Gestörter Schlaf → Hohes Cortisol 24/7\n• Teufelskreis: Stress → schlechter Schlaf → mehr Stress";
"learning.card.sleep_cortisol.section3.title" = "CortiFree Lösungen";
"learning.card.sleep_cortisol.section3.content" = "• Aufwachen vor 7 Uhr morgens (Morgenroutine)\n• Vor 23 Uhr ins Bett gehen (Erholung)\n• Abendmeditation (Schlafvorbereitung)";
"learning.card.sleep_cortisol.section4.title" = "Wusstest du das?";
"learning.card.sleep_cortisol.section4.content" = "Eine einzige Nacht mit schlechtem Schlaf kann dein Cortisol am nächsten Tag um 37% erhöhen!";

// MARK: - Learning Card 13: Hydration
"learning.card.hydration.title" = "Hydratation und Stress";
"learning.card.hydration.description" = "Warum Wassertrinken Stress reduziert";
"learning.card.hydration.section1.title" = "Auswirkungen der Dehydrierung";
"learning.card.hydration.section1.content" = "Wasser spielt eine entscheidende Rolle bei der Stressregulierung:\n\n• Erhöhtes Cortisol (+25%)\n• Müdigkeit und Reizbarkeit\n• Schwierigkeiten bei der Konzentration";
"learning.card.hydration.section2.title" = "Vorteile einer guten Hydratation";
"learning.card.hydration.section2.content" = "• Regulierung der Körpertemperatur\n• Ausscheidung von Giftstoffen\n• Bessere Gehirnfunktion";
"learning.card.hydration.section3.title" = "Empfehlung";
"learning.card.hydration.section3.content" = "• Mindestens 2 Liter Wasser pro Tag\n• Mehr bei körperlicher Aktivität\n• Über den ganzen Tag verteilt trinken";
"learning.card.hydration.section4.title" = "Tipp";
"learning.card.hydration.section4.content" = "Beginne deinen Tag mit einem großen Glas Wasser, um deinen Stoffwechsel aufzuwecken!";

// MARK: - Learning Card 14: Physical exercise
"learning.card.exercise.title" = "Anti-Stress körperliche Übung";
"learning.card.exercise.description" = "Wie Sport Cortisol reguliert";
"learning.card.exercise.section1.title" = "Auswirkungen auf Cortisol";
"learning.card.exercise.section1.content" = "Körperliche Aktivität ist ein natürlicher Stressregulator:\n\n• Kurzfristig: leichte Zunahme (normal)\n• Langfristig: signifikanter Rückgang des Baseline-Cortisols";
"learning.card.exercise.section2.title" = "Zusätzliche Vorteile";
"learning.card.exercise.section2.content" = "• Freisetzung von Endorphinen (Glückshormonen)\n• Verbesserter Schlaf\n• Besseres Selbstwertgefühl";
"learning.card.exercise.section3.title" = "Idealdauer";
"learning.card.exercise.section3.content" = "• 20-30 Minuten pro Sitzung\n• 3-5 Mal pro Woche\n• Moderate Intensität";
"learning.card.exercise.section4.title" = "Vorsicht";
"learning.card.exercise.section4.content" = "Zu viel intensives Training kann Cortisol erhöhen. Balance ist der Schlüssel!";

// MARK: - Learning Card 15: Social relationships
"learning.card.social.title" = "Positive soziale Beziehungen";
"learning.card.social.description" = "Die Bedeutung der sozialen Unterstützung";
"learning.card.social.section1.title" = "Auswirkungen auf Cortisol";
"learning.card.social.section1.content" = "Hochwertige soziale Kontakte sind für den Umgang mit Stress unerlässlich:\n\n• Positive Begegnungen → -20% Cortisol\n• Freisetzung von Oxytocin (\"Liebeshormon\")\n• Gefühl von Sicherheit und Zugehörigkeit";
"learning.card.social.section2.title" = "Arten vorteilhafter Verbindungen";
"learning.card.social.section2.content" = "• Tiefe Gespräche mit Freunden\n• Qualitätsmomente mit Familie\n• Gruppenaktivitäten (Sport, Hobbys)";
"learning.card.social.section3.title" = "Zu vermeiden";
"learning.card.social.section3.content" = "• Längere Isolation\n• Giftige oder konfliktreiche Beziehungen";
"learning.card.social.section4.title" = "Wusstest du das?";
"learning.card.social.section4.content" = "Eine einfache 20-Sekunden-Umarmung kann deinen Stress deutlich reduzieren!";

// MARK: - Learning Card 16: Natural light
"learning.card.light.title" = "Exposition gegenüber natürlichem Licht";
"learning.card.light.description" = "Reguliert deine biologische Uhr";
"learning.card.light.section1.title" = "Die Bedeutung des Morgens";
"learning.card.light.section1.content" = "Natürliches Licht spielt eine entscheidende Rolle bei der Regulierung deines Cortisols und deines zirkadianen Rhythmus:\n\n• Setz dich innerhalb von 30-60 Minuten nach dem Aufwachen dem Tageslicht aus\n• Mindestens 10-30 Minuten im Freien (auch an bewölkten Tagen)\n• Aktiviert die morgendliche Cortisolproduktion (normal und vorteilhaft)\n• Stoppt die Melatoninproduktion (Schlafhormon)";
"learning.card.light.section2.title" = "Auswirkungen auf deine biologische Uhr";
"learning.card.light.section2.content" = "• Reguliert den Cortisol / Melatonin-Zyklus\n• Verbessert die nächtliche Schlafqualität\n• Erhöht die Tagesenergie und Wachsamkeit\n• Synchronisiert alle deine biologischen Rhythmen";
"learning.card.light.section3.title" = "Wissenschaftliche Untersuchungen";
"learning.card.light.section3.content" = "• +25% Tagesenergie mit morgendlicher Exposition\n• Einschlafen 1 Stunde schneller am Abend\n• -35% depressive Symptome\n• Bessere Appetitregulierung";
"learning.card.light.section4.title" = "Abends vermeiden";
"learning.card.light.section4.content" = "• Bildschirme 1-2 Stunden vor dem Zubettgehen\n• Helle Lichter (bevorzugen warme / gedimmte Lichter)\n• Blaues Licht, das Melatonin blockiert";
"learning.card.light.section5.title" = "CortiFree-Tipp";
"learning.card.light.section5.content" = "Kombiniere deinen Morgenspaziergang mit natürlichem Tageslicht für eine vielfache Wirkung auf deine Energie und deinen Stress!";

// MARK: - Learning Card 17: Negative thoughts
"learning.card.negative_thoughts.title" = "Automatische negative Gedanken";
"learning.card.negative_thoughts.description" = "Identifizierung und Ersatz toxischer Muster";
"learning.card.negative_thoughts.section1.title" = "Die 7 Arten von toxischen Gedanken";
"learning.card.negative_thoughts.section1.content" = "Deine Gedanken beeinflussen direkt dein Stress- und Cortisolniveau. Es ist entscheidend zu lernen, automatische negative Gedanken zu erkennen und zu verändern.\n\n1️⃣ Katastrophisieren: \"Wenn ich diese Prüfung nicht bestehe, ist mein Leben vorbei\"\n→ Realität: Ein Misserfolg ist nicht das Ende\n\n2️⃣ Alles-oder-nichts-Denken: \"Wenn es nicht perfekt ist, ist es ein Misserfolg\"\n→ Realität: Das Leben besteht aus Nuancen\n\n3️⃣ Übergeneralisierung: \"Ich habe einmal versagt, ich versage immer\"\n→ Realität: Eine Situation ≠ alle Situationen\n\n4️⃣ Mentaler Filter: Das Positive ignorieren, sich auf das Negative konzentrieren\n→ Realität: Achte auch darauf, was gut läuft\n\n5️⃣ Gedankenlesen: \"Sie halten mich für inkompetent\"\n→ Realität: Du kannst keine Gedanken lesen\n\n6️⃣ Personalisierung: \"Es ist bestimmt meine Schuld\"\n→ Realität: Nicht alles hängt von dir ab\n\n7️⃣ Tyrannische Pflichten: \"Ich MUSS perfekt sein\"\n→ Realität: Niemand ist perfekt";
"learning.card.negative_thoughts.section2.title" = "Die 3-Spalten-Technik";
"learning.card.negative_thoughts.section2.content" = "Spalte 1: Situation\nSpalte 2: Automatisches Denken\nSpalte 3: Realistischer alternativer Gedanke";
"learning.card.negative_thoughts.section3.title" = "Messbare Auswirkungen";
"learning.card.negative_thoughts.section3.content" = "• -40% Angst mit kognitiver Therapie\n• -28% Cortisol durch Identifizierung und Modifikation dieser Gedanken\n• Dauerhafte Verbesserung nach 8-12 Wochen";
"learning.card.negative_thoughts.section4.title" = "Journaling-Tipp";
"learning.card.negative_thoughts.section4.content" = "Deine Gedanken im CortiFree-Journal aufzuschreiben hilft dir, sie zu erkennen, zu hinterfragen und zu verwandeln!";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "Dankbarkeit und das Gehirn";
"learning.card.gratitude.description" = "Die wissenschaftliche Wirkung der Anerkennung";
"learning.card.gratitude.section1.title" = "Was passiert in deinem Gehirn";
"learning.card.gratitude.section1.content" = "Dankbarkeit zu üben ist nicht nur \"positives Denken\": Es ist eine wissenschaftlich validierte Technik, die dein Gehirn und dein Stressniveau verändert.\n\n• Aktivierung des medialen präfrontalen Cortex (Wohlbefinden)\n• Freisetzung von Dopamin und Serotonin (Glück)\n• Reduzierte Amygdala-Aktivität (Stress/Angst)\n• -23% Cortisol im Durchschnitt";
"learning.card.gratitude.section2.title" = "Wichtige wissenschaftliche Studien";
"learning.card.gratitude.section2.content" = "UC Berkeley (2015):\n• Dankbarkeitstagebuch 3x/Woche\n• -27% Depression nach 12 Wochen\n• Besserer Schlaf und bessere soziale Beziehungen\n\nHarvard Medical School (2021):\n• 5 Minuten Dankbarkeit pro Tag\n• +25% empfundenes Glück\n• -18% Angst";
"learning.card.gratitude.section3.title" = "Wie man effektiv übt";
"learning.card.gratitude.section3.content" = "3-Dankbarkeiten-Methode (5 min/Tag):\n1. Schreibe 3 Dinge auf, für die du dankbar bist\n2. Sei konkret (nicht nur \"meine Familie\")\n3. Spüre die Emotion beim Schreiben\n4. Variiere deine Dankbarkeiten jeden Tag\n\nBeispiele:\nZu vage: \"Ich bin dankbar für meine Gesundheit\"\nKonkret: \"Ich bin dankbar, dass ich meinen Morgenspaziergang ohne Schmerzen machen und die frische Luft auf meinem Gesicht spüren konnte\"";
"learning.card.gratitude.section4.title" = "Langfristige Auswirkungen";
"learning.card.gratitude.section4.content" = "Nach 4 Wochen:\n• Messbare Veränderungen im Gehirn\n• Bessere Schlafqualität\n• Mehr positive Emotionen\n\nNach 12 Wochen:\n• Neues, höheres Grundniveau an Glück\n• Erhöhte Widerstandsfähigkeit gegenüber Stress\n• Bessere zwischenmenschliche Beziehungen";
"learning.card.gratitude.section5.title" = "Integriert in CortiFree";
"learning.card.gratitude.section5.content" = "Im Tagebuch kannst du notieren, wofür du täglich dankbar bist. Diese einfache 2-3-minütige Übung kann deine Beziehung zu Stress verändern!";
"learning.card.gratitude.section6.title" = "Wichtig";
"learning.card.gratitude.section6.content" = "Dankbarkeit leugnet Probleme nicht, sie trainiert dein Gehirn, auch das Positive zu sehen, anstatt sich nur auf das Negative zu konzentrieren.";

