// MARK: - Exercise Instructions - Body Scan
"exercise.body_scan.step_1.title" = "Mach es dir bequem wie eine Katze";
"exercise.body_scan.step_1.subtitle" = "Finde DIE perfekte Position (ja, beweg dich noch ein bisschen)";
"exercise.body_scan.step_1.duration" = "30 Sekunden";

"exercise.body_scan.step_2.title" = "Schließ die Augen, los geht’s!";
"exercise.body_scan.step_2.subtitle" = "Dein Atem wird dein Anker";
"exercise.body_scan.step_2.duration" = "30 Sekunden";

"exercise.body_scan.step_3.title" = "Konzentriere dich auf dein Gesicht";
"exercise.body_scan.step_3.subtitle" = "Entspanne deinen Kiefer, glätte deine Stirn - runzelst du die Stirn, ohne es zu merken?";
"exercise.body_scan.step_3.duration" = "1 min";

"exercise.body_scan.step_4.title" = "Deine Schultern sinken...";
"exercise.body_scan.step_4.subtitle" = "Lass sie fallen, als würdest du eine schwere Tasche hinlegen";
"exercise.body_scan.step_4.duration" = "1 min";

"exercise.body_scan.step_5.title" = "Atme in deinen Bauch";
"exercise.body_scan.step_5.subtitle" = "Stell dir einen Ballon vor, der sich sanft aufbläst und wieder entleert";
"exercise.body_scan.step_5.duration" = "1 min";

"exercise.body_scan.step_6.title" = "Deine Beine erden dich";
"exercise.body_scan.step_6.subtitle" = "Spüre, wie deine Füße gut verankert sind - fest wie ein Baum";
"exercise.body_scan.step_6.duration" = "1 min";

"exercise.body_scan.step_7.title" = "Tolle Arbeit, du hast deinen ganzen Körper gescannt!";
"exercise.body_scan.step_7.subtitle" = "Öffne deine Augen, wann immer du willst, keine Eile";
"exercise.body_scan.step_7.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - 5-4-3-2-1 Anchoring
"exercise.anchoring.step_1.title" = "Finde 5 Dinge, die du sehen kannst";
"exercise.anchoring.step_1.subtitle" = "Ein Detail, das du noch nie bemerkt hast, zählt doppelt!";
"exercise.anchoring.step_1.duration" = "1 min";

"exercise.anchoring.step_2.title" = "Berühre 4 verschiedene Texturen";
"exercise.anchoring.step_2.subtitle" = "Glatt, rau, kalt, warm... Entdecke!";
"exercise.anchoring.step_2.duration" = "1 min";

"exercise.anchoring.step_3.title" = "Nimm 3 Geräusche wahr";
"exercise.anchoring.step_3.subtitle" = "Die entfernteste, die nächste, die diskreteste...";
"exercise.anchoring.step_3.duration" = "50 Sekunden";

"exercise.anchoring.step_4.title" = "Nimm 2 Gerüche wahr";
"exercise.anchoring.step_4.subtitle" = "Atme tief ein - neutral zählt auch!";
"exercise.anchoring.step_4.duration" = "40 Sekunden";

"exercise.anchoring.step_5.title" = "Finde 1 Geschmack";
"exercise.anchoring.step_5.subtitle" = "In deinem Mund oder auf deinen Lippen - es gibt immer etwas";
"exercise.anchoring.step_5.duration" = "30 Sekunden";

"exercise.anchoring.step_6.title" = "Mission erfüllt ✓";
"exercise.anchoring.step_6.subtitle" = "Du bist genau hier, genau jetzt, gut geerdet";
"exercise.anchoring.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - 2-Minute Meditation
"exercise.meditation_2min.step_1.title" = "Setz dich (wirklich) bequem hin";
"exercise.meditation_2min.step_1.subtitle" = "Kein Lotussitz nötig, Hauptsache bequem";
"exercise.meditation_2min.step_1.duration" = "20 Sekunden";

"exercise.meditation_2min.step_2.title" = "Schließ die Augen oder senke den Blick";
"exercise.meditation_2min.step_2.subtitle" = "Wähle, was für dich am angenehmsten ist";
"exercise.meditation_2min.step_2.duration" = "15 Sekunden";

"exercise.meditation_2min.step_3.title" = "3 tiefe Atemzüge zum Start";
"exercise.meditation_2min.step_3.subtitle" = "Atme durch die Nase ein, puste durch den Mund aus (wie beim Auspusten einer Kerze)";
"exercise.meditation_2min.step_3.duration" = "30 Sekunden";

"exercise.meditation_2min.step_4.title" = "Deine Gedanken werden fließen";
"exercise.meditation_2min.step_4.subtitle" = "Das ist normal! Sieh ihnen zu wie einem Film in Zeitlupe";
"exercise.meditation_2min.step_4.duration" = "30 Sekunden";

"exercise.meditation_2min.step_5.title" = "Kehre zu deinem Atem zurück";
"exercise.meditation_2min.step_5.subtitle" = "In Gedanken verloren? Keine Sorge, komm einfach zurück zum Atmen";
"exercise.meditation_2min.step_5.duration" = "30 Sekunden";

"exercise.meditation_2min.step_6.title" = "Letzter tiefer Atemzug";
"exercise.meditation_2min.step_6.subtitle" = "Streck dich, gähne, öffne die Augen - du hast meditiert!";
"exercise.meditation_2min.step_6.duration" = "15 Sekunden";

// MARK: - Exercise Instructions - 5 Senses Grounding
"exercise.grounding.step_1.title" = "Tiefer Atemzug zum Start";
"exercise.grounding.step_1.subtitle" = "Verankere dich im Hier und Jetzt";
"exercise.grounding.step_1.duration" = "20 Sekunden";

"exercise.grounding.step_2.title" = "Sehen: 5 Details entdecken";
"exercise.grounding.step_2.subtitle" = "Farben, Formen, Lichter - werde ein Detektiv des Augenblicks";
"exercise.grounding.step_2.duration" = "50 Sekunden";

"exercise.grounding.step_3.title" = "Berührung: 4 taktile Empfindungen";
"exercise.grounding.step_3.subtitle" = "Temperatur, Textur, Gewicht... Was spürt deine Haut?";
"exercise.grounding.step_3.duration" = "40 Sekunden";

"exercise.grounding.step_4.title" = "Hören: 3 Geräusche wahrnehmen";
"exercise.grounding.step_4.subtitle" = "Das lauteste, das leiseste, das überraschendste";
"exercise.grounding.step_4.duration" = "30 Sekunden";

"exercise.grounding.step_5.title" = "Geruch: 2 Düfte in der Luft";
"exercise.grounding.step_5.subtitle" = "Atme tief ein - kein Duft ist auch ein Duft!";
"exercise.grounding.step_5.duration" = "20 Sekunden";

"exercise.grounding.step_6.title" = "Geschmack: Was bleibt in deinem Mund?";
"exercise.grounding.step_6.subtitle" = "Selbst wenn es subtil ist, es gibt immer etwas";
"exercise.grounding.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - Conscious Stretching
"exercise.stretching.step_1.title" = "Steh auf, Füße Schulterbreite auseinander";
"exercise.stretching.step_1.subtitle" = "Stabil, als würdest du Wurzeln schlagen";
"exercise.stretching.step_1.duration" = "20 Sekunden";

"exercise.stretching.step_2.title" = "Arme zum Himmel, berühre die Wolken";
"exercise.stretching.step_2.subtitle" = "Beim Einatmen heben, beim Ausatmen senken - 3 Mal";
"exercise.stretching.step_2.duration" = "30 Sekunden";

"exercise.stretching.step_3.title" = "Kreise deine Schultern (du trägst sie schon zu lange)";
"exercise.stretching.step_3.subtitle" = "5 Kreise rückwärts, 5 vorwärts - lös alles";
"exercise.stretching.step_3.duration" = "30 Sekunden";

"exercise.stretching.step_4.title" = "Neige dich zur Seite";
"exercise.stretching.step_4.subtitle" = "Arme zum Himmel, dehne eine Seite, dann die andere - halte 3 Atemzüge lang";
"exercise.stretching.step_4.duration" = "40 Sekunden";

"exercise.stretching.step_5.title" = "Drehe dich wie eine Wetterfahne";
"exercise.stretching.step_5.subtitle" = "Dreh deinen Oberkörper sanft, schau hinter dich - knackt es? Das ist ein gutes Zeichen!";
"exercise.stretching.step_5.duration" = "30 Sekunden";

"exercise.stretching.step_6.title" = "3 letzte tiefe Atemzüge";
"exercise.stretching.step_6.subtitle" = "Spüre, wie viel besser dein Körper jetzt atmet";
"exercise.stretching.step_6.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - Audio Relaxation
"exercise.audio.step_1.title" = "Setz deine Kopfhörer auf (maximaler Komfort!)";
"exercise.audio.step_1.subtitle" = "Finde einen ruhigen Ort, an dem dich niemand stören wird";
"exercise.audio.step_1.duration" = "30 Sekunden";

"exercise.audio.step_2.title" = "Leg dich hin wie ein Seestern";
"exercise.audio.step_2.subtitle" = "Oder setz dich im Kokon-Modus hin - Hauptsache, du bist entspannt";
"exercise.audio.step_2.duration" = "30 Sekunden";

"exercise.audio.step_3.title" = "Starte das Audio und schließ die Augen";
"exercise.audio.step_3.subtitle" = "Lass die Stimme dein GPS zur Entspannung werden";
"exercise.audio.step_3.duration" = "1 min";

"exercise.audio.step_4.title" = "Zwinge nichts, folge einfach der Stimme";
"exercise.audio.step_4.subtitle" = "Sie weiß, wohin sie geht (versprochen)";
"exercise.audio.step_4.duration" = "2 min";

"exercise.audio.step_5.title" = "Dein Körper wird schwerer und schwerer";
"exercise.audio.step_5.subtitle" = "Als würdest du langsam in deine Matratze / deinen Stuhl sinken";
"exercise.audio.step_5.duration" = "2 min";

"exercise.audio.step_6.title" = "Streck dich wie beim Aufwachen";
"exercise.audio.step_6.subtitle" = "Nimm dir Zeit, öffne die Augen - wie fühlst du dich?";
"exercise.audio.step_6.duration" = "30 Sekunden";

// MARK: - Exercise Instructions - Positive Mantra
"exercise.mantra.step_1.title" = "Wähle DEINEN Zaubersatz";
"exercise.mantra.step_1.subtitle" = "\"Ich bin ruhig\", \"Alles ist gut\", \"Ich schaffe das\" - einen, der dich wirklich anspricht";
"exercise.mantra.step_1.duration" = "20 Sekunden";

"exercise.mantra.step_2.title" = "Setz dich bequem hin";
"exercise.mantra.step_2.subtitle" = "Hand auf dein Herz, wenn du willst (es verstärkt die Wirkung)";
"exercise.mantra.step_2.duration" = "15 Sekunden";

"exercise.mantra.step_3.title" = "Schließ die Augen und lächle leicht";
"exercise.mantra.step_3.subtitle" = "Ja, Lächeln aktiviert bereits den positiven Modus in deinem Gehirn";
"exercise.mantra.step_3.duration" = "15 Sekunden";

"exercise.mantra.step_4.title" = "Wiederhole dein Mantra bei jedem Ausatmen";
"exercise.mantra.step_4.subtitle" = "Im Kopf oder leise - mindestens 10 Mal";
"exercise.mantra.step_4.duration" = "1 min";

"exercise.mantra.step_5.title" = "Spüre die Worte wirklich";
"exercise.mantra.step_5.subtitle" = "Sie nicht nur sagen, sondern daran glauben - wenigstens ein bisschen";
"exercise.mantra.step_5.duration" = "30 Sekunden";

"exercise.mantra.step_6.title" = "Atme 3 Mal tief durch";
"exercise.mantra.step_6.subtitle" = "Öffne deine Augen - dein Satz bleibt den ganzen Tag bei dir";
"exercise.mantra.step_6.duration" = "20 Sekunden";

// MARK: - Exercise Instructions - Visual Micro-Break
"exercise.visual_break.step_1.title" = "Schau weg von deinem Bildschirm!";
"exercise.visual_break.step_1.subtitle" = "Finde das am weitesten entfernte Ding, das du sehen kannst (ideal: ein Fenster)";
"exercise.visual_break.step_1.duration" = "15 Sekunden";

"exercise.visual_break.step_2.title" = "20-20-20-Regel: 20 Sekunden lang auf einen entfernten Punkt schauen";
"exercise.visual_break.step_2.subtitle" = "Mindestens 6 Meter entfernt - ein Baum, ein Gebäude, das Ende der Straße";
"exercise.visual_break.step_2.duration" = "20 Sekunden";

"exercise.visual_break.step_3.title" = "10 Mal blinzeln (wirklich)";
"exercise.visual_break.step_3.subtitle" = "Deine Augen sind trocken vom Starren - rehydriere sie";
"exercise.visual_break.step_3.duration" = "15 Sekunden";

"exercise.visual_break.step_4.title" = "Expressmassage: Kreise an den Schläfen";
"exercise.visual_break.step_4.subtitle" = "3 sanfte Kreise auf jeder Seite - ja, das entspannt wirklich";
"exercise.visual_break.step_4.duration" = "20 Sekunden";

"exercise.visual_break.step_5.title" = "Schließ die Augen für 10 Sekunden (Mini-Spa)";
"exercise.visual_break.step_5.subtitle" = "Völlige Dunkelheit, genau das, wonach sich deine Augen gesehnt haben";
"exercise.visual_break.step_5.duration" = "15 Sekunden";

"exercise.visual_break.step_6.title" = "Wieder öffnen - schon besser, oder?";
"exercise.visual_break.step_6.subtitle" = "Wiederhole das nach jeder Stunde Bildschirmzeit (Challenge angenommen?)";
"exercise.visual_break.step_6.duration" = "15 Sekunden";

// MARK: - Exercise Instructions - Slow Walk
"exercise.slow_walk.step_1.title" = "Finde 5-10 Meter freien Raum";
"exercise.slow_walk.step_1.subtitle" = "Drinnen, draußen, Flur - egal, nur ein Mini-Weg";
"exercise.slow_walk.step_1.duration" = "30 Sekunden";

"exercise.slow_walk.step_2.title" = "Steh auf, Füße geerdet";
"exercise.slow_walk.step_2.subtitle" = "Fühle dein ganzes Gewicht - du bist mit der Erde verbunden wie ein Baum";
"exercise.slow_walk.step_2.duration" = "20 Sekunden";

"exercise.slow_walk.step_3.title" = "Geh SUPER LANGSAM (Schildkröten-Modus)";
"exercise.slow_walk.step_3.subtitle" = "Zerlege es: Ferse hebt sich, Fuß rollt ab, Zehen drücken sich ab... faszinierend, oder?";
"exercise.slow_walk.step_3.duration" = "1 min";

"exercise.slow_walk.step_4.title" = "Synchronisiere jeden Schritt mit deinem Atem";
"exercise.slow_walk.step_4.subtitle" = "1 Schritt = 1 Einatmen, 1 Schritt = 1 Ausatmen (finde deinen Rhythmus)";
"exercise.slow_walk.step_4.duration" = "1 min";

"exercise.slow_walk.step_5.title" = "Mach 5 Minuten weiter - es ist meditativ";
