// MARK: - Learning Card 4: Neuroplasticité
"learning.card.neuroplasticity.title" = "La neuroplasticité : ton cerveau peut changer";
"learning.card.neuroplasticity.description" = "Comment ton cerveau s'adapte et évolue";
"learning.card.neuroplasticity.section1.title" = "Ce que cela signifie";
"learning.card.neuroplasticity.section1.content" = "La neuroplasticité est la capacité de ton cerveau à se recâbler et à créer de nouvelles connexions neuronales tout au long de ta vie.\n\n• Ton cerveau n'est pas figé, il évolue constamment\n• Chaque nouvelle habitude crée de nouveaux circuits neuronaux\n• Les vieilles habitudes peuvent être \"désapprises\"\n• Plus tu pratiques, plus les connexions se renforcent";
"learning.card.neuroplasticity.section2.title" = "Preuves scientifiques";
"learning.card.neuroplasticity.section2.content" = "• Des scans IRM montrent des changements structurels après 8 semaines de méditation\n• Les zones du cerveau liées au stress (amygdale) peuvent diminuer de volume\n• Les zones liées à la concentration (cortex préfrontal) peuvent s'épaissir\n• La matière grise augmente dans les zones utilisées régulièrement";
"learning.card.neuroplasticity.section3.title" = "Combien de temps ça prend";
"learning.card.neuroplasticity.section3.content" = "• Premiers changements : 2-4 semaines\n• Changements mesurables : 6-8 semaines\n• Changements durables : 2-3 mois";
"learning.card.neuroplasticity.section4.title" = "Le message important";
"learning.card.neuroplasticity.section4.content" = "Tu n'es pas condamné à rester stressé. Avec CortiFree, tu reprogrammes littéralement ton cerveau pour mieux gérer le stress !";

// MARK: - Learning Card 5: Cycles de sommeil
"learning.card.sleep_cycles.title" = "Les cycles de sommeil";
"learning.card.sleep_cycles.description" = "Comprendre et optimiser ton repos";
"learning.card.sleep_cycles.section1.title" = "Les 4 phases du sommeil";
"learning.card.sleep_cycles.section1.content" = "Le sommeil est composé de cycles de 90 minutes qui se répètent 4-6 fois par nuit :\n\n1️⃣ Sommeil léger (5-10 min) : Transition veille-sommeil, muscles se détendent, facile de se réveiller\n\n2️⃣ Sommeil léger profond (20 min) : Rythme cardiaque ralentit, température corporelle baisse, 50% du temps total\n\n3️⃣ Sommeil profond (20-40 min) : Phase la plus réparatrice, régénération physique, RÉDUCTION MAXIMALE DU CORTISOL\n\n4️⃣ Sommeil paradoxal / REM (10-60 min) : Rêves intenses, consolidation émotionnelle, traitement du stress";
"learning.card.sleep_cycles.section2.title" = "Optimiser tes cycles";
"learning.card.sleep_cycles.section2.content" = "• Vise 7h30 ou 9h de sommeil (5 ou 6 cycles complets)\n• Évite 6h ou 8h (réveil en milieu de cycle = fatigue)\n• Se coucher et se lever à heures fixes (même le week-end)";
"learning.card.sleep_cycles.section3.title" = "Impact sur le cortisol";
"learning.card.sleep_cycles.section3.content" = "• Sommeil profond = baisse de 70% du cortisol\n• Manque de sommeil = +37% de cortisol le lendemain\n• 3 nuits mauvaises = résistance à l'insuline (pré-diabète)";
"learning.card.sleep_cycles.section4.title" = "Qualité > Quantité";
"learning.card.sleep_cycles.section4.content" = "Mieux vaut 6h avec beaucoup de sommeil profond que 8h de sommeil léger et fragmenté !";

