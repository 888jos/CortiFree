"learning.card.stress_body.section3.content" = "• Tensions et douleurs\n• Maux de tête\n• Fatigue chronique";
"learning.card.stress_body.section4.title" = "Énergie";
"learning.card.stress_body.section4.content" = "• Épuisement\n• Troubles du sommeil\n• Baisse de motivation\n\nC'est pour ça qu'il est crucial de gérer son stress au quotidien.";

// MARK: - Learning Card 7: Alimentation anti-stress
"learning.card.food.title" = "L'alimentation anti-stress";
"learning.card.food.description" = "Les aliments qui régulent le cortisol";
"learning.card.food.section1.title" = "Aliments qui RÉDUISENT le cortisol";
"learning.card.food.section1.content" = "Graisses saines :\n• Avocats, noix, amandes\n• Huile d'olive, poissons gras (saumon, maquereau)\n• Riches en oméga-3 anti-inflammatoires\n\nAliments riches en magnésium :\n• Chocolat noir (>70% cacao)\n• Épinards, bananes\n• Graines de courge, amandes\n• Le magnésium réduit l'anxiété et le cortisol\n\nVitamine C :\n• Agrumes, kiwis, poivrons\n• Réduit le cortisol de 15-20%\n• Renforce le système immunitaire\n\nThé vert et noir :\n• L-théanine qui calme l'esprit\n• Réduction de 20% du cortisol après 6 semaines";
"learning.card.food.section2.title" = "Aliments qui AUGMENTENT le cortisol";
"learning.card.food.section2.content" = "Excès de caféine :\n• Plus de 400mg/jour (4 cafés)\n• Augmente le cortisol de 30%\n• Perturbe le sommeil\n\nSucres raffinés :\n• Pics de glycémie = pics de cortisol\n• Inflammation systémique\n• Addiction et fringales\n\nAlcool :\n• Perturbe le sommeil profond\n• Augmente le cortisol nocturne\n• Déshydratation";
"learning.card.food.section3.title" = "Le timing compte";
"learning.card.food.section3.content" = "• Petit-déjeuner riche en protéines (stabilise cortisol)\n• Éviter sucres et caféine le soir\n• Dîner léger 2-3h avant coucher";

// MARK: - Learning Card 8: Respiration consciente
"learning.card.breathing.title" = "Les bienfaits de la respiration consciente";
"learning.card.breathing.description" = "Pourquoi respirer consciemment fonctionne";
"learning.card.breathing.section1.title" = "Effets immédiats";
"learning.card.breathing.section1.content" = "La respiration consciente est l'un des outils les plus puissants pour réguler ton stress :\n\n• Active le système nerveux parasympathique (relaxation)\n• Réduit le rythme cardiaque\n• Diminue la tension artérielle";
"learning.card.breathing.section2.title" = "Bénéfices à long terme";
"learning.card.breathing.section2.content" = "• Améliore la gestion du stress\n• Augmente la capacité pulmonaire\n• Favorise la clarté mentale";
"learning.card.breathing.section3.title" = "Le saviez-vous ?";
"learning.card.breathing.section3.content" = "Une respiration profonde peut réduire ton niveau de cortisol en seulement 2-3 minutes !\n\nC'est pourquoi les exercices de respiration sont au cœur du programme CortiFree.";

// MARK: - Learning Card 9: Pouvoir de la nature
"learning.card.nature.title" = "Le pouvoir de la nature";
"learning.card.nature.description" = "Pourquoi la nature apaise";
"learning.card.nature.section1.title" = "Études scientifiques";
"learning.card.nature.section1.content" = "Le contact avec la nature a un effet prouvé sur le stress :\n\n• -15% de cortisol après 20 min en nature\n• Baisse de la pression artérielle\n• Amélioration de l'humeur";
"learning.card.nature.section2.title" = "Le \"bain de forêt\" (Shinrin-yoku)";
"learning.card.nature.section2.content" = "• Pratique japonaise millénaire\n• Marche lente en forêt\n• Connexion avec les 5 sens";
"learning.card.nature.section3.title" = "Bénéfices";
"learning.card.nature.section3.content" = "• Renforcement du système immunitaire\n• Réduction de l'anxiété\n• Meilleure créativité";
"learning.card.nature.section4.title" = "Même en ville";
"learning.card.nature.section4.content" = "Un parc, un jardin ou des plantes d'intérieur ont déjà des effets positifs !";

// MARK: - Learning Card 10: Cohérence cardiaque
"learning.card.cardiac_coherence.title" = "La cohérence cardiaque";
"learning.card.cardiac_coherence.description" = "Synchroniser cœur et cerveau";
"learning.card.cardiac_coherence.section1.title" = "Comment ça marche";
"learning.card.cardiac_coherence.section1.content" = "La cohérence cardiaque est une technique de respiration qui synchronise ton rythme cardiaque avec ton cerveau pour un effet anti-stress puissant.\n\n• Respiration : 6 cycles par minute (5 sec inspiration, 5 sec expiration)\n• Durée : 5 minutes\n• Fréquence : 3 fois par jour (matin, midi, soir)\n• C'est la méthode 365 : 3 fois/jour, 6 respirations/min, 5 minutes";
"learning.card.cardiac_coherence.section2.title" = "Bienfaits immédiats";
"learning.card.cardiac_coherence.section2.content" = "• Réduction du cortisol en 3-5 minutes\n• Baisse de la fréquence cardiaque\n• Diminution de la pression artérielle\n• Sentiment de calme et clarté mentale";
"learning.card.cardiac_coherence.section3.title" = "Effets à long terme (après 2 semaines)";
"learning.card.cardiac_coherence.section3.content" = "• -24% de cortisol en moyenne\n• Meilleure régulation émotionnelle\n• Amélioration de la qualité du sommeil\n• Renforcement du système immunitaire\n• +17% de DHEA (hormone anti-vieillissement)";
"learning.card.cardiac_coherence.section4.title" = "Utilisé par";
"learning.card.cardiac_coherence.section4.content" = "• Pilotes de chasse\n• Sportifs de haut niveau\n• Médecins et personnels soignants\n• Dirigeants d'entreprise";
"learning.card.cardiac_coherence.section5.title" = "Dans CortiFree";
"learning.card.cardiac_coherence.section5.content" = "L'exercice \"Cohérence cardiaque 5-5\" dans la section Respiration suit exactement cette méthode scientifique.";

// MARK: - Learning Card 11: Yoga
"learning.card.yoga.title" = "Le yoga et la flexibilité mentale";
"learning.card.yoga.description" = "Au-delà de la simple souplesse";
"learning.card.yoga.section1.title" = "Les types de yoga anti-stress";
"learning.card.yoga.section1.content" = "Le yoga est bien plus qu'une pratique physique. C'est un outil puissant de régulation du stress qui agit sur ton corps ET ton esprit.\n\n• Hatha Yoga : doux, parfait pour débuter\n• Yin Yoga : postures longues, très relaxant\n• Yoga Nidra : méditation guidée allongée\n• Vinyasa : dynamique mais méditatif";
"learning.card.yoga.section2.title" = "Effets sur le cortisol";
"learning.card.yoga.section2.content" = "• -27% après une session de 60 min\n• Effets cumulatifs avec pratique régulière\n• -41% de cortisol après 12 semaines (3x/semaine)";
"learning.card.yoga.section3.title" = "Bénéfices prouvés scientifiquement";
"learning.card.yoga.section3.content" = "Physiques :\n• Flexibilité et force musculaire\n• Meilleure posture\n• Réduction des douleurs chroniques\n• Amélioration de l'équilibre\n\nMentaux :\n• -65% des symptômes anxieux\n• Meilleure régulation émotionnelle\n• Augmentation de la matière grise\n• Amélioration de la concentration\n\nPhysiologiques :\n• Activation du système parasympathique (relaxation)\n• Meilleure variabilité de la fréquence cardiaque\n• Réduction de l'inflammation\n• Amélioration de la digestion";
"learning.card.yoga.section4.title" = "Ce qui se passe dans ton cerveau";
"learning.card.yoga.section4.content" = "• Augmentation GABA (neurotransmetteur calmant)\n• Réduction activité de l'amygdale (peur/stress)\n• Activation cortex préfrontal (contrôle émotionnel)";
"learning.card.yoga.section5.title" = "Pas besoin d'être souple";
"learning.card.yoga.section5.content" = "Le yoga n'est pas une compétition. Chaque corps est différent, et les bénéfices anti-stress arrivent dès les premières séances, même avec des adaptations !";

// MARK: - Learning Card 12: Sommeil et cortisol
"learning.card.sleep_cortisol.title" = "Le sommeil et le cortisol";
"learning.card.sleep_cortisol.description" = "L'importance d'un bon rythme circadien";
"learning.card.sleep_cortisol.section1.title" = "Le rythme naturel";
"learning.card.sleep_cortisol.section1.content" = "Ton sommeil et ton niveau de cortisol sont intimement liés :\n\n• Cortisol élevé le matin (pour te réveiller)\n• Cortisol bas le soir (pour dormir)";
"learning.card.sleep_cortisol.section2.title" = "Quand ça déraille";
"learning.card.sleep_cortisol.section2.content" = "• Sommeil perturbé → Cortisol élevé 24h/24\n• Cercle vicieux : stress → mauvais sommeil → plus de stress";
"learning.card.sleep_cortisol.section3.title" = "Solutions CortiFree";
"learning.card.sleep_cortisol.section3.content" = "• Se lever avant 7h (routine matinale)\n• Se coucher avant 23h (récupération)\n• Méditation du soir (préparation au sommeil)";
"learning.card.sleep_cortisol.section4.title" = "Le saviez-vous ?";
"learning.card.sleep_cortisol.section4.content" = "Une seule nuit de mauvais sommeil peut augmenter ton cortisol de 37% le lendemain !";

// MARK: - Learning Card 13: Hydratation
"learning.card.hydration.title" = "L'hydratation et le stress";
"learning.card.hydration.description" = "Pourquoi boire de l'eau réduit le stress";
"learning.card.hydration.section1.title" = "Effets de la déshydratation";
"learning.card.hydration.section1.content" = "L'eau joue un rôle crucial dans la régulation du stress :\n\n• Augmentation du cortisol (+25%)\n• Fatigue et irritabilité\n• Difficulté de concentration";
"learning.card.hydration.section2.title" = "Bienfaits d'une bonne hydratation";
"learning.card.hydration.section2.content" = "• Régulation de la température corporelle\n• Élimination des toxines\n• Meilleur fonctionnement cérébral";
"learning.card.hydration.section3.title" = "Recommandation";
"learning.card.hydration.section3.content" = "• Minimum 2L d'eau par jour\n• Plus si activité physique\n• Répartir tout au long de la journée";
"learning.card.hydration.section4.title" = "Astuce";
"learning.card.hydration.section4.content" = "Commence ta journée avec un grand verre d'eau pour réveiller ton métabolisme !";

// MARK: - Learning Card 14: Exercice physique
"learning.card.exercise.title" = "L'exercice physique anti-stress";
"learning.card.exercise.description" = "Comment le sport régule le cortisol";
"learning.card.exercise.section1.title" = "Effets sur le cortisol";
"learning.card.exercise.section1.content" = "L'activité physique est un régulateur naturel du stress :\n\n• Court terme : légère augmentation (normale)\n• Long terme : baisse significative du cortisol de base";
"learning.card.exercise.section2.title" = "Bénéfices supplémentaires";
"learning.card.exercise.section2.content" = "• Libération d'endorphines (hormones du bonheur)\n• Amélioration du sommeil\n• Meilleure estime de soi";
"learning.card.exercise.section3.title" = "Durée idéale";
"learning.card.exercise.section3.content" = "• 20-30 min par session\n• 3-5 fois par semaine\n• Intensité modérée";
"learning.card.exercise.section4.title" = "Attention";
"learning.card.exercise.section4.content" = "Trop d'exercice intense peut augmenter le cortisol. L'équilibre est la clé !";

// MARK: - Learning Card 15: Relations sociales
"learning.card.social.title" = "Les relations sociales positives";
"learning.card.social.description" = "L'importance du soutien social";
"learning.card.social.section1.title" = "Impact sur le cortisol";
"learning.card.social.section1.content" = "Les connexions sociales de qualité sont essentielles pour gérer le stress :\n\n• Interactions positives → -20% de cortisol\n• Libération d'ocytocine (\"hormone de l'amour\")\n• Sentiment de sécurité et d'appartenance";
"learning.card.social.section2.title" = "Types de connexions bénéfiques";
"learning.card.social.section2.content" = "• Conversations profondes avec amis\n• Moments de qualité en famille\n• Activités de groupe (sport, loisirs)";
"learning.card.social.section3.title" = "À éviter";
"learning.card.social.section3.content" = "• Isolement prolongé\n• Relations toxiques ou conflictuelles";
"learning.card.social.section4.title" = "Le saviez-vous ?";
"learning.card.social.section4.content" = "Un simple câlin de 20 secondes peut réduire significativement ton niveau de stress !";

// MARK: - Learning Card 16: Lumière naturelle
"learning.card.light.title" = "L'exposition à la lumière naturelle";
"learning.card.light.description" = "Régule ton horloge biologique";
"learning.card.light.section1.title" = "L'importance du matin";
"learning.card.light.section1.content" = "La lumière naturelle joue un rôle crucial dans la régulation de ton cortisol et de ton rythme circadien :\n\n• S'exposer à la lumière dans les 30-60 min après le réveil\n• 10-30 minutes minimum dehors (même par temps nuageux)\n• Active la production de cortisol matinal (normal et bénéfique)\n• Stoppe la production de mélatonine (hormone du sommeil)";
"learning.card.light.section2.title" = "Impact sur ton horloge biologique";
"learning.card.light.section2.content" = "• Régule le cycle cortisol/mélatonine\n• Améliore la qualité du sommeil nocturne\n• Augmente l'énergie et la vigilance diurne\n• Synchronise tous tes rythmes biologiques";
"learning.card.light.section3.title" = "Études scientifiques";
"learning.card.light.section3.content" = "• +25% d'énergie diurne avec exposition matinale\n• Endormissement 1h plus rapide le soir\n• -35% de symptômes dépressifs\n• Meilleure régulation de l'appétit";
"learning.card.light.section4.title" = "Le soir, éviter";
"learning.card.light.section4.content" = "• Les écrans 1-2h avant le coucher\n• Les lumières vives (préférer lumières chaudes/tamisées)\n• La lumière bleue qui bloque la mélatonine";
"learning.card.light.section5.title" = "Astuce CortiFree";
"learning.card.light.section5.content" = "Combine ta marche matinale avec l'exposition à la lumière naturelle pour un effet démultiplié sur ton énergie et ton stress !";

// MARK: - Learning Card 17: Pensées négatives
"learning.card.negative_thoughts.title" = "Les pensées automatiques négatives";
"learning.card.negative_thoughts.description" = "Identifier et remplacer les schémas toxiques";
"learning.card.negative_thoughts.section1.title" = "Les 7 types de pensées toxiques";
"learning.card.negative_thoughts.section1.content" = "Tes pensées influencent directement ton niveau de stress et de cortisol. Apprendre à identifier et modifier les pensées automatiques négatives est crucial.\n\n1️⃣ Catastrophisme : \"Si je rate cet examen, ma vie est finie\"\n→ Réalité : Un échec n'est pas une fin\n\n2️⃣ Pensée tout ou rien : \"Si ce n'est pas parfait, c'est un échec\"\n→ Réalité : La vie est faite de nuances\n\n3️⃣ Surgénéralisation : \"J'ai échoué une fois, j'échoue toujours\"\n→ Réalité : Une situation ≠ toutes les situations\n\n4️⃣ Filtre mental : Ignorer le positif, se focaliser sur le négatif\n→ Réalité : Chercher aussi ce qui va bien\n\n5️⃣ Lecture de pensées : \"Ils pensent que je suis incompétent\"\n→ Réalité : Tu ne peux pas lire dans les pensées\n\n6️⃣ Personnalisation : \"C'est forcément de ma faute\"\n→ Réalité : Tout ne dépend pas de toi\n\n7️⃣ Obligations tyranniques : \"Je DOIS être parfait\"\n→ Réalité : Personne n'est parfait";
"learning.card.negative_thoughts.section2.title" = "La technique des 3 colonnes";
"learning.card.negative_thoughts.section2.content" = "Colonne 1 : Situation\nColonne 2 : Pensée automatique\nColonne 3 : Pensée alternative réaliste";
"learning.card.negative_thoughts.section3.title" = "Impact mesurable";
"learning.card.negative_thoughts.section3.content" = "• -40% d'anxiété avec thérapie cognitive\n• -28% de cortisol en identifiant et modifiant ces pensées\n• Amélioration durable après 8-12 semaines";
"learning.card.negative_thoughts.section4.title" = "Astuce du journaling";
"learning.card.negative_thoughts.section4.content" = "Écrire tes pensées dans le journal CortiFree t'aide à les identifier, les questionner et les transformer !";

// MARK: - Learning Card 18: Gratitude
"learning.card.gratitude.title" = "La gratitude et le cerveau";
"learning.card.gratitude.description" = "L'effet scientifique de la reconnaissance";
"learning.card.gratitude.section1.title" = "Ce qui se passe dans ton cerveau";
"learning.card.gratitude.section1.content" = "Pratiquer la gratitude n'est pas juste du \"positive thinking\" : c'est une technique scientifiquement validée qui modifie ton cerveau et ton niveau de stress.\n\n• Activation du cortex préfrontal médian (bien-être)\n• Libération de dopamine et sérotonine (bonheur)\n• Réduction activité de l'amygdale (stress/peur)\n• -23% de cortisol en moyenne";
"learning.card.gratitude.section2.title" = "Études scientifiques majeures";
"learning.card.gratitude.section2.content" = "UC Berkeley (2015) :\n• Journaling de gratitude 3x/semaine\n• -27% de dépression après 12 semaines\n• Amélioration sommeil et relations sociales\n\nHarvard Medical School (2021) :\n• 5 minutes de gratitude par jour\n• +25% de bonheur ressenti\n• -18% d'anxiété";
"learning.card.gratitude.section3.title" = "Comment pratiquer efficacement";
"learning.card.gratitude.section3.content" = "Méthode des 3 gratitudes (5 min/jour) :\n1. Note 3 choses pour lesquelles tu es reconnaissant\n2. Sois spécifique (pas juste \"ma famille\")\n3. Ressens l'émotion en écrivant\n4. Varie les gratitudes chaque jour\n\nExemples :\nTrop vague : \"Je suis reconnaissant pour ma santé\"\nSpécifique : \"Je suis reconnaissant d'avoir pu faire ma marche matinale sans douleur et de sentir l'air frais sur mon visage\"";
"learning.card.gratitude.section4.title" = "Effets à long terme";
"learning.card.gratitude.section4.content" = "Après 4 semaines :\n• Changements mesurables dans le cerveau\n• Meilleure qualité de sommeil\n• Plus d'émotions positives\n\nAprès 12 semaines :\n• Nouvelle \"baseline\" de bonheur plus élevée\n• Résilience accrue face au stress\n• Meilleures relations interpersonnelles";
"learning.card.gratitude.section5.title" = "Intégré dans CortiFree";
"learning.card.gratitude.section5.content" = "Le journal te permet de noter tes gratitudes quotidiennes. Cette simple pratique de 2-3 minutes peut transformer ton rapport au stress !";
"learning.card.gratitude.section6.title" = "Important";
"learning.card.gratitude.section6.content" = "La gratitude ne nie pas les problèmes, elle entraîne ton cerveau à aussi voir le positif au lieu de se focaliser uniquement sur le négatif.";

