// MARK: - Learning Card 1: Le cortisol
"learning.card.cortisol.title" = "Le cortisol, c'est quoi ?";
"learning.card.cortisol.description" = "Comprendre l'hormone du stress";
"learning.card.cortisol.section1.title" = "Introduction";
"learning.card.cortisol.section1.content" = "Le cortisol est souvent appelé \"l'hormone du stress\". Il est produit par les glandes surrénales et joue un rôle essentiel dans la réponse de ton corps au stress.";
"learning.card.cortisol.section2.title" = "Rôles positifs du cortisol";
"learning.card.cortisol.section2.content" = "• Régule ton niveau d'énergie tout au long de la journée\n• Aide à gérer les situations difficiles et stressantes\n• Contrôle la pression artérielle et la glycémie\n• Réduit l'inflammation dans le corps\n• Participe au métabolisme des graisses, protéines et glucides\n• Régule le cycle veille-sommeil (rythme circadien)";
"learning.card.cortisol.section3.title" = "Problèmes d'un excès chronique";
"learning.card.cortisol.section3.content" = "• Anxiété chronique et troubles du sommeil\n• Prise de poids (surtout au niveau abdominal)\n• Système immunitaire affaibli\n• Hypertension artérielle\n• Difficulté de concentration et problèmes de mémoire\n• Vieillissement prématuré de la peau\n• Fatigue persistante malgré le repos\n• Troubles digestifs";
"learning.card.cortisol.section4.title" = "Les niveaux normaux";
"learning.card.cortisol.section4.content" = "Le cortisol suit un rythme naturel : élevé le matin (pic vers 8h) pour te réveiller, puis diminue progressivement dans la journée pour être au plus bas le soir (vers 23h) et te permettre de dormir.";
"learning.card.cortisol.section5.title" = "L'objectif de CortiFree";
"learning.card.cortisol.section5.content" = "T'aider à maintenir un niveau de cortisol sain et équilibré grâce à des habitudes scientifiquement prouvées qui régulent naturellement cette hormone.";

