"learning.card.66days.title" = "Les 66 jours pour former une habitude";
"learning.card.66days.description" = "Pourquoi le programme dure 66 jours";
"learning.card.66days.section1.title" = "L'étude de référence";
"learning.card.66days.section1.content" = "• University College London (2009)\n• 66 jours = temps moyen pour automatiser une habitude\n• Varie de 18 à 254 jours selon la complexité";
"learning.card.66days.section2.title" = "Les 3 phases";
"learning.card.66days.section2.content" = "1. Semaines 1-3 : Période d'effort conscient\n2. Semaines 4-7 : Début d'automatisation\n3. Semaines 8-10 : Habitude ancrée";
