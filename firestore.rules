rules_version = '2';

// Deployed with `firebase deploy --only firestore:rules` (see firebase.json).
// Every collection the iOS app touches is listed here; anything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwn() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // users/{uid} and all of its subcollections (baseline, habit_tracking,
    // daily_checkins, journalEntries, achievements, ai_insights, feedback, ...)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Read-only content catalogues (FirebaseManager)
    match /routines/{routineId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Top-level per-user documents keyed by a userId field
    match /dailyTodos/{todoId} {
      allow read, update, delete: if ownsExisting();
      allow create: if createsOwn();
    }

    // Bug reports: write-only from the app, never readable by clients
    match /bug_reports/{reportId} {
      allow create: if createsOwn();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
